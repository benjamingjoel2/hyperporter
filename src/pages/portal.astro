---
/** Portal — the platform layer, free on every tier. */
import Base from '../layouts/Base.astro';
import ProductPage from '../components/ProductPage.astro';
import Mockup from '../components/Mockup.astro';
import { byProduct } from '../lib/content/products';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const product = byProduct('portal');

/* Portal's own photograph, once it is in the repo: drop the file in as
   public/photos/portal.jpg and the hero picks it up at the next build.
   Until then it opens on the shared hero photo like every other page. */
const HERO = existsSync(join(process.cwd(), 'public/photos/portal.jpg')) ? '/photos/portal.jpg' : '/hero.jpg';
---

<Base
  title="Portal"
  description="CRM, quote builder, itinerary tool — a clean, modern interface replacing spreadsheets and email threads. Free, forever, on every tier."
  currentNav="product"
>
  <ProductPage product={product} photoHero>
    <img slot="hero-bg" class="p-photo-bg" src={HERO} alt="" />
    <Fragment slot="hero-aside">
      <Mockup screen="crm" />
    </Fragment>
  </ProductPage>
</Base>
