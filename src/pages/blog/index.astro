---
/**
 * Blog index. Ported from hyperporter-3.html's #view-blog: the newest post
 * gets the featured treatment (with decorative artwork), the rest fall into
 * the numbered list below. Ordering is by date descending rather than the
 * prototype's hardcoded array order, so a new post lands in the right place
 * on its date alone.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import EmailCapture from '../../components/EmailCapture.astro';
import { blogArtwork } from '../../lib/blogArtwork';
import { readingTime } from '../../lib/readingTime';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const [featured, ...rest] = posts;
---

<Base
  title="Blog"
  description="Field notes on travel operations — how trips are coordinated, quoted, and run between agencies and ground operators."
  currentNav="blog"
>
  <div class="sec wrap">
    <p class="eyebrow rv">Field notes</p>
    <div class="b-head rv">
      <h1 style="margin:0">Notes from the<br />coordination layer.</h1>
      <span class="b-count">{posts.length} posts</span>
    </div>

    {
      featured && (
        <div id="featured">
          <a class="feat rv" href={`/blog/${featured.id}`}>
            <div>
              <div class="b-meta">
                <em>{featured.data.cat}</em>
                <span>{fmt(featured.data.date)}</span>
                <span>{readingTime(featured.body ?? '')}</span>
              </div>
              <div class="feat-t">{featured.data.title}</div>
              <p>{featured.data.dek}</p>
            </div>
            <div class="feat-art" set:html={blogArtwork(0)} />
          </a>
        </div>
      )
    }

    <div class="plist">
      {
        rest.map((p, i) => (
          <a class="prow rv" href={`/blog/${p.id}`}>
            <div class="pn">{String(i + 2).padStart(2, '0')}</div>
            {/* Every card gets artwork, not just the featured one -- the
                generator was already there and only the top post used it. */}
            <span class="prow-art" set:html={blogArtwork(i + 2, 'compact')} />
            <div>
              <div class="b-meta">
                <em>{p.data.cat}</em>
                <span>{readingTime(p.body ?? '')}</span>
              </div>
              <h3>{p.data.title}</h3>
            </div>
            <div style="display:flex;gap:20px;align-items:flex-start;padding-top:6px">
              <p>{p.data.dek}</p>
              <span class="arrow">&rarr;</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>

  <div class="sec-tight wrap fcta">
    <h2 class="rv">See it running on a real trip.</h2>
    <EmailCapture uid="blog-cta" marginTop="30px" />
  </div>
</Base>
