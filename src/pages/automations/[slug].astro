---
/** One page per automation in the Automations menu. Content: lib/content/detail.ts. */
import Base from '../../layouts/Base.astro';
import DetailPage from '../../components/DetailPage.astro';
import { AUTOMATIONS } from '../../lib/content/detail';
import type { DetailPage as Page } from '../../lib/content/detail';

export function getStaticPaths() {
  return AUTOMATIONS.map((a) => ({ params: { slug: a.slug }, props: { page: a } }));
}

const { page } = Astro.props as { page: Page };
const description = page.lede.split(/(?<=\.)\s/)[0];
---

<Base title={page.name} description={description} currentNav="automations">
  <DetailPage page={page} kind="automation" />
</Base>
