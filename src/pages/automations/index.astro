---
/** Automations index — the six automations in the menu, each on a page of its own. */
import Base from '../../layouts/Base.astro';
import Mockup from '../../components/Mockup.astro';
import V2Hero from '../../components/V2Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { photoFor } from '../../lib/photos';
import { AUTOMATIONS } from '../../lib/content/detail';
import '../../styles/v2.css';
---

<Base
  title="Automations"
  description="Six automations that run the nine stages for you — Inquiry, Quotation, Follow-up, Confirmation, Collection and Payment — each with the step a person always takes."
  currentNav="automations"
>
  <div class="v2">
    <V2Hero
      eyebrow="Automations — Autopilot"
      title="Six automations, one engine."
      lede="Autopilot runs the nine stages from Inquiry to Completed. These are the six pieces of work it takes off your hands, and, on each, the moment it hands back to a person."
      photo={photoFor('autopilot')}
      secondary={{ label: 'The full overview of Autopilot', href: '/autopilot' }}
    >
      <Fragment slot="aside"><Mockup screen="pipeline" /></Fragment>
    </V2Hero>

    <section class="v-light v-band">
      <div class="v-wrap">
        <div class="v-grid3" style="margin-top:0">
          {
            AUTOMATIONS.map((a) => (
              <a class="v-pcard" href={`/automations/${a.slug}`}>
                <div class="v-cat">{a.tier}</div>
                <h3>{a.name}</h3>
                <p>{a.title}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <CtaBand
    lead="Autopilot runs the stages."
    rest="You take the decisions it hands back."
  />
</Base>
