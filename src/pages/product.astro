---
/**
 * Product overview — the four layers and how they stack.
 *
 * OS is the platform everyone gets; Autopilot and Intelligence layer on top
 * as an account grows; Horizon runs underneath for agencies, on every tier
 * including free.
 */
import Base from '../layouts/Base.astro';
import { PRODUCTS } from '../lib/content/products';
---

<Base
  title="Product"
  description="OS is the foundation everyone gets. Autopilot and Intelligence layer on top as you grow. Horizon runs underneath, on every tier."
  currentNav="product"
>
  <div class="sec wrap">
    <p class="eyebrow rv">Product</p>
    <h1 class="rv">Every capability, in one connected system.</h1>
    <p class="lede rv">
      OS is the foundation everyone gets. Autopilot and Intelligence layer on top as you grow.
      Horizon runs underneath both, always on.
    </p>
  </div>

  <div class="sec-tight wrap">
    <div class="ladder rv">
      {
        PRODUCTS.map((p) => (
          <a class="lrow" href={`/${p.slug}`}>
            <div class="lrow-n">
              {p.n} &mdash; {p.availability}
            </div>
            <div>
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
            </div>
            <span class="plink">Read more &rarr;</span>
          </a>
        ))
      }
    </div>
  </div>
</Base>
