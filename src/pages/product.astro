---
/**
 * Product overview — the four layers and how they stack.
 *
 * Portal is the platform everyone gets; Autopilot and Intelligence layer on top
 * as an account grows; Horizon runs underneath for agencies, on every tier
 * including free.
 */
import Base from '../layouts/Base.astro';
import { PRODUCTS } from '../lib/content/products';
import Mockup from '../components/Mockup.astro';
import V2Hero from '../components/V2Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import { photoFor } from '../lib/photos';
import '../styles/v2.css';
---

<Base
  title="Product"
  description="Portal is the foundation everyone gets. Autopilot and Intelligence layer on top as you grow. Horizon runs underneath, on every tier."
  currentNav="product"
  v2
>
  <V2Hero
    eyebrow="Product"
    title="Every capability, in one connected system."
    lede="Portal is the foundation everyone gets. Autopilot and Intelligence layer on top as you grow. Horizon runs underneath both, always on."
    photo={photoFor('product', 'portal-overview')}
  >
    <Fragment slot="aside"><Mockup screen="dashboard" /></Fragment>
  </V2Hero>

  <section class="v-light v-band">
    <div class="v-wrap">
      <div class="v-inds v-cols">
        {
          PRODUCTS.map((p) => (
            <div class="v-ind">
              <span class="v-eyebrow">{p.n} — {p.availability}</span>
              <h3>{p.label}</h3>
              <p>{p.summary}</p>
              <a class="v-pill-d" href={`/${p.slug}`}>Read more</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    lead="Four layers, one record."
    rest="Start free on Showcase and add what you need as the trips come in."
  />
</Base>
