---
/**
 * About page. Ported from hyperporter-3.html's #view-about.
 *
 * The team section used to render three cards reading "Name pending" and
 * "Placeholder bio — replace before this page goes live publicly". That is
 * a placeholder shown to the reader, which is worse than no section at
 * all, and the names are not mine to invent. TEAM below is the switch:
 * fill it in and the section returns exactly as it was, heading and all.
 * Until it has entries the page simply ends on the mission statement,
 * which reads as finished rather than unfinished.
 */
import Base from '../layouts/Base.astro';
import Mockup from '../components/Mockup.astro';

interface Member { role: string; name: string; bio: string }
/** Add the three real people here and the Team section renders again. */
const TEAM: Member[] = [];
---

<Base
  title="About"
  description="Hyperporter was built by people who’ve coordinated trips the old way — we think that work should run itself, with a human only where real judgment is needed."
  currentNav="about"
  noindex
>
  <div class="sec wrap page-hero">
    <div class="page-hero-copy">

      <p class="eyebrow rv">About</p>
      <h1 class="rv">We used to run this<br />by hand too.</h1>
      <p class="lede rv">
        Hyperporter was built by people who’ve coordinated trips the old way — chasing DMCs over email, relaying
        WhatsApp messages between travellers and drivers, rebuilding the same itinerary PDF for the fifth time.
      </p>
      <p class="mission rv">
        Every trip involves the same coordination work, repeated by hand, agency by agency. We think that work should
        run itself — with a human only where real judgment is needed.
      </p>
    </div>
    <Mockup screen="relay" />
  </div>
  <div class="sec-tight wrap">
    {TEAM.length > 0 && (
      <>
        <p class="eyebrow rv">Team</p>
        <div class="team rv">
          {TEAM.map((m) => (
            <div class="tcell">
              <div class="av" />
              <div class="role">{m.role}</div>
              <h3>{m.name}</h3>
              <p>{m.bio}</p>
            </div>
          ))}
        </div>
      </>
    )}
    <div style="margin-top:52px"><a class="btn rv" href="https://portal.hyperporter.com">Sign up →</a></div>
  </div>
</Base>
