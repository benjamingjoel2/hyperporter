---
/** Tools index — the twelve tools in the menu, each on a page of its own.
    WhatsApp left for /integrations when that menu was added (Sep 2026). */
import Base from '../../layouts/Base.astro';
import Mockup from '../../components/Mockup.astro';
import V2Hero from '../../components/V2Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { photoFor } from '../../lib/photos';
import { TOOLS } from '../../lib/content/detail';
import '../../styles/v2.css';
---

<Base
  title="Tools"
  description="Twelve tools across Portal, Autopilot and Intelligence — the CRM, the inquiry form, the Quotation Board, the Vault, Atlas and the rest — each on a page of its own."
  currentNav="product"
  v2
>
  <V2Hero
    eyebrow="Tools"
    title="Every tool, on its own page."
    lede="Twelve tools across Portal, Autopilot and Intelligence. Each page says what the tool does, how it works, and which tier it lands on."
    photo={photoFor('tools')}
  >
    <Fragment slot="aside"><Mockup screen="dashboard" /></Fragment>
  </V2Hero>

  <section class="v-light v-band">
    <div class="v-wrap">
      <div class="v-grid3" style="margin-top:0">
        {
          TOOLS.map((t) => (
            <a class="v-pcard" href={`/tools/${t.slug}`}>
              <div class="v-cat">{t.tier === t.layer ? t.layer : `${t.layer} · ${t.tier}`}</div>
              <h3>{t.name}</h3>
              <p>{t.title}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    before="Six tools used to never speak to each other."
    after="Now every one of them works off one record."
  />
</Base>
