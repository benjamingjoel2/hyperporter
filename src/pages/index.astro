---
/**
 * Homepage, rebuilt on the OH Architecture structure Benjamin picked:
 *
 *   1. full-bleed photographic hero, no headline competing with the image;
 *      the positioning line sits low in the frame
 *   2. a strip of labelled cells directly beneath it
 *   3. an intro block: one image, one column of copy
 *   4. section title with the count hard right, then an asymmetric grid of
 *      destination scenes, captioned in tracked capitals with an index
 *   5. a split section, image against copy
 *
 * The hero photo is /photos/hero.jpg with a fallback to /hero.jpg; the grid
 * uses the generated destination scenes, which exist for all 137 countries.
 *
 * The hero caption is the h1. It reads as body copy, but the page still
 * needs exactly one top-level heading and the reference has no display
 * headline in the hero — so the semantics and the design are both served
 * rather than dropping the h1 and breaking the outline.
 */
import Base from '../layouts/Base.astro';
import EmailCapture from '../components/EmailCapture.astro';
import { destArt } from '../lib/landmark/generator';
import { slugify } from '../lib/slug';

const GRID = [
  { name: 'Japan', region: 'Asia' },
  { name: 'Kenya', region: 'Africa' },
  { name: 'Peru', region: 'South America' },
  { name: 'Portugal', region: 'Europe' },
  { name: 'Nepal', region: 'Asia' },
  { name: 'Indonesia', region: 'Asia' },
];
---

<Base
  title="Home"
  description="Travel operations infrastructure — Autopilot software and the Horizon partner network, built for travel businesses."
  currentNav="home"
>
  <section class="oh-hero">
    <div class="oh-shot"></div>
    <div class="oh-cap">
      <h1>
        Hyperporter runs the coordination work between traveller, agency and operator — inquiry to
        booking to live trip support — with a human only where it counts.
      </h1>
      <span class="oh-scroll">Scroll &darr;</span>
    </div>
  </section>

  <div class="strip">
    <div><b>The software</b><span>Autopilot</span></div>
    <div><b>The network</b><span>Horizon</span></div>
    <div><b>Coverage</b><span>137 countries</span></div>
    <div><a href="/how">See the route &rarr;</a></div>
  </div>

  <section class="oh-intro wrap">
    <div class="oh-thumb"></div>
    <div class="oh-itext">
      <p class="eyebrow">(01) &mdash; What we do</p>
      <p>
        A trip touches a traveller, an agency and a ground operator, and most of the work is keeping
        those three in sync. Autopilot does that work. Horizon is the operator network underneath
        it — 137 countries of vetted relationships.
      </p>
      <p>
        Nothing about payment happens silently. A person marks money received or sent, every time.
      </p>
      <EmailCapture uid="hero" />
      <p class="note">No credit card required. We'll show you what it does with your own trips.</p>
    </div>
  </section>

  <section class="oh-works wrap">
    <div class="ohead">
      <h2>Where we<br />operate</h2>
      <span class="count">({String(GRID.length).padStart(2, '0')})</span>
    </div>
    <div class="oh-grid">
      {
        GRID.map((g, i) => (
          <a class:list={['oh-cell', i % 2 ? 'tall' : 'short']} href={`/destinations/${slugify(g.name)}`}>
            <span class="oh-block" set:html={destArt(g.name, `oh${i}`)} />
            <span class="oh-cap2">
              <span>{g.name}</span>
              <span class="oh-ix">{String(i + 1).padStart(2, '0')}</span>
            </span>
          </a>
        ))
      }
    </div>
    <div class="oh-mid"><a class="btn-o" href="/destinations">All 137 destinations &rarr;</a></div>
  </section>

  <section class="oh-split wrap">
    <p class="eyebrow">(02) &mdash; In progress</p>
    <div class="oh-srow">
      <span class="oh-block sq" set:html={destArt('Morocco', 'ohsq')} />
      <div class="oh-stext">
        <p>
          Every stage runs on a specific feature and takes a specific action. Availability is
          re-verified the moment a quote is accepted. Vouchers and pickup details are chased before
          departure, not after. The thread stays open until the trip actually closes.
        </p>
        <p class="oh-by">Hyperporter — Travel operations infrastructure</p>
      </div>
    </div>
    <div class="oh-mid"><a class="btn-o" href="/how">The Hyperporter difference &rarr;</a></div>
  </section>
</Base>
