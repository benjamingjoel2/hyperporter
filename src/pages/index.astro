        </ul>
      </div>
      <div class="wrap lg-rail-nav">
        <button type="button" class="lg-arrow" data-rail-prev aria-label="Previous">&#8249;</button>
        <button type="button" class="lg-arrow" data-rail-next aria-label="Next">&#8250;</button>
      </div>
    </section>

    {/* Opened by a card on either rail. With JS off the cards are plain
        links and this never shows, so the page still reaches every page. */}
    <dialog class="lg-modal" data-modal aria-labelledby="card-modal-title">
      <button type="button" class="lg-modal-x" data-modal-close aria-label="Close">&times;</button>
      <p class="lg-modal-kind" data-modal-kind></p>
      <h3 id="card-modal-title" data-modal-title></h3>
      <p class="lg-modal-copy" data-modal-copy></p>
      <a class="lg-read" data-modal-link href="/tools"><span aria-hidden="true">&#8627;</span> <span>Learn more</span></a>
    </dialog>

    <section class="lg-close">
      <div class="wrap">
        <h2>Run your next trip on<br />infrastructure, not inboxes.</h2>
        <a class="btn btn-lg" href="https://portal.hyperporter.com">Get started free <i aria-hidden="true">&rarr;</i></a>
      </div>
    </section>
  </div>

</Base>

<script>
  import '../lib/accordion';
</script>

<script>
  /* The catalogue rail and the panel a card opens.
   *
   * Everything is delegated from the document rather than bound to elements
   * at load: the bundled preview runs a page's script once and then swaps
   * route markup in and out, so anything captured up front points at a DOM
   * that is no longer on screen. Delegation survives that, and costs
   * nothing on the real page.
   */
  const railOf = (el: Element): HTMLElement | null =>
    el.closest('.lg-cat')?.querySelector<HTMLElement>('[data-rail]') ?? null;

  const stepOf = (rail: HTMLElement): number => {
    const card = rail.querySelector<HTMLElement>('.lg-card, .lg-conn-card');
    const track = rail.querySelector<HTMLElement>('[data-rail-track]');
    if (!card) return rail.clientWidth * 0.8;
    const gap = parseFloat(track ? getComputedStyle(track).columnGap || '18' : '18');
    return card.getBoundingClientRect().width + (Number.isNaN(gap) ? 18 : gap);
  };

  const syncArrows = (rail: HTMLElement): void => {
    const section = rail.closest('.lg-cat');
    const prev = section?.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = section?.querySelector<HTMLButtonElement>('[data-rail-next]');
    const max = rail.scrollWidth - rail.clientWidth;
    if (prev) prev.disabled = rail.scrollLeft < 4;
    if (next) next.disabled = rail.scrollLeft > max - 4;
  };

  /* Capture, not bubble: the bundled preview installs its own click handler
     that turns every in-site link into a route change. Ours has to see the
     card first and stop the event there, or the preview navigates away
     instead of opening the panel. */
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    if (!target) return;

    const arrow = target.closest<HTMLButtonElement>('[data-rail-prev],[data-rail-next]');
    if (arrow) {
      const rail = railOf(arrow);
      if (rail) {
        const back = arrow.hasAttribute('data-rail-prev');
        rail.scrollBy({ left: back ? -stepOf(rail) : stepOf(rail), behavior: 'smooth' });
      }
      return;
    }

    const card = target.closest<HTMLAnchorElement>('[data-card]');
    if (card) {
      const modal = document.querySelector<HTMLDialogElement>('[data-modal]');
      if (!modal) return; /* No dialog: the card stays a plain link. */
      event.preventDefault();
      event.stopPropagation();
      const set = (sel: string, text: string): void => {
        const el = modal.querySelector<HTMLElement>(sel);
        if (el) el.textContent = text;
      };
      set('[data-modal-kind]', card.dataset.kind ?? '');
      set('[data-modal-title]', card.dataset.name ?? '');
      set('[data-modal-copy]', card.dataset.copy ?? '');
      const link = modal.querySelector<HTMLAnchorElement>('[data-modal-link]');
      if (link) link.href = card.getAttribute('href') ?? '/tools';
      modal.showModal();
      return;
    }

    const closer = target.closest('[data-modal-close]');
    if (closer) {
      closer.closest('dialog')?.close();
      return;
    }

    /* A click that lands on the dialog element itself is on its backdrop. */
    if (target.matches('dialog[data-modal]')) (target as HTMLDialogElement).close();
  }, true);

  /* Scroll does not bubble, so listen in the capture phase. */
  document.addEventListener(
    'scroll',
    (event) => {
      const rail = event.target as HTMLElement | null;
      if (rail?.matches?.('[data-rail]')) syncArrows(rail);
    },
    { capture: true, passive: true },
  );

  const syncAll = (): void =>
    document.querySelectorAll<HTMLElement>('[data-rail]').forEach(syncArrows);
  window.addEventListener('resize', syncAll);
  syncAll();
  /* The rail may arrive after this runs — in the preview, or with a late
     render — so settle the arrows once more on the next frames. */
  requestAnimationFrame(syncAll);
  window.setTimeout(syncAll, 400);
</script>

<script>
  /* Scroll cue: only means anything at rest, so it leaves once the page moves. */
  const cue = document.getElementById('lg-cue');
  if (cue) {
    cue.addEventListener('click', () =>
      document.getElementById('product')?.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      })
    );
    window.addEventListener(
      'scroll',
      () => cue.classList.toggle('lg-gone', window.scrollY > 40),
      { passive: true }
    );
  }

  /**
   * Stat numerals count up from zero each time the rows come into view — not
   * once per page load, so scrolling back to the section replays it. A run is
   * re-armed only after the row has left the viewport again, otherwise a
   * scroll that jiggles the threshold restarts it mid-count.
   *
   * The final value lives in the markup, so with JS off, or under
   * prefers-reduced-motion, the real number is what shows.
   */
  const stats = Array.from(document.querySelectorAll<HTMLElement>('.lg-strow b'));
  if (stats.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const finals = new WeakMap<HTMLElement, string>();
    const armed = new WeakMap<HTMLElement, boolean>();
    stats.forEach((el) => {
      finals.set(el, el.textContent ?? '');
      armed.set(el, true);
    });

    const run = (el: HTMLElement): void => {
      const final = finals.get(el) ?? '';
      const m = final.match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/);
      if (!m) return;
      const [, pre, num, post] = m;
      const target = parseFloat(num);
      const dp = (num.split('.')[1] ?? '').length;
      let t0: number | null = null;
      const step = (ts: number): void => {
        if (t0 === null) t0 = ts;
        const p = Math.min((ts - t0) / 900, 1);
        el.textContent = pre + (target * (1 - Math.pow(1 - p, 3))).toFixed(dp) + post;
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = final;
      };
      el.textContent = pre + (0).toFixed(dp) + post;
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          const el = e.target as HTMLElement;
          if (e.isIntersecting) {
            if (!armed.get(el)) return;
            armed.set(el, false);
            run(el);
          } else {
            armed.set(el, true);
          }
        }),
      { threshold: 0.5 }
    );
    stats.forEach((el) => io.observe(el));
  }
</script>
