---
/**
 * Homepage, rebuilt on the harvey.ai structure: a two-column hero, a
 * framed product panel, a facts band where a client-logo wall would sit,
 * two dark product cards, a stage accordion, and a dark stats block.
 *
 * Deliberately absent, because we cannot honestly fill them:
 *  - the client-logo wall. We have no logos to show and inventing them
 *    would be fabrication, so the space carries plain facts instead.
 *  - the customer testimonial. No real quote exists yet. A slot is left
 *    in the layout rather than a written-for-us quote.
 *  - the customer video carousel, for the same reason.
 *
 * "137" is used rather than the prototype's "130+": it is the number the
 * dataset actually holds. The public figure is still unresolved (a founder
 * brief said "100+") — see CLAUDE.md.
 */
import Base from '../layouts/Base.astro';
import { destArt } from '../lib/landmark/generator';
import { STAGES } from '../lib/stages';
import { getCollection } from 'astro:content';
import { REGIONS } from '../content.config';

const destinations = await getCollection('destinations');
const COUNTRIES = destinations.length;
const COVERED = REGIONS.filter((r) => destinations.some((d) => d.data.region === r));

const frameArt = destArt('Peru', 'frame-bg');
const autopilotArt = destArt('Japan', 'card-ap', 'dark');
const horizonArt = destArt('Kenya', 'card-hz', 'dark');
---

<Base
  title="Home"
  description="Travel operations infrastructure — Autopilot software and the Horizon partner network, built for travel businesses."
  currentNav="home"
>
  <!-- ============ HERO ============ -->
  <section class="hx hx-hero">
    <div class="hx-hero-grid">
      <h1 class="hx-h1">Run trips<br />on autopilot.</h1>
      <div class="hx-hero-aside">
        <p>
          Autopilot coordinates the work between you, your traveller and the operator on
          the ground. Horizon is the network of operators it reaches.
        </p>
        <a class="btn" href="/signup">Request a demo</a>
      </div>
    </div>
  </section>

  <!-- ============ PRODUCT PANEL ============ -->
  <section class="hx">
    <div class="hx-frame">
      <div class="hx-frame-art" aria-hidden="true" set:html={frameArt} />
      <div class="hx-panel">
        <div class="hx-panel-top">
          <span>Thread KE-2291</span>
          <span>Nairobi &middot; 9 nights</span>
        </div>
        <ol class="hx-steps">
          {
            STAGES.map((s, i) => (
              <li class:list={['hx-step', { done: i < 2, now: i === 2 }]}>
                <i />
                <span>{s.name}</span>
              </li>
            ))
          }
        </ol>
        <div class="hx-panel-foot">
          <span>Quotation &middot; requested from four operators</span>
          <span class="hx-amb">Needs a person at two of nine steps</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FACTS ============ -->
  <section class="hx hx-sec">
    <div class="hx-mid">
      <h2>Operators in {COUNTRIES} countries</h2>
      <p>Vetted ground partners across every region Horizon reaches.</p>
    </div>
    <div class="hx-facts">
      {COVERED.map((r) => <span>{r}</span>)}
    </div>
  </section>

  <!-- ============ TWO PRODUCTS ============ -->
  <section class="hx hx-sec">
    <div class="hx-mid">
      <h2>Two products. One operation.</h2>
      <p>
        The software and the network are sold separately. Most agencies take one, some
        take both.
      </p>
    </div>
    <div class="hx-duo">
      <article class="hx-card">
        <div class="hx-card-art" aria-hidden="true" set:html={autopilotArt} />
        <div class="hx-kind">Our software</div>
        <h3>Autopilot</h3>
        <p>
          Nine steps from first message to trip complete, handled in one thread. You keep
          the client relationship; it keeps the chasing.
        </p>
        <a class="hx-ghost" href="/autopilot">Explore Autopilot &rarr;</a>
      </article>

      <article class="hx-card">
        <div class="hx-card-art" aria-hidden="true" set:html={horizonArt} />
        <div class="hx-kind">Our supplier network</div>
        <h3>Horizon</h3>
        <p>
          Local operators we have vetted ourselves, in {COUNTRIES} countries. Use them through
          Autopilot, or bring the trip to us and we will run it.
        </p>
        <a class="hx-ghost" href="/horizon">Explore Horizon &rarr;</a>
      </article>
    </div>
  </section>

  <!-- ============ STAGES ============ -->
  <section class="hx hx-sec">
    <div class="hx-split">
      <div>
        <h2 style="margin-bottom:34px">Every step of a trip, in one place</h2>
        <div class="hx-list" id="stage-list">
          {
            STAGES.map((s, i) => (
              <div class:list={['hx-item', { on: i === 0 }]} data-stage={i}>
                <button type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span class="hx-n">{s.n}</span>
                  <span>{s.name}</span>
                </button>
                <div class="hx-body">
                  <div class="hx-body-in">
                    <p>{s.body}</p>
                    {s.cls === 'Human touchpoint' && <span class="hx-amb">A person handles this</span>}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <p style="margin-top:36px"><a class="hx-more" href="/how">See how it works &rarr;</a></p>
      </div>

      <div class="hx-shot">
        <div class="hx-shot-h">
          <span id="shot-n">01</span>
          <span id="shot-name">Inquiry</span>
        </div>
        <ul class="hx-dots" aria-hidden="true">
          {
            STAGES.map((s, i) => (
              <li
                class:list={['hx-dot', { amb: s.cls === 'Human touchpoint' }]}
                data-dot={i}
                data-on={i === 0 ? 'true' : 'false'}
              />
            ))
          }
        </ul>
        <p id="shot-note">{STAGES[0].note}</p>
        <div class="hx-shot-f">
          <span id="shot-cls">Automatic</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="hx-dark">
    <div class="hx hx-sec">
      <div class="hx-mid">
        <h2>What the network covers</h2>
      </div>
      <dl style="margin:0">
        <div class="hx-stat"><dt>Countries with vetted operators</dt><dd>{COUNTRIES}</dd></div>
        <div class="hx-stat"><dt>Regions covered</dt><dd>{COVERED.length}</dd></div>
        <div class="hx-stat"><dt>Steps from inquiry to trip complete</dt><dd>{STAGES.length}</dd></div>
        <div class="hx-stat"><dt>Of those, handled by a person</dt><dd>
          {STAGES.filter((s) => s.cls === 'Human touchpoint').length}
        </dd></div>
      </dl>
    </div>
  </section>
</Base>

<script>
  // Stage accordion. One item open at a time; the right-hand panel
  // mirrors the open item. Everything renders server-side with the first
  // stage open, so this only ever enhances what is already there.
  const items = Array.from(document.querySelectorAll<HTMLElement>('.hx-item'));
  const dots = Array.from(document.querySelectorAll<HTMLElement>('.hx-dot'));
  const elN = document.getElementById('shot-n');
  const elName = document.getElementById('shot-name');
  const elNote = document.getElementById('shot-note');
  const elCls = document.getElementById('shot-cls');

  const DATA = items.map((el) => ({
    n: el.querySelector('.hx-n')?.textContent ?? '',
    name: el.querySelector('button span:last-child')?.textContent ?? '',
  }));

  function open(index: number) {
    items.forEach((el, i) => {
      const on = i === index;
      el.classList.toggle('on', on);
      el.querySelector('button')?.setAttribute('aria-expanded', on ? 'true' : 'false');
    });
    dots.forEach((d, i) => d.setAttribute('data-on', i === index ? 'true' : 'false'));
    const src = items[index];
    if (elN) elN.textContent = DATA[index].n;
    if (elName) elName.textContent = DATA[index].name;
    if (elNote) elNote.textContent = src.querySelector('.hx-body-in p')?.textContent ?? '';
    if (elCls) {
      const human = !!src.querySelector('.hx-amb');
      elCls.textContent = human ? 'Human touchpoint' : 'Automatic';
      elCls.classList.toggle('amb', human);
    }
  }

  items.forEach((el, i) => {
    el.querySelector('button')?.addEventListener('click', () => open(i));
  });
</script>
