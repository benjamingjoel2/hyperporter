        </div>
      </div>
    </section>

    {/* Every tool and every automation, one rail each. */}
    {
      RAILS.map((r, i) => (
        <section
          class:list={['lg-cat', `lg-cat-${r.variant}`, i === RAILS.length - 1 && 'lg-cat-last']}
          id={r.id === 'tools' ? 'everything' : 'every-automation'}
        >
          <div class="wrap lg-cat-head">
            <div>
              <h2>{r.title}</h2>
              <p>{r.line}</p>
            </div>
            <div class="lg-cat-links">
              <a class="lg-read" href={r.href}><span aria-hidden="true">&#8627;</span> <span>{r.cta}</span></a>
            </div>
          </div>
          <div class="lg-rail" data-rail>
            <ul class="lg-rail-track" data-rail-track>
              {r.cards.map((c) => (
                <li class="lg-card">
                  <a href={c.href} data-card data-kind={c.kind} data-name={c.label} data-copy={c.overview}>
                    {r.variant === 'photo' ? (
                      /* The automation's own page photograph, graded down so
                         white type reads over it, with the name as the label
                         and the card's claim set large above it. */
                      <>
                        <span class="lg-card-bg" style={`background-image:url(${c.photo})`} />
                        <span class="lg-card-kind">{c.label}</span>
                        <b>{c.headline}</b>
                      </>
                    ) : (
                      /* The tool's own line icon, in the bottom corner
                         (founder's ask, Sep 2026) — the screen that used to
                         fill the foot was clipped by the card and is better
                         seen full size on the tool's own page. */
                      <>
                        <span class="lg-card-kind">{c.kind}</span>
                        <b>{c.label}</b>
                        <span class="lg-card-desc">{c.desc}</span>
                        <span class="lg-card-ico" set:html={navIcon(c.label)} />
                      </>
                    )}
                    <span class="lg-card-more" aria-hidden="true">+</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="wrap lg-rail-nav">
            <button type="button" class="lg-arrow" data-rail-prev aria-label="Previous">&#8249;</button>
            <button type="button" class="lg-arrow" data-rail-next aria-label="Next">&#8250;</button>
          </div>
        </section>
      ))
    }

    {/* Integrations, in the reference's carousel shape: the screen large,
        the caption under it, the arrows bottom right. It carries .lg-cat so
        the rail's own arrow wiring picks it up. */}
    <section class="lg-cat lg-cat-conn" id="integrations">
      <div class="wrap lg-conn-head">
        <h2>Integrations.<br />The channels they already use.</h2>
      </div>
      <div class="lg-rail" data-rail>
        <ul class="lg-rail-track" data-rail-track>
          {
            CONNECT.map((c) => (
              <li class="lg-conn-card">
                <span class="lg-conn-shot">
                  <img src={c.photo} alt={c.alt} width="1200" height="800" loading="lazy" decoding="async" />
                </span>
                <p class="lg-conn-cap">
                  <b>{c.lead}</b> {c.rest}
                </p>
                <a class="lg-read" href={c.href}>
                  <span aria-hidden="true">&#8627;</span> <span>{c.cta}</span>
                </a>
              </li>
            ))
