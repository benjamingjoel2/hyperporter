---
/**
 * Homepage, on the harvey.ai structure.
 *
 * The reference anchors every section with something to look at — a large
 * product screenshot, a client-logo wall, a photographed customer, video.
 * That is most of why its pages read as substantial. The first pass here
 * built only the text-led sections and came out looking empty.
 *
 * What that gap is filled with now:
 *  - AppShot, the Autopilot interface drawn in markup, standing where the
 *    reference puts a screenshot: the hero frame, the software card, and
 *    the stage detail panel. It re-points at a different pipeline stage
 *    per placement, which a captured image could not do.
 *  - the destination artwork, at full bleed, for the network sections.
 *
 * Still deliberately absent, because they cannot be filled honestly:
 *  - the client-logo wall. No logos exist to show; inventing them would be
 *    fabrication. Plain facts carry that space instead.
 *  - the customer testimonial and video carousel. No real quote or footage
 *    exists, and writing one for ourselves would be worse than the gap.
 *
 * "137" is the number the dataset holds, used in place of the prototype's
 * "130+". The public figure is still unresolved — see CLAUDE.md.
 */
import Base from '../layouts/Base.astro';
import AppShot from '../components/AppShot.astro';
import { destArt } from '../lib/landmark/generator';
import { STAGES } from '../lib/stages';
import { getCollection } from 'astro:content';
import { REGIONS } from '../content.config';

const destinations = await getCollection('destinations');
const COUNTRIES = destinations.length;
const COVERED = REGIONS.filter((r) => destinations.some((d) => d.data.region === r));
const AUTO = STAGES.filter((s) => s.cls === 'Automatic').length;
const HUMAN = STAGES.length - AUTO;

const frameArt = destArt('Peru', 'frame-bg');
const horizonArt = destArt('Kenya', 'card-hz', 'dark');
const bandArt = destArt('Morocco', 'band-bg', 'dark');
---

<Base
  title="Home"
  description="Travel operations infrastructure — Autopilot software and the Horizon partner network, built for travel businesses."
  currentNav="home"
>
  <!-- ============ HERO ============ -->
  <section class="hx hx-hero">
    <div class="hx-hero-grid">
      <h1 class="hx-h1">Run trips<br />on autopilot.</h1>
      <div class="hx-hero-aside">
        <p>
          Autopilot coordinates the work between you, your traveller and the operator on
          the ground. Horizon is the network of operators it reaches.
        </p>
        <a class="btn" href="/signup">Request a demo</a>
      </div>
    </div>
  </section>

  <!-- ============ PRODUCT ============ -->
  <section class="hx">
    <div class="hx-frame">
      <div class="hx-frame-art" aria-hidden="true" set:html={frameArt} />
      <AppShot stage={3} class="hx-frame-app" />
    </div>
    <p class="hx-cap">Autopilot, mid-quotation. Illustrative trip and operators.</p>
  </section>

  <!-- ============ FACTS ============ -->
  <section class="hx hx-sec">
    <div class="hx-mid">
      <h2>Operators in {COUNTRIES} countries</h2>
      <p>Vetted ground partners across every region Horizon reaches.</p>
    </div>
    <div class="hx-facts">
      {COVERED.map((r) => <span>{r}</span>)}
    </div>
  </section>

  <!-- ============ TWO PRODUCTS ============ -->
  <section class="hx hx-sec">
    <div class="hx-mid">
      <h2>Two products. One operation.</h2>
      <p>
        The software and the network are sold separately. Most agencies take one, some
        take both.
      </p>
    </div>
    <div class="hx-duo">
      <article class="hx-card">
        <div class="hx-card-copy">
          <div class="hx-kind">Our software</div>
          <h3>Autopilot</h3>
          <p>
            Nine steps from first message to trip complete, in one thread. You keep the
            client relationship; it keeps the chasing.
          </p>
          <a class="hx-ghost" href="/autopilot">Explore Autopilot &rarr;</a>
        </div>
        <div class="hx-card-shot"><AppShot stage={5} compact class="in-card" /></div>
      </article>

      <article class="hx-card">
        <div class="hx-card-art" aria-hidden="true" set:html={horizonArt} />
        <div class="hx-card-copy">
          <div class="hx-kind">Our supplier network</div>
          <h3>Horizon</h3>
          <p>
            Local operators we have vetted ourselves, in {COUNTRIES} countries. Reach them
            through Autopilot, or bring us the trip and we will run it.
          </p>
          <a class="hx-ghost" href="/horizon">Explore Horizon &rarr;</a>
        </div>
      </article>
    </div>
  </section>

  <!-- ============ STATEMENT BAND ============ -->
  <section class="hx-band">
    <div class="hx-band-art" aria-hidden="true" set:html={bandArt} />
    <div class="hx hx-band-in">
      <span class="hx-band-tag">The whole point</span>
      <h2>One thread, from the first message to the last invoice.</h2>
      <p>
        No forwarded email chains, no spreadsheet of who owes what. {AUTO} of the {
          STAGES.length
        } steps run on their own. The other {HUMAN} are the ones a person should be making anyway.
      </p>
      <a class="btn" href="/how">See how it works</a>
    </div>
  </section>

  <!-- ============ STAGES ============ -->
  <section class="hx hx-sec">
    <div class="hx-split">
      <div>
        <h2 class="hx-split-h">Every step of a trip, in one place</h2>
        <div class="hx-list" id="stage-list">
          {
            STAGES.map((s, i) => (
              <div class:list={['hx-item', { on: i === 0 }]} data-stage={i + 1}>
                <button type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span class="hx-n">{s.n}</span>
                  <span>{s.name}</span>
                </button>
                <div class="hx-body">
                  <div class="hx-body-in">
                    <p>{s.body}</p>
                    {s.cls === 'Human touchpoint' && (
                      <span class="hx-amb">A person handles this</span>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <p class="hx-split-more"><a class="hx-more" href="/how">See how it works &rarr;</a></p>
      </div>

      <div class="hx-side">
        <AppShot stage={1} class="hx-side-app" />
        <p class="hx-cap">The same thread, at the selected step.</p>
      </div>
    </div>
  </section>

  <!-- ============ STATS ============ -->
  <section class="hx-dark">
    <div class="hx hx-sec">
      <div class="hx-mid">
        <h2>What the network covers</h2>
      </div>
      <dl style="margin:0">
        <div class="hx-stat"><dt>Countries with vetted operators</dt><dd>{COUNTRIES}</dd></div>
        <div class="hx-stat"><dt>Regions covered</dt><dd>{COVERED.length}</dd></div>
        <div class="hx-stat"><dt>Steps from inquiry to trip complete</dt><dd>{STAGES.length}</dd></div>
        <div class="hx-stat"><dt>Of those, handled by a person</dt><dd>{HUMAN}</dd></div>
      </dl>
    </div>
  </section>
</Base>

<script>
  // Stage accordion. One item open at a time, and the interface beside it
  // re-points at that step. Everything renders server-side with the first
  // stage open, so this only enhances markup that already works.
  const items = Array.from(document.querySelectorAll<HTMLElement>('.hx-item'));
  const app = document.querySelector<HTMLElement>('.hx-side-app');
  const pill = app?.querySelector<HTMLElement>('.app-stage');
  const rail = Array.from(app?.querySelectorAll<HTMLElement>('.app-rail i') ?? []);

  function open(index: number) {
    items.forEach((el, i) => {
      const on = i === index;
      el.classList.toggle('on', on);
      el.querySelector('button')?.setAttribute('aria-expanded', on ? 'true' : 'false');
    });

    const label = items[index].querySelector('button span:last-child')?.textContent ?? '';
    if (pill) pill.textContent = label;
    rail.forEach((seg, i) => {
      seg.classList.toggle('done', i < index);
      seg.classList.toggle('now', i === index);
    });
  }

  items.forEach((el, i) => {
    el.querySelector('button')?.addEventListener('click', () => open(i));
  });
</script>
