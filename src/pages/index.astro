---
/**
 * Homepage, on the legora.com design direction.
 *
 * Structure and every spacing value came from measuring the reference at
 * 1440px rather than eyeballing it; the numbers are noted in
 * src/styles/legora-home.css at the rule that uses them. The shape, in
 * order: a 100vh photographic hero with the headline at 87% down, a
 * statement block pinned to the grey band beneath it, a full-viewport band
 * of the nine stages, the four layers as 4:5 portrait cards, one carousel
 * with an active slide, the destination gallery, an interstitial, the stat
 * rows, the vision block, the dark security band and the FAQ.
 *
 * Content comes from the content modules, as everywhere else on this site —
 * PRODUCTS, MOVES, SECURITY, HOME_FAQ and the destinations collection — so
 * the page stays thin and cannot drift from /product, /autopilot or
 * /security.
 *
 * Three of the reference's sections have no honest equivalent here and are
 * handled rather than faked: its "Trusted by" logo wall is omitted, since
 * there are no named customers at pilot stage; the founder portrait is a
 * visible placeholder, as on /about; and the security cards carry real
 * status instead of certification seals — SOC 2 and GDPR are targeted
 * post-pilot, not held. Do not turn that last one into a seal.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Carousel from '../components/legora/Carousel.astro';
import { destArt } from '../lib/landmark/generator';
import { PRODUCTS, MOVES } from '../lib/content/products';
import { HOME_FAQ, SECURITY } from '../lib/content/pricing';
import { CARD_ART, CARD_ALT } from '../lib/legoraArt';
import '../styles/legora-home.css';

/** Twelve chosen to spread the archetypes -- no two share a builder, so the
    gallery shows what the generator actually does rather than twelve
    variations of a cityscape. */
const PICKS = [
  'Japan', 'Peru', 'Kenya', 'Iceland', 'Jordan', 'Vietnam',
  'Namibia', 'Portugal', 'Nepal', 'Brazil', 'Oman', 'Bolivia',
];
const all = await getCollection('destinations');
const byName = new Map(all.map((d) => [d.data.title, d.data]));
const places = PICKS.map((name) => {
  const d = byName.get(name);
  if (!d) throw new Error(`legora preview: no destination entry for ${name}`);
  return { name, region: d.region };
});

const SEGMENTS = [
  { name: 'Travel agencies', kind: 'Reseller', body: 'Multi-agent teams on one shared CRM and one brand — every agent, every trip, one stage engine.' },
  { name: 'Travel agents', kind: 'Reseller', body: 'Run your whole book of clients from a single thread, without a second system to keep in sync.' },
  { name: 'Independent advisors', kind: 'Reseller', body: 'Look like a full agency without the overhead — branded proposals, magic links, a real CRM.' },
  { name: 'Creators', kind: 'Reseller', body: 'Turn an audience into bookings: a public inquiry form, and a pipeline that handles the rest.' },
  { name: 'DMCs', kind: 'Supplier', body: 'Reply the way you already do, and get discovered by agencies as the network grows.' },
  { name: 'Tour operators', kind: 'Supplier', body: 'Build and quote packages from your own rates, and keep your full quoted rate on every booking.' },
];

/** The four practices are real and in place today; the fifth card states
    what is NOT held. Do not turn that one into a seal. */
const CERTS = [
  ...SECURITY.practices.map((p) => ({ ...p, status: 'IN\nPLACE', pending: false })),
  {
    title: 'SOC 2 & GDPR',
    body: 'Not formally certified, not yet. Both are targeted post-pilot, once real usage volume justifies the audit. The practices above are already how the platform is built, ahead of the paperwork.',
    status: 'TARGETED\nPOST-PILOT',
    pending: true,
  },
];

const STATS = [
  ['130+', 'Countries with vetted DMCs and suppliers on Horizon.'],
  ['9', 'Stages from Inquiry to Completed, all on one thread.'],
  ['€0', 'To start on Showcase. Free forever for suppliers; free up to 20 trips a month for resellers.'],
  ['10%', 'Horizon’s fee. The supplier always receives their full quoted rate.'],
];

---

<Base
  title="Home"
  description="Travel operations infrastructure — one connected system for agencies, DMCs and tour operators."
  currentNav="home"
>
  <main>
    <section class="lg-hero" data-chrome="dark">
      <img
        class="lg-hero-img"
        src="/hero.jpg"
        alt="Aerial view of a mountain range at dawn, cloud filling the valleys below the ridgelines."
      />
    <svg class="routes" viewBox="0 0 1400 760" preserveAspectRatio="xMidYMid slice">
      <g class="grat">
        <path d="M-50 200 Q700 120 1450 200"></path><path d="M-50 330 Q700 240 1450 330"></path>
        <path d="M-50 460 Q700 380 1450 460"></path><path d="M-50 590 Q700 520 1450 590"></path>
        <path d="M180 -20 Q120 380 180 780"></path><path d="M480 -20 Q440 380 480 780"></path>
        <path d="M780 -20 Q760 380 780 780"></path><path d="M1080 -20 Q1090 380 1080 780"></path>
      </g>
      <g>
        <path class="arc" d="M170 520 Q520 190 880 300"></path>
        <path class="arc" d="M880 300 Q1080 200 1290 420"></path>
        <path class="arc" d="M330 240 Q640 430 1010 210"></path>
        <path class="arc" d="M170 520 Q560 640 1010 560"></path>
        <path class="arc-lit" d="M170 520 Q520 190 880 300" style="animation-delay:0s"></path>
        <path class="arc-lit" d="M880 300 Q1080 200 1290 420" style="animation-delay:2.4s"></path>
        <path class="arc-lit" d="M330 240 Q640 430 1010 210" style="animation-delay:4.6s"></path>
        <path class="arc-lit" d="M170 520 Q560 640 1010 560" style="animation-delay:6.5s"></path>
      </g>
      <g>
        <circle class="wp-ring" cx="170" cy="520" r="9"></circle><circle class="wp" cx="170" cy="520" r="3"></circle>
        <circle class="wp-ring" cx="880" cy="300" r="9"></circle><circle class="wp" cx="880" cy="300" r="3"></circle>
        <circle class="wp-ring" cx="1290" cy="420" r="9"></circle><circle class="wp" cx="1290" cy="420" r="3"
        ></circle>
        <circle class="wp-ring" cx="330" cy="240" r="9"></circle><circle class="wp" cx="330" cy="240" r="3"></circle>
        <circle class="wp-ring" cx="1010" cy="210" r="9"></circle><circle class="wp" cx="1010" cy="210" r="3"
        ></circle>
        <circle class="wp-ring" cx="1010" cy="560" r="9"></circle><circle class="wp" cx="1010" cy="560" r="3"
        ></circle>
      </g>
    </svg>
      <div class="lg-hero-veil"></div>
      <div class="lg-hero-in">
        <h1>Inquiry to booking,<br />without the email threads.</h1>
        <div class="lg-hero-sub">
          <span>One connected system for agencies, DMCs and tour operators.</span>
          <a class="btn btn-lg" href="/signup">Get started free <i aria-hidden="true">&rarr;</i></a>
        </div>
      </div>
      <button class="lg-cue" id="lg-cue" type="button" aria-label="Scroll to content">&darr;</button>
    </section>

    <section class="lg-stmt wrap" id="product">
      <h2>Introducing the Hyperporter OS</h2>
      <p>The platform underneath every tier — free, forever, on both sides of the market.</p>
    </section>

    {/* Four moves, not nine stages. The nine live on /autopilot now; this is
        the shape of the whole system, and the light running the rail is the
        one from the pre-Astro build. */}
    <section class="lg-pipe-sec wrap" id="stages">
      <div class="lg-sec-lead">
        <p class="eyebrow rv">System overview</p>
        <h2 class="rv">Four moves, start to finish.</h2>
      </div>
      <div class="lg-pipe rv">
        <div class="lg-pipe-rail"><span aria-hidden="true"></span></div>
        <ol class="lg-pipe-row">
          {
            MOVES.map((m, i) => (
              <li class="lg-pnode">
                <span class="lg-pcode">Step {String(i + 1).padStart(2, '0')}</span>
                <span class="lg-pdot" aria-hidden="true" />
                <h3>{m.name}</h3>
                <p>{m.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <a class="lg-read rv" href="/autopilot">
        <span aria-hidden="true">&#8627;</span> <span>All nine stages, on Autopilot</span>
      </a>
    </section>

    <section class="lg-sec wrap">
      <div class="lg-sec-lead">
        <h2>Four layers, one connected system.</h2>
        <p class="dek">Each one sits on the one below it. Nothing is taken away as you move up.</p>
      </div>
      <div class="lg-grid4">
        {
          PRODUCTS.map((p) => (
            <article class="lg-card">
              <figure>
                <svg viewBox="0 0 320 400" role="img" aria-label={CARD_ALT[p.slug]} set:html={CARD_ART[p.slug]} />
              </figure>
              <span class="lg-avail">{p.availability}</span>
              <h3>{p.name}</h3>
              <p>{p.summary}</p>
              <a class="lg-read" href={`/${p.slug}`}>
                <span aria-hidden="true">&#8627;</span> <span>Read more</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="lg-car" id="customers">
      <div class="wrap lg-car-head">
        <h2>Every side.<br />Every trip.</h2>
        <p>
          Resellers source suppliers and run the full ladder. Suppliers are the ones being sourced,
          and stay free on Showcase.
        </p>
      </div>
      <Carousel items={SEGMENTS} active={2} uid="seg" />
    </section>

    <section class="lg-gal" id="destinations">
      <div class="wrap lg-gal-head">
        <h2>Every destination,<br />drawn rather than stocked.</h2>
        <p>
          Destination artwork is generated, not stock — one scene per country, built from that
          country’s own landmark and seeded so the palette never repeats.
        </p>
      </div>
      <div class="wrap lg-gal-grid">
        {
          places.map((p, i) => (
            <a class="lg-gal-i" href={`/destinations/${p.name.toLowerCase().replace(/\s+/g, '-')}`}>
              <Fragment set:html={destArt(p.name, `g${i}`, 'light')} />
              <span class="lg-gal-n">{p.name}</span>
              <span class="lg-gal-r">{p.region}</span>
            </a>
          ))
        }
      </div>
      <p class="lg-gal-note">
        Placeholders until photography is licensed — a real photo drops in per country without
        touching the layout.
      </p>
    </section>

    <section class="lg-inter" data-chrome="dark">
      <img src="/hero.jpg" alt="" />
      <div class="lg-inter-in">
        <p class="eyebrow">Horizon</p>
        <h2>A vetted list of DMCs and suppliers, ready to quote.</h2>
      </div>
    </section>

    <section class="lg-sec wrap">
      <div class="lg-statwrap">
        <div class="lg-statprose">
          <p>
            Every trip involves the same coordination work, repeated by hand, agency by agency —
            chasing DMCs over email, relaying messages between travellers and drivers, rebuilding
            the same itinerary for the fifth time.
          </p>
          <p>
            Hyperporter puts that work on one thread, and leaves a person exactly where judgment is
            actually needed.
          </p>
        </div>
        <div class="lg-stats">
          {
            STATS.map(([n, label]) => (
              <div class="lg-strow">
                <b>{n}</b>
                <p>{label}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="lg-vision">
      <div class="wrap lg-vision-grid">
        <div>
          <h2>Our vision</h2>
          <div class="lg-vision-by">
            <div class="lg-portrait">
              Founder portrait pending — not invented here, the same way /about carries its
              placeholders visibly.
            </div>
            <div class="lg-vision-name">Name pending</div>
            <div class="lg-vision-role">Founder &amp; CEO</div>
          </div>
        </div>
        <div>
          <div class="lg-vision-prose">
            <div>
              <p>
                Hyperporter was built by people who’ve coordinated trips the old way — chasing DMCs
                over email, relaying WhatsApp messages between travellers and drivers, rebuilding
                the same itinerary PDF for the fifth time.
              </p>
              <p>
                Every trip involves the same coordination work, repeated by hand, agency by agency.
                We think that work should run itself.
              </p>
            </div>
            <div>
              <p>
                Not all of it, though. Automation that pretends a person is never needed is
                automation that fails quietly, at the worst moment, on someone’s holiday.
              </p>
              <p>
                So the escalation points are designed in: money changing hands, and a traveller in
                trouble. Those stay human on purpose.
              </p>
            </div>
          </div>
          <div class="lg-vision-photo">
            <img
              src="/hero.jpg"
              alt="Mountain range at dawn, cloud filling the valleys below the ridgelines."
            />
          </div>
        </div>
      </div>
    </section>

    <section class="lg-sec-dark" data-chrome="dark">
      <div class="wrap">
        <h2>Built to the standard your contracts and rates actually deserve.</h2>
        <a class="lg-read" href="/security"><span aria-hidden="true">&#8627;</span> <span>Read more</span></a>
        <p class="lg-fine">
          Encryption in transit and at rest. Zero standing access. Account isolation. No training on
          your data.<br />SOC&nbsp;2 and GDPR-formal compliance are targeted post-pilot — not held
          today, and we won’t imply otherwise.
        </p>
        <div class="lg-certs">
          {
            CERTS.map((c) => (
              <div class="lg-cert">
                <b>{c.title}</b>
                <p>{c.body}</p>
                <div class:list={['lg-seal', { 'lg-pending': c.pending }]}>
                  <i>
                    {c.status.split('\n').map((line, i) => (
                      <Fragment>
                        {i > 0 && <br />}
                        {line}
                      </Fragment>
                    ))}
                  </i>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="lg-sec wrap" style="padding-top:0">
      <div class="lg-faq">
        {
          HOME_FAQ.map((f, i) => (
            <div class="lg-qa">
              <button type="button" aria-expanded="false" aria-controls={`q${i}`}>
                {f.q} <i aria-hidden="true">+</i>
              </button>
              <div class="lg-qa-b" id={`q${i}`} hidden>
                {f.a}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="lg-close wrap">
      <h2>Run your next trip on<br />infrastructure, not inboxes.</h2>
      <a class="btn btn-lg" href="/signup">Get started free <i aria-hidden="true">&rarr;</i></a>
    </section>
  </main>

</Base>

<script>
  /* The FAQ accordion. Base.astro's global handler covers `.acc-i` elsewhere
     on the site and does not reach these. */
  document.querySelectorAll<HTMLButtonElement>('.lg-qa button').forEach((btn) => {
    btn.addEventListener('click', () => {
      const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (!panel) return;
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  });

  /* Scroll cue: only means anything at rest, so it leaves once the page moves. */
  const cue = document.getElementById('lg-cue');
  if (cue) {
    cue.addEventListener('click', () =>
      document.getElementById('product')?.scrollIntoView({
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      })
    );
    window.addEventListener(
      'scroll',
      () => cue.classList.toggle('lg-gone', window.scrollY > 40),
      { passive: true }
    );
  }

  /**
   * Stat numerals count up from zero each time the rows come into view — not
   * once per page load, so scrolling back to the section replays it. A run is
   * re-armed only after the row has left the viewport again, otherwise a
   * scroll that jiggles the threshold restarts it mid-count.
   *
   * The final value lives in the markup, so with JS off, or under
   * prefers-reduced-motion, the real number is what shows.
   */
  const stats = Array.from(document.querySelectorAll<HTMLElement>('.lg-strow b'));
  if (stats.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const finals = new WeakMap<HTMLElement, string>();
    const armed = new WeakMap<HTMLElement, boolean>();
    stats.forEach((el) => {
      finals.set(el, el.textContent ?? '');
      armed.set(el, true);
    });

    const run = (el: HTMLElement): void => {
      const final = finals.get(el) ?? '';
      const m = final.match(/^(\D*)(\d+(?:\.\d+)?)(.*)$/);
      if (!m) return;
      const [, pre, num, post] = m;
      const target = parseFloat(num);
      const dp = (num.split('.')[1] ?? '').length;
      let t0: number | null = null;
      const step = (ts: number): void => {
        if (t0 === null) t0 = ts;
        const p = Math.min((ts - t0) / 900, 1);
        el.textContent = pre + (target * (1 - Math.pow(1 - p, 3))).toFixed(dp) + post;
        if (p < 1) requestAnimationFrame(step);
        else el.textContent = final;
      };
      el.textContent = pre + (0).toFixed(dp) + post;
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          const el = e.target as HTMLElement;
          if (e.isIntersecting) {
            if (!armed.get(el)) return;
            armed.set(el, false);
            run(el);
          } else {
            armed.set(el, true);
          }
        }),
      { threshold: 0.5 }
    );
    stats.forEach((el) => io.observe(el));
  }
</script>
