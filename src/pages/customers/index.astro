---
/** Customers index — the two sides of a booking, then the segments inside each. */
import Base from '../../layouts/Base.astro';
import { OVERVIEWS, SEGMENTS, SIDE_LABEL, SIDE_SUB } from '../../lib/content/customers';
import Mockup from '../../components/Mockup.astro';
import V2Hero from '../../components/V2Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { photoFor } from '../../lib/photos';
import '../../styles/v2.css';

const SIDES = [
  {
    side: 'reseller' as const,
    body: 'Runs the full ladder — Portal, Autopilot, Intelligence — and sources suppliers through the Horizon list.',
  },
  {
    side: 'supplier' as const,
    body: 'Skips straight to Intelligence — free CRM on Showcase, listed on Horizon at no cost.',
  },
];
---

<Base
  title="Customers"
  description="Same product underneath. Different starting point, depending on whether you're sourcing suppliers or being sourced."
  currentNav="customers"
  v2
>
  <V2Hero
    eyebrow="Customers"
    title="Whichever side of the booking you're on."
    lede="Same product underneath. Different starting point, depending on whether you're sourcing suppliers or being sourced."
    photo={photoFor('customers')}
  >
    <Fragment slot="aside"><Mockup screen="contacts" /></Fragment>
  </V2Hero>

  <section class="v-light v-band">
    <div class="v-wrap">
      <div class="v-inds v-cols">
        {
          SIDES.map(({ side, body }) => {
            const overview = OVERVIEWS.find((o) => o.side === side)!;
            const segments = SEGMENTS.filter((s) => s.side === side);
            return (
              <div class="v-ind">
                <span class="v-eyebrow">{SIDE_LABEL[side]}</span>
                <h3>{SIDE_SUB[side]}</h3>
                <p>{body}</p>
                <ul class="v-seglist">
                  {segments.map((s) => (
                    <li>
                      <a href={`/customers/${s.slug}`}>{s.name}</a>
                    </li>
                  ))}
                </ul>
                <a class="v-pill-d" href={`/customers/${overview.slug}`}>
                  Explore {overview.name}
                </a>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <CtaBand
    lead="Same platform, either side."
    rest="Free to start on both, and free for suppliers for good."
  />
</Base>
