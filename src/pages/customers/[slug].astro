---
/**
 * Customer pages, in the founder's sequence for Solutions (Sep 2026, after
 * the reference's solutions pages): a light hero — eyebrow and headline
 * left, lede and button right; three
 * points with icons; "how they use it" as the reference's accordion on a
 * dark ground, the screen beside; and the closing statement band.
 *
 * Two shapes share this route:
 *
 *  - the two overviews (Agent Portal, Supplier Portal), which the homepage
 *    points at — they have no reasons, so no points section
 *  - the six segment pages, which carry three reasons each
 *
 * The pricing ladder that used to close the segment pages is on /pricing.
 */
import Base from '../../layouts/Base.astro';
import { OVERVIEWS, SEGMENTS } from '../../lib/content/customers';
import type { Overview, Segment } from '../../lib/content/customers';
import StepScreen from '../../components/StepScreen.astro';
import { STEP_SCREENS } from '../../lib/content/steps';
import Points from '../../components/Points.astro';
import CtaBand from '../../components/CtaBand.astro';
import '../../styles/solutions.css';

// The screen each segment opens on: the part of the product that segment
// actually lives in. Suppliers see their own side — requests and quotes —
// never Horizon, which is not something they log into.
const SCREEN: Record<string, string> = {
  'agent-portal': 'sourcing',
  'supplier-portal': 'request',
  'travel-agencies': 'team',
  'travel-agents': 'book',
  'independent-advisors': 'proposal',
  creators: 'inquiry',
  dmcs: 'quote',
  'tour-operators': 'vault',
};

export function getStaticPaths() {
  return [
    ...OVERVIEWS.map((o) => ({ params: { slug: o.slug }, props: { overview: o, segment: null } })),
    ...SEGMENTS.map((s) => ({ params: { slug: s.slug }, props: { overview: null, segment: s } })),
  ];
}

const { overview, segment } = Astro.props as {
  overview: Overview | null;
  segment: Segment | null;
};

const page = (overview ?? segment)!;
const features = page.features;
// Lower-cased for mid-sentence, unless the name is an initialism ("DMCs").
const asWho = (name: string): string => (/^[A-Z]{2}/.test(name) ? name : name.toLowerCase());
const who = segment ? asWho(segment.name) : overview!.side === 'reseller' ? 'resellers' : 'suppliers';
const howTitle = overview ? overview.sectionTitle : `How ${who} use Hyperporter`;
/** The closing comparison is the page's own — see content/customers.ts. */
const close = (segment ?? overview!).close;

/* One screen per step. These pages used to show a single screen beside the
   whole accordion, so three of every four steps sat next to a picture of
   something else. */
const steps = STEP_SCREENS[page.slug];
if (!steps) throw new Error(`No step screens for "${page.slug}" (content/steps.ts).`);
if (steps.length !== features.length) {
  throw new Error(`"${page.slug}": ${features.length} steps but ${steps.length} screens.`);
}
---

<Base
  title={overview ? overview.name : segment!.name}
  description={page.lede}
  currentNav="customers"
>
  <section class="sec wrap sol-hero">
    <div class="sol-hero-grid">
      <div>
        <p class="eyebrow rv">{page.eyebrow}</p>
        <h1 class="rv">{page.title}</h1>
      </div>
      <div>
        <p class="lede rv">{page.lede}</p>
        <div class="rv" style="display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn" href="https://portal.hyperporter.com">Get started free</a>
          <a class="btn-o" href={overview ? overview.pricingHref : '/pricing'}>
            {overview ? overview.pricingLabel : 'See pricing'}
          </a>
        </div>
      </div>
    </div>
  </section>

  {segment && <Points title={`How ${who} stay ahead`} points={segment.reasons} />}

  <section class="acc-dark" data-chrome="dark">
    <div class="wrap">
      <div class="lg-acc">
        <div class="lg-acc-head">
          <h2>{howTitle}</h2>
          {overview?.note && <p class="lede" style="color:#B4BBC3;margin:14px 0 0">{overview.note}</p>}
        </div>
        <div class="lg-acc-list">
          {
            features.map((f, i) => (
              <div class:list={['lg-acc-item', { on: i === 0 }]}>
                <button
                  type="button"
                  class="lg-acc-btn"
                  id={`use-tab-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`use-body-${i}`}
                >
                  {f.name}
                </button>
                <div class="lg-acc-body" id={`use-body-${i}`} inert={i !== 0}>
                  <div>
                    <p>{f.body}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <div class="lg-acc-shot">
          {steps.map((sc, i) => (
            <div class:list={{ on: i === 0 }} inert={i !== 0}>
              <StepScreen screen={sc} ground="warm" app={page.name} alt={`${page.name}: ${features[i].name}`} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBand before={close.before} after={close.after} />
</Base>

<script>
  import '../../lib/accordion';
</script>
