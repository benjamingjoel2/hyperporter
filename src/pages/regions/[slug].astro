---
/**
 * Ported from hyperporter-3.html's openRegion() / #view-region. One
 * static page per canonical region (see REGIONS in content.config.ts —
 * this is the taxonomy Horizon's radial diagram gets rebuilt onto when
 * that page is ported, rather than keeping its own overlapping list).
 */
import { getCollection } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Base from '../../layouts/Base.astro';
import { destArt } from '../../lib/landmark/generator';
import { REGIONS } from '../../content.config';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  const destinations = await getCollection('destinations');
  return REGIONS.map((region) => {
    const countries = destinations
      .filter((d) => d.data.region === region)
      .map((d) => ({ name: d.data.title, slug: d.id, description: d.data.description }))
      .sort((a, b) => a.name.localeCompare(b.name));
    return {
      params: { slug: slugify(region) },
      props: { region, countries },
    };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { region, countries } = Astro.props;
---

<Base
  title={region}
  description={`Sell and operate trips across ${region} on vetted local operators from the Horizon network — quoted, booked and run without cold outreach.`}
  currentNav="destinations"
>
  <section class="hx hx-ph">
    <p class="hx-ph-eye"><a class="hx-back" href="/destinations">&larr; All destinations</a></p>
    <h1>Sell trips in {region}</h1>
    <p class="hx-ph-lede">
      {countries.length} countries with vetted local operators from the Horizon network —
      quoted, booked and run without cold outreach.
    </p>
    <div class="hx-ph-cta">
      <a class="btn" href="/signup">Request a demo</a>
      <a class="btn-o" href="/horizon">About Horizon</a>
    </div>
  </section>

  <section class="hx" style="padding-bottom:var(--sec)">
    <div class="hx-tiles">
      {
        countries.map((c, i) => (
          <a class="hx-tile" href={`/destinations/${c.slug}`}>
            <span class="hx-tile-art" set:html={destArt(c.name, `rgc${i}`)} />
            <span class="hx-tile-r">{region}</span>
            <span class="hx-tile-n">{c.name}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>
