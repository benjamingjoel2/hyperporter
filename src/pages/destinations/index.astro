---
/**
 * Destinations index, on the site's shared page patterns.
 *
 * The prototype's two-mode toggle — "explore by regions" / "search by
 * country" — is gone. It hid half the content behind a control most
 * people never pressed. Regions are tiles, every country is listed below
 * them, and the search filters that list in place rather than swapping
 * the page for a different one.
 *
 * Counts come from the collection, so they cannot drift from the rest of
 * the site.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { REGIONS } from '../../content.config';
import { slugify } from '../../lib/slug';
import { destArt } from '../../lib/landmark/generator';
import WorldMap from '../../components/WorldMap.astro';

const destinations = await getCollection('destinations');

const regionGroups = REGIONS.map((region) => {
  const countries = destinations
    .filter((d) => d.data.region === region)
    .map((d) => ({ name: d.data.title, slug: d.id }))
    .sort((a, b) => a.name.localeCompare(b.name));
  return { region, slug: slugify(region), countries };
}).filter((g) => g.countries.length > 0);

const totalCountries = destinations.length;
---

<Base
  title="Destinations"
  description={`${totalCountries} countries across ${regionGroups.length} regions, run on the ground by vetted local operators through the Horizon network.`}
  currentNav="destinations"
>
  <section class="hx hx-ph">
    <p class="hx-ph-eye">Where we operate</p>
    <h1>{totalCountries} countries, {regionGroups.length} regions.</h1>
    <p class="hx-ph-lede">
      Trips run on the ground by vetted local operators, across every region Horizon
      reaches.
    </p>
  </section>

  <!-- ============ COVERAGE MAP ============ -->
  <section class="hx-mapband">
    <div class="hx">
      <WorldMap interactive />
    </div>
  </section>

  <!-- ============ REGIONS ============ -->
  <section class="hx hx-sec">
    <div class="hx-tiles">
      {
        regionGroups.map((g) => (
          <a class="hx-tile" href={`/regions/${g.slug}`}>
            <span class="hx-tile-art" set:html={destArt(g.countries[0].name, `rg-${g.slug}`)} />
            <span class="hx-tile-r">{g.countries.length} countries</span>
            <span class="hx-tile-n">{g.region}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ EVERY COUNTRY ============ -->
  <section class="hx hx-sec">
    <div class="hx-dh">
      <h2>Every country</h2>
      <div class="hx-dsearch">
        <input type="search" id="d-q" placeholder="Search a country" aria-label="Search a country" />
        <span id="d-tally">{totalCountries} countries</span>
      </div>
    </div>

    <div id="dlist">
      {
        regionGroups.map((g) => (
          <div class="hx-dgroup" data-region={g.region}>
            <div class="hx-dgh">
              <h3>{g.region}</h3>
              <span>{g.countries.length}</span>
            </div>
            <div class="hx-dcols">
              {g.countries.map((c) => (
                <a href={`/destinations/${c.slug}`} data-name={c.name.toLowerCase()}>
                  {c.name}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <p class="hx-dnone" id="d-none" hidden>
      No destination matches that name — tell us where and we will source it.
    </p>
  </section>
</Base>

<script>
  // Filters the list that is already on the page. With no script, every
  // country is still listed and every link still works.
  const q = document.getElementById('d-q') as HTMLInputElement | null;
  const tally = document.getElementById('d-tally');
  const none = document.getElementById('d-none');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.hx-dgroup'));
  const total = document.querySelectorAll('#dlist a').length;

  function filter() {
    const query = (q?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const group of groups) {
      let has = false;
      for (const a of group.querySelectorAll<HTMLElement>('a')) {
        const match = !query || (a.dataset.name ?? '').includes(query);
        a.hidden = !match;
        if (match) {
          has = true;
          shown += 1;
        }
      }
      group.hidden = !has;
    }
    if (none) none.hidden = shown > 0;
    if (tally) {
      tally.textContent = query
        ? `${shown} ${shown === 1 ? 'match' : 'matches'}`
        : `${total} countries`;
    }
  }

  q?.addEventListener('input', filter);
</script>
