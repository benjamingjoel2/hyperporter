---
/**
 * Design direction A — editorial / bold.
 * Reference: oharchitecture.com.au + extantia.com, translated to light.
 *
 * The moves: one enormous uppercase display line per screen, numbered
 * section index in the margin, content sitting on the page instead of
 * inside cards, full-bleed near-black media bands for contrast, and mono
 * micro-labels carrying all the small information.
 *
 * Copy is real. The black blocks are honest placeholders — see the note
 * they carry. Throwaway page; see src/layouts/Preview.astro.
 */
import Preview from '../../layouts/Preview.astro';
import { STAGES } from '../../lib/stages';

const FONTS =
  'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Mono:wght@400;500&display=swap';

const NAV = ['Autopilot', 'Horizon', 'Destinations', 'How It Works', 'Blog', 'About'];
---

<Preview title="Hyperporter" fonts={FONTS} variant="a" label="Editorial / bold">
  <header class="top">
    <a class="mark" href="/preview/a/">Hyperporter</a>
    <nav>{NAV.map((n) => <a href="/preview/a/">{n}</a>)}</nav>
    <a class="cta" href="/preview/a/">Sign up</a>
  </header>

  <section class="hero">
    <p class="idx">(01) &mdash; Travel operations infrastructure</p>
    <h1>Run trips<br />on autopilot.</h1>
    <div class="hrow">
      <p class="lede">
        The coordination work between traveller, agency and operator — inquiry to booking to live
        trip support — runs itself. A human steps in only where it counts.
      </p>
      <form class="cap" onsubmit="return false">
        <input type="email" placeholder="Work email" aria-label="Work email" />
        <button type="submit">Get started</button>
      </form>
    </div>
    <dl class="stats">
      <div><dt>137</dt><dd>Countries in network</dd></div>
      <div><dt>09</dt><dd>Pipeline stages</dd></div>
      <div><dt>24/7</dt><dd>Autonomous relay</dd></div>
      <div><dt>02</dt><dd>Systems, one platform</dd></div>
    </dl>
  </section>

  <section class="band">
    <div class="block">
      <span class="ph">Photography pending — full-bleed operations imagery</span>
    </div>
  </section>

  <section class="pair">
    <p class="idx">(02) &mdash; What we're built on</p>
    <div class="two">
      <article>
        <h2>Autopilot</h2>
        <p class="kind">Our software</p>
        <p>
          Runs your agency's coordination work end to end. Subscribe monthly and point it at the
          partners you already have.
        </p>
        <a class="lnk" href="/preview/a/">Explore Autopilot &rarr;</a>
      </article>
      <article>
        <h2>Horizon</h2>
        <p class="kind">Our supplier network</p>
        <p>
          Vetted local operators across 137 countries. Use it inside Autopilot, or bring us the trip
          directly and we'll run it through the network.
        </p>
        <a class="lnk" href="/preview/a/">Explore Horizon &rarr;</a>
      </article>
    </div>
  </section>

  <section class="route">
    <div class="rhead">
      <p class="idx">(03) &mdash; The route</p>
      <h2>Nine stages,<br />start to finish.</h2>
    </div>
    <ol class="list">
      {
        STAGES.map((s) => (
          <li class:list={{ human: s.cls !== 'Automatic' }}>
            <span class="n">{s.n}</span>
            <span class="nm">{s.name}</span>
            <span class="nt">{s.note}</span>
            <span class="cl">{s.cls === 'Automatic' ? 'Auto' : 'Human'}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <footer>
    <h2>Start running trips<br />on autopilot.</h2>
    <a class="cta big" href="/preview/a/">Sign up &rarr;</a>
    <p class="fine">Hyperporter — Dubai World Trade Center, UAE</p>
  </footer>
</Preview>

<style>
  :root {
    --paper: #f7f8f9;
    --ink: #0b0f13;
    --mid: #5a6472;
    --line: rgba(11, 15, 19, 0.14);
    --acc: #1b747e;
  }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
  }
  .idx {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--mid);
    margin: 0 0 28px;
  }

  /* header ---------------------------------------------------------- */
  .top {
    display: flex;
    align-items: center;
    gap: 30px;
    padding: 22px clamp(20px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  .mark {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    font-size: 13px;
    text-decoration: none;
    margin-right: auto;
  }
  .top nav {
    display: flex;
    gap: 26px;
  }
  .top nav a {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--mid);
  }
  .top nav a:hover {
    color: var(--ink);
  }
  .cta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    background: var(--ink);
    color: var(--paper);
    padding: 11px 20px;
    border-radius: 99px;
  }
  @media (max-width: 900px) {
    .top nav {
      display: none;
    }
  }

  /* hero ------------------------------------------------------------ */
  .hero {
    padding: clamp(48px, 7vw, 104px) clamp(20px, 4vw, 56px) clamp(40px, 5vw, 72px);
  }
  h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(52px, 13vw, 194px);
    line-height: 0.84;
    letter-spacing: -0.045em;
    margin: 0 0 clamp(32px, 4vw, 56px);
  }
  .hrow {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    padding-bottom: clamp(30px, 4vw, 52px);
    border-bottom: 1px solid var(--line);
  }
  .lede {
    margin: 0;
    font-size: clamp(16px, 1.5vw, 20px);
    line-height: 1.5;
    color: var(--mid);
    max-width: 46ch;
  }
  .cap {
    display: flex;
    gap: 10px;
  }
  .cap input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 99px;
    padding: 15px 22px;
    font: inherit;
    font-size: 15px;
  }
  .cap input:focus {
    outline: none;
    border-color: var(--acc);
  }
  .cap button {
    border: 0;
    background: var(--ink);
    color: var(--paper);
    border-radius: 99px;
    padding: 15px 28px;
    font: inherit;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    white-space: nowrap;
  }
  @media (max-width: 820px) {
    .hrow {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: clamp(28px, 3.4vw, 44px) 0 0;
  }
  .stats dt {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 46px);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .stats dd {
    margin: 8px 0 0;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mid);
  }
  @media (max-width: 700px) {
    .stats {
      grid-template-columns: 1fr 1fr;
      gap: 26px 20px;
    }
  }

  /* media band ------------------------------------------------------ */
  .band {
    padding: 0 clamp(20px, 4vw, 56px);
  }
  .block {
    background: var(--ink);
    border-radius: 4px;
    aspect-ratio: 21 / 8;
    display: grid;
    place-items: center;
  }
  .ph {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.42);
    text-align: center;
    padding: 0 20px;
  }

  /* pair ------------------------------------------------------------ */
  .pair {
    padding: clamp(56px, 7vw, 108px) clamp(20px, 4vw, 56px);
  }
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(30px, 5vw, 80px);
    border-top: 1px solid var(--line);
    padding-top: clamp(28px, 3.5vw, 48px);
  }
  @media (max-width: 820px) {
    .two {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  .two h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin: 0 0 14px;
  }
  .kind {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--acc);
    margin: 0 0 20px;
  }
  .two p:not(.kind) {
    margin: 0 0 22px;
    color: var(--mid);
    font-size: 16px;
    line-height: 1.55;
    max-width: 42ch;
  }
  .lnk {
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }
  .lnk:hover {
    color: var(--acc);
    border-color: var(--acc);
  }

  /* route ------------------------------------------------------------ */
  .route {
    padding: 0 clamp(20px, 4vw, 56px) clamp(56px, 7vw, 108px);
  }
  .rhead h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(38px, 7vw, 104px);
    line-height: 0.88;
    letter-spacing: -0.042em;
    margin: 0 0 clamp(28px, 3.5vw, 48px);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .list li {
    display: grid;
    grid-template-columns: 60px 200px 1fr 78px;
    gap: 20px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    transition: padding-left 0.25s;
  }
  .list li:hover {
    padding-left: 10px;
  }
  .n {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--mid);
  }
  .nm {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: clamp(17px, 1.7vw, 22px);
  }
  .nt {
    color: var(--mid);
    font-size: 14.5px;
  }
  .cl {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--acc);
    text-align: right;
  }
  .list li.human .cl {
    color: #9a5f0b;
  }
  @media (max-width: 860px) {
    .list li {
      grid-template-columns: 44px 1fr 70px;
    }
    .nt {
      grid-column: 2 / 4;
    }
  }

  /* footer ------------------------------------------------------------ */
  footer {
    background: var(--ink);
    color: var(--paper);
    padding: clamp(56px, 8vw, 130px) clamp(20px, 4vw, 56px);
  }
  footer h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(38px, 8vw, 118px);
    line-height: 0.86;
    letter-spacing: -0.045em;
    margin: 0 0 40px;
  }
  .cta.big {
    background: var(--paper);
    color: var(--ink);
    font-size: 13px;
    padding: 16px 30px;
    display: inline-block;
  }
  .fine {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(247, 248, 249, 0.45);
    margin: clamp(44px, 6vw, 90px) 0 0;
  }
</style>
