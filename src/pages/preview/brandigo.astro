---
/**
 * Design study: the Brandigo layout, applied to Hyperporter.
 *
 * The reference is photography-led and dark. Everything structural is
 * built here; every image is a real slot reading from /public/photos/, so
 * dropping files in that folder is the only remaining step. A missing file
 * falls back to a labelled placeholder rather than a broken image.
 *
 * Taken from the reference:
 *   - full-viewport photographic hero, scrimmed, copy laid over it
 *   - high-contrast serif display mixed with a grotesque for body
 *   - an arrow set inside the headline itself
 *   - [bracketed] micro-labels and a [02] section index
 *   - a staggered photo-card grid, icon chip top-left, title at the bottom
 *   - oversized rotated word running up the left edge
 *   - two-weight sans heading (light grey + solid white)
 *   - pill buttons with a circular arrow badge
 *   - small pink dot / yellow triangle floating accents
 */
import Preview from '../../layouts/Preview.astro';
import { destArt } from '../../lib/landmark/generator';

const FONTS =
  'https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap';

/** Image slots. `file` maps to /public/photos/<file>; `alt` is required. */
const CARDS = [
  { file: 's1.jpg', place: 'Japan', icon: '✉', t: 'Inquiry', d: 'Structured from the first message, whichever channel it arrives on.' },
  { file: 's2.jpg', place: 'Peru', icon: '◈', t: 'Planning', d: 'A draft itinerary before the customer has to ask twice.' },
  { file: 's3.jpg', place: 'Portugal', icon: '⟐', t: 'Quotation', d: 'Real quotes, requested from the right suppliers automatically.' },
  { file: 's4.jpg', place: 'Morocco', icon: '◉', t: 'Booking', d: 'Money changes hands with a human’s eyes on it, every time.' },
  { file: 's5.jpg', place: 'Kenya', icon: '➤', t: 'Traveling', d: 'Live support that runs itself, until it shouldn’t.' },
  { file: 's6.jpg', place: 'Indonesia', icon: '✦', t: 'Horizon', d: 'Vetted local operators across 137 countries.' },
];
---

<Preview title="Hyperporter — Brandigo study" fonts={FONTS}>
  <header class="top">
    <a class="mk" href="/preview/brandigo/">hyperporter<span>.</span></a>
    <button class="burger" type="button" aria-label="Menu"><span></span><span></span></button>
  </header>

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="shot">
      <img src="/photos/hero.jpg" alt="" onerror="this.remove()" />
    </div>
    <div class="scrim"></div>

    <span class="brk tl">[137 Countries]</span>

    <div class="thumbs">
      {['t1.jpg', 't2.jpg', 't3.jpg'].map((f, i) => (
        <span class="thumb">
          <span class="fb" set:html={destArt(['Nepal', 'Oman', 'Mexico'][i], `th${i}`, 'dark')} />
          <img src={`/photos/${f}`} alt="" onerror="this.remove()" />
        </span>
      ))}
    </div>

    <p class="hlede">
      From first inquiry to last day of the trip, everything we build is designed to take the
      coordination work off your desk and keep it off.
    </p>

    <div class="hbot">
      <span class="brk">[02]</span>
      <h1>Built for Agencies<br />Who <span class="arw">&#8594;</span> Want to Win</h1>
      <a class="btn" href="/preview/brandigo/"><i>&#8594;</i>Scale Your Agency</a>
    </div>

    <span class="dot"></span><span class="tri"></span>
    <span class="scrollcue">Scroll</span>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="svc">
    <span class="rot">SERVICES / SE</span>
    <div class="svc-in">
      <div class="stars">✦✦✦✦✦✦</div>
      <h2><em>What</em> we offer?</h2>
      <div class="srow">
        <p>
          A full-stack operations layer: intake, itinerary building, supplier quoting, booking,
          live trip support and a global ground network.
        </p>
        <a class="btn line" href="/preview/brandigo/"><i>&#8594;</i>View All Services</a>
      </div>
      <span class="dot s"></span><span class="tri s"></span>

      <div class="cards">
        {
          CARDS.map((c, i) => (
            <a class:list={['card', i % 3 === 1 ? 'drop' : '']} href="/preview/brandigo/">
              <span class="cimg">
                <span class="fb" set:html={destArt(c.place, `cd${i}`, 'dark')} />
                <img src={`/photos/${c.file}`} alt="" onerror="this.remove()" />
                <i class="chip">{c.icon}</i>
              </span>
              <span class="ctxt">
                <b>{c.t}</b>
                <span>{c.d}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ BAND + SERIF HEADING (interior-page pattern) ============ -->
  <section class="band">
    <div class="bshot">
      <span class="fb" set:html={destArt('Bhutan', 'bnd', 'dark')} />
      <img src="/photos/about.jpg" alt="" onerror="this.remove()" />
    </div>
    <span class="dot b"></span><span class="tri b"></span>
  </section>

  <section class="lead">
    <h2 class="serif">We Are the Layer <span class="arw">&#8594;</span><br />Beneath the Trip</h2>
    <p>
      Hyperporter sits between the traveller, the agency and the operator on the ground, and keeps
      all three in sync — automatically, until a decision actually needs a person.
    </p>
  </section>

  <!-- ============ CTA ============ -->
  <section class="cta">
    <div class="shot">
      <span class="fb" set:html={destArt('Egypt', 'cta', 'dark')} />
      <img src="/photos/cta.jpg" alt="" onerror="this.remove()" />
    </div>
    <div class="scrim"></div>
    <div class="cta-in">
      <div class="stars">✦✦✦✦✦✦</div>
      <h2>Stop running trips by hand! Let’s put your operations on autopilot</h2>
      <p>Subscribe monthly and run it on the partners you already have, or add Horizon and use ours.</p>
      <a class="btn light" href="/preview/brandigo/"><i>&#8594;</i>Request A Call</a>
      <span class="dot c"></span><span class="tri c"></span>
    </div>
    <div class="fbar"><span>© 2026 Hyperporter | All Rights Reserved</span><span>Proudly Built in Dubai, UAE</span></div>
  </section>
</Preview>

<style>
  :root {
    --bg: #0a0a0b;
    --ink: #f4f3f1;
    --dim: rgba(244, 243, 241, 0.62);
    --line: rgba(244, 243, 241, 0.16);
    --pink: #ff2d6f;
    --yellow: #ffc42e;
    --red: #e8202a;
    --pad: clamp(20px, 4vw, 56px);
    --serif: 'EB Garamond', Georgia, serif;
    --sans: 'Space Grotesk', system-ui, sans-serif;
    --mono: 'IBM Plex Mono', monospace;
  }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 15.5px;
    line-height: 1.55;
  }
  .brk {
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .arw {
    font-family: var(--sans);
    font-weight: 400;
  }
  .stars {
    color: var(--line);
    letter-spacing: 0.35em;
    font-size: 13px;
    margin-bottom: 22px;
  }

  /* Image slots ---------------------------------------------------------
     Each slot layers a generated destination scene underneath a real <img>.
     Drop the file into /public/photos and the photo simply covers the
     scene; if it is missing the <img> removes itself on error and the
     scene shows instead. No broken-image icons, and nothing looks empty
     while the photography is still being sourced. */
  .shot,
  .bshot,
  .cimg,
  .thumb {
    position: relative;
    background: #16161a;
    overflow: hidden;
  }
  .shot > img,
  .bshot > img,
  .cimg > img,
  .thumb > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .fb {
    position: absolute;
    inset: 0;
    display: block;
  }
  .fb svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* buttons ------------------------------------------------------------ */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    color: #111;
    padding: 7px 24px 7px 7px;
    border-radius: 2px;
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
  }
  .btn i {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 2px;
    background: #111;
    color: #fff;
    font-style: normal;
    font-size: 15px;
    transition: transform 0.25s;
  }
  .btn:hover i {
    transform: translateX(3px);
  }
  .btn.line {
    background: none;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .btn.line i {
    background: #fff;
    color: #111;
  }
  .btn.light {
    background: none;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.55);
  }
  .btn.light i {
    background: #fff;
    color: #111;
  }

  /* floating accents ---------------------------------------------------- */
  .dot,
  .tri {
    position: absolute;
    z-index: 4;
  }
  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--pink);
  }
  .tri {
    width: 0;
    height: 0;
    border-left: 11px solid var(--yellow);
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
  }
  .hero .dot {
    left: 58%;
    top: 57%;
  }
  .hero .tri {
    left: 61%;
    top: 59%;
  }
  .dot.s {
    left: 52%;
    top: 176px;
  }
  .tri.s {
    left: 55%;
    top: 179px;
  }
  .dot.b {
    left: 39%;
    top: 56%;
  }
  .tri.b {
    left: 42%;
    top: 58%;
  }
  .dot.c {
    left: 44%;
    top: -12px;
  }
  .tri.c {
    left: 47%;
    top: -9px;
  }

  /* header -------------------------------------------------------------- */
  .top {
    position: absolute;
    z-index: 6;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 26px var(--pad);
  }
  .mk {
    font-size: 27px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .mk span {
    color: var(--pink);
  }
  .burger {
    background: none;
    border: 0;
    padding: 6px;
    cursor: pointer;
  }
  .burger span {
    display: block;
    width: 30px;
    height: 2px;
    background: var(--ink);
    margin: 7px 0;
  }

  /* hero ---------------------------------------------------------------- */
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    isolation: isolate;
  }
  .hero .shot {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 11, 0.62) 0%, rgba(10, 10, 11, 0.22) 38%, rgba(10, 10, 11, 0.88) 100%);
  }
  .brk.tl {
    position: absolute;
    z-index: 4;
    left: var(--pad);
    top: clamp(96px, 13vh, 150px);
  }
  .thumbs {
    position: absolute;
    z-index: 4;
    right: var(--pad);
    top: clamp(96px, 13vh, 150px);
    display: flex;
    gap: 5px;
  }
  .thumb {
    position: relative;
    width: clamp(62px, 7vw, 96px);
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    isolation: isolate;
  }
  .hlede {
    position: absolute;
    z-index: 4;
    right: var(--pad);
    top: 46%;
    max-width: 40ch;
    margin: 0;
    text-align: right;
    font-size: clamp(15px, 1.35vw, 19px);
    line-height: 1.5;
  }
  .hbot {
    position: absolute;
    z-index: 4;
    left: var(--pad);
    right: var(--pad);
    bottom: clamp(30px, 5vh, 66px);
  }
  .hbot h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(44px, 8vw, 118px);
    line-height: 1.0;
    letter-spacing: 0.002em;
    margin: 14px 0 30px;
  }
  .scrollcue {
    position: absolute;
    z-index: 4;
    right: var(--pad);
    bottom: clamp(30px, 5vh, 66px);
    font-size: 15px;
    color: var(--dim);
  }
  @media (max-width: 820px) {
    .hlede,
    .thumbs {
      display: none;
    }
  }

  /* services ------------------------------------------------------------ */
  .svc {
    position: relative;
    padding: clamp(56px, 8vw, 120px) 0;
  }
  .rot {
    position: absolute;
    left: -6px;
    top: 42%;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-weight: 700;
    font-size: clamp(56px, 9vw, 132px);
    letter-spacing: -0.04em;
    color: rgba(244, 243, 241, 0.05);
    pointer-events: none;
    user-select: none;
  }
  .svc-in {
    position: relative;
    padding: 0 var(--pad) 0 clamp(56px, 11vw, 190px);
  }
  .svc h2 {
    margin: 0 0 26px;
    font-weight: 700;
    font-size: clamp(34px, 5.2vw, 74px);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .svc h2 em {
    font-style: normal;
    color: var(--dim);
  }
  .srow {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 30px;
    flex-wrap: wrap;
    margin-bottom: clamp(40px, 6vw, 88px);
  }
  .srow p {
    margin: 0;
    max-width: 52ch;
    color: var(--dim);
    font-size: 16px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(14px, 1.8vw, 26px);
  }
  .card {
    display: block;
  }
  .card.drop {
    margin-top: clamp(24px, 4vw, 62px);
  }
  .cimg {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--line);
    isolation: isolate;
    overflow: hidden;
  }
  .cimg::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(180deg, rgba(10, 10, 11, 0.15), rgba(10, 10, 11, 0.75));
  }
  .chip {
    position: absolute;
    z-index: 3;
    left: 14px;
    top: 14px;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 3px;
    background: rgba(10, 10, 11, 0.6);
    border: 1px solid var(--line);
    font-style: normal;
    font-size: 14px;
  }
  .ctxt {
    display: block;
    padding: 16px 2px 0;
  }
  .ctxt b {
    display: block;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .ctxt span {
    display: block;
    margin-top: 5px;
    color: var(--dim);
    font-size: 14.5px;
  }
  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr 1fr;
    }
    .rot {
      display: none;
    }
    .svc-in {
      padding-left: var(--pad);
    }
  }
  @media (max-width: 560px) {
    .cards {
      grid-template-columns: 1fr;
    }
    .card.drop {
      margin-top: 0;
    }
  }

  /* band + lead ---------------------------------------------------------- */
  .band {
    position: relative;
    padding: 0 var(--pad);
  }
  .bshot {
    position: relative;
    aspect-ratio: 21 / 9;
    isolation: isolate;
    border: 1px solid var(--line);
  }
  .lead {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: clamp(24px, 5vw, 80px);
    align-items: end;
    padding: clamp(44px, 6vw, 96px) var(--pad) clamp(56px, 8vw, 120px);
  }
  .serif {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(38px, 6.8vw, 104px);
    line-height: 1.02;
    letter-spacing: 0.002em;
    margin: 0;
  }
  .lead p {
    margin: 0;
    color: var(--dim);
    max-width: 46ch;
    font-size: 16px;
  }
  @media (max-width: 820px) {
    .lead {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  /* cta ------------------------------------------------------------------ */
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .cta .shot {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .cta-in {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 1000px;
    margin: 0 auto;
    padding: clamp(70px, 11vw, 170px) var(--pad) clamp(60px, 9vw, 140px);
  }
  .cta h2 {
    margin: 0 0 20px;
    font-weight: 700;
    font-size: clamp(28px, 4.4vw, 62px);
    line-height: 1.08;
    letter-spacing: -0.032em;
  }
  .cta p {
    margin: 0 auto 34px;
    max-width: 54ch;
    color: rgba(255, 255, 255, 0.78);
  }
  .fbar {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 20px var(--pad) 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 14px;
    color: rgba(255, 255, 255, 0.72);
  }
</style>
