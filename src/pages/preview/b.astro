---
/**
 * Design direction B — quiet luxury.
 * Reference: aman.com, translated to Hyperporter's content.
 *
 * The moves: a light serif display at modest size, warm paper rather than
 * cool white, very small body type with wide leading, enormous whitespace,
 * centred composition, hairline rules, and essentially no accent colour —
 * the restraint is the design.
 *
 * Same copy as direction A so the comparison is about the language, not
 * the words. Throwaway page; see src/layouts/Preview.astro.
 */
import Preview from '../../layouts/Preview.astro';
import { STAGES } from '../../lib/stages';

const FONTS =
  'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Jost:wght@300;400;500&display=swap';

const NAV = ['Autopilot', 'Horizon', 'Destinations', 'How It Works', 'Blog', 'About'];
---

<Preview title="Hyperporter" fonts={FONTS} variant="b" label="Quiet luxury">
  <header class="top">
    <nav class="l">{NAV.slice(0, 3).map((n) => <a href="/preview/b/">{n}</a>)}</nav>
    <a class="mark" href="/preview/b/">Hyperporter</a>
    <nav class="r">{NAV.slice(3).map((n) => <a href="/preview/b/">{n}</a>)}</nav>
  </header>

  <section class="hero">
    <p class="eye">Travel operations infrastructure</p>
    <h1>Run trips on autopilot</h1>
    <p class="lede">
      The coordination between traveller, agency and operator — inquiry to booking to live trip
      support — runs itself. A human steps in only where it counts.
    </p>
    <a class="ln" href="/preview/b/">Discover more</a>
  </section>

  <div class="plate">
    <span class="ph">Photography pending</span>
  </div>

  <section class="pair">
    <article>
      <p class="eye">Our software</p>
      <h2>Autopilot</h2>
      <p>
        Runs your agency's coordination work end to end. Subscribe monthly and point it at the
        partners you already have.
      </p>
      <a class="ln" href="/preview/b/">Discover more</a>
    </article>
    <article>
      <p class="eye">Our supplier network</p>
      <h2>Horizon</h2>
      <p>
        Vetted local operators across 137 countries. Use it inside Autopilot, or bring us the trip
        directly and we'll run it through the network.
      </p>
      <a class="ln" href="/preview/b/">Discover more</a>
    </article>
  </section>

  <section class="quiet">
    <h2>Nine stages, start to finish</h2>
    <p class="sub">
      Every trip follows the same route. Most of it happens without anyone touching it.
    </p>
  </section>

  <section class="route">
    <ol>
      {
        STAGES.map((s) => (
          <li>
            <span class="n">{s.n}</span>
            <span class="nm">{s.name}</span>
            <span class="nt">{s.note}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="stats">
    <div><b>137</b><span>Countries in network</span></div>
    <div><b>Nine</b><span>Pipeline stages</span></div>
    <div><b>24/7</b><span>Autonomous relay</span></div>
  </section>

  <footer>
    <h2>Start running trips on autopilot</h2>
    <form class="cap" onsubmit="return false">
      <input type="email" placeholder="Work email" aria-label="Work email" />
      <button type="submit">Sign up</button>
    </form>
    <p class="fine">Hyperporter &mdash; Dubai World Trade Center, UAE</p>
  </footer>
</Preview>

<style>
  :root {
    --paper: #f6f3ee;
    --ink: #1c1b18;
    --mid: #6b675f;
    --line: rgba(28, 27, 24, 0.16);
  }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Jost', system-ui, sans-serif;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.75;
  }
  .eye {
    font-size: 10.5px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--mid);
    margin: 0 0 22px;
  }
  h1,
  h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 300;
    letter-spacing: 0.005em;
    margin: 0;
  }
  .ln {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 5px;
    color: var(--ink);
  }
  .ln:hover {
    color: var(--mid);
    border-color: var(--mid);
  }

  /* header ---------------------------------------------------------- */
  .top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 30px clamp(20px, 5vw, 68px);
  }
  .top nav {
    display: flex;
    gap: 30px;
  }
  .top nav.r {
    justify-content: flex-end;
  }
  .top nav a {
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--mid);
  }
  .top nav a:hover {
    color: var(--ink);
  }
  .mark {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 900px) {
    .top {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .top nav {
      display: none;
    }
  }

  /* hero ------------------------------------------------------------ */
  .hero {
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(70px, 11vw, 170px) 24px clamp(56px, 8vw, 120px);
  }
  h1 {
    font-size: clamp(40px, 6.6vw, 86px);
    line-height: 1.08;
    margin: 0 0 30px;
  }
  .lede {
    color: var(--mid);
    max-width: 52ch;
    margin: 0 auto 38px;
  }

  /* plate ------------------------------------------------------------ */
  .plate {
    margin: 0 clamp(20px, 5vw, 68px);
    aspect-ratio: 16 / 7;
    background: #ddd8d0;
    display: grid;
    place-items: center;
  }
  .ph {
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8d877d;
  }

  /* pair ------------------------------------------------------------ */
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 8vw, 130px);
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(70px, 10vw, 150px) clamp(20px, 5vw, 68px);
  }
  @media (max-width: 820px) {
    .pair {
      grid-template-columns: 1fr;
      gap: 60px;
    }
  }
  .pair h2 {
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.15;
    margin: 0 0 20px;
  }
  .pair p {
    color: var(--mid);
    margin: 0 0 32px;
    max-width: 40ch;
  }

  /* quiet statement --------------------------------------------------- */
  .quiet {
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px clamp(44px, 6vw, 76px);
  }
  .quiet h2 {
    font-size: clamp(30px, 4.4vw, 58px);
    line-height: 1.14;
    margin: 0 0 20px;
  }
  .sub {
    color: var(--mid);
    margin: 0;
  }

  /* route ------------------------------------------------------------ */
  .route {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 68px) clamp(70px, 10vw, 150px);
  }
  .route ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .route li {
    display: grid;
    grid-template-columns: 54px 190px 1fr;
    gap: 22px;
    align-items: baseline;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .route .n {
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--mid);
  }
  .route .nm {
    font-family: 'Cormorant Garamond', serif;
    font-size: 24px;
  }
  .route .nt {
    color: var(--mid);
    font-size: 14px;
  }
  @media (max-width: 780px) {
    .route li {
      grid-template-columns: 42px 1fr;
    }
    .route .nt {
      grid-column: 2;
    }
  }

  /* stats ------------------------------------------------------------ */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 68px) clamp(70px, 10vw, 150px);
    text-align: center;
    gap: 40px;
  }
  .stats b {
    display: block;
    font-family: 'Cormorant Garamond', serif;
    font-weight: 300;
    font-size: clamp(40px, 5vw, 66px);
    line-height: 1;
    margin-bottom: 14px;
  }
  .stats span {
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mid);
  }
  @media (max-width: 700px) {
    .stats {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }

  /* footer ------------------------------------------------------------ */
  footer {
    text-align: center;
    border-top: 1px solid var(--line);
    padding: clamp(64px, 9vw, 130px) 24px clamp(48px, 6vw, 80px);
  }
  footer h2 {
    font-size: clamp(30px, 4.4vw, 58px);
    line-height: 1.14;
    margin: 0 0 40px;
  }
  .cap {
    display: flex;
    gap: 0;
    max-width: 460px;
    margin: 0 auto;
    border-bottom: 1px solid var(--ink);
  }
  .cap input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    padding: 14px 4px;
    font: inherit;
    color: inherit;
  }
  .cap input:focus {
    outline: none;
  }
  .cap button {
    border: 0;
    background: none;
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    padding: 14px 4px 14px 18px;
    color: var(--ink);
  }
  .fine {
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--mid);
    margin: clamp(56px, 8vw, 110px) 0 0;
  }
</style>
