---
/**
 * How It Works. Ported from hyperporter-3.html's #view-how: the nine-stage
 * spine, rendered at build time from STAGES. Amber marks human-touchpoint
 * stages only — it's reserved for manual states in the design system.
 */
import Base from '../layouts/Base.astro';
import { STAGES } from '../lib/stages';
---

<Base
  title="How It Works"
  description="One system, from first message to last day of the trip — the nine stages every trip runs through, and where a human stays in the loop."
  currentNav="how"
>
  <div class="sec wrap dark-band">
    <p class="eyebrow rv">The route</p>
    <h1 class="rv">One system, from first message<br />to last day of the trip.</h1>
    <p class="lede rv">
      Every stage runs on a specific feature, and takes a specific action — here's the full route.
    </p>
  </div>
  <div class="sec-tight wrap">
    <div class="spine rv">
      {
        STAGES.map((s) => (
          <div class:list={['srow', { human: s.cls !== 'Automatic' }]}>
            <div class="scode">{s.c}</div>
            <div class="sname">{s.name}</div>
            <span class="pill-l">{s.cls}</span>
            <div class="snote">{s.note}</div>
          </div>
        ))
      }
    </div>
    <div style="margin-top:52px"><a class="btn rv" href="/signup">Sign up →</a></div>
  </div>
</Base>
