---
/**
 * Horizon — the NETWORK of vetted local operators. Never described as
 * software; that is Autopilot.
 *
 * Rebuilt on the same structure as the rest of the site: page head, a
 * full-bleed coverage band, region rows, the two positioning columns, and
 * the note for operators.
 *
 * The prototype's radial diagram is gone. It was a decorative wheel that
 * carried one fact — seven regions — in a form nobody could scan, and the
 * same seven regions now read as rows with their real country counts,
 * each linking to its region page.
 *
 * Country and region figures come from networkCounts(), not from copy.
 * This page previously hard-coded "130+" in three places while the
 * homepage said 137.
 */
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { networkCounts } from '../lib/counts';
import { slugify } from '../lib/slug';
import { destArt } from '../lib/landmark/generator';

const { countries, regions, regionCount } = await networkCounts();
const destinations = await getCollection('destinations');

/** Each region, with the number of countries actually in it. */
const REGION_ROWS = regions.map((region) => ({
  region,
  href: `/regions/${slugify(region)}`,
  count: destinations.filter((d) => d.data.region === region).length,
}));

/** One scene per region, so the band reads as coverage rather than decoration. */
const COVERAGE = [
  { name: 'Kenya', region: 'Africa' },
  { name: 'Japan', region: 'Asia' },
  { name: 'New Zealand', region: 'Australia & Oceania' },
  { name: 'Portugal', region: 'Europe' },
  { name: 'Oman', region: 'Middle East' },
  { name: 'Mexico', region: 'North & Central America' },
  { name: 'Peru', region: 'South America' },
  { name: 'Morocco', region: 'Africa' },
] as const;

const bandArt = destArt('Morocco', 'hz-band', 'dark');
---

<Base
  title="Horizon"
  description={`Hyperporter's own ground-operations network — vetted local operators in ${countries} countries. Use it inside Autopilot, or bring us the trip directly.`}
  currentNav="horizon"
>
  <!-- ============ HEAD ============ -->
  <section class="hx hx-ph">
    <p class="hx-ph-eye">Our supplier network</p>
    <h1>Real operator relationships, wherever your travellers are going.</h1>
    <p class="hx-ph-lede">
      Horizon is Hyperporter's own ground-operations network — vetted local operators in {
        countries
      } countries. Use it inside Autopilot, or bring us the trip directly and we will run it
      through the network for you.
    </p>
    <div class="hx-ph-cta">
      <a class="btn" href="/signup">Request a demo</a>
      <a class="btn-o" href="/destinations">See every country</a>
    </div>
  </section>

  <!-- ============ COVERAGE ============ -->
  <section class="hx">
    <div class="hx-tiles">
      {
        COVERAGE.map((c, i) => (
          <a class="hx-tile" href={`/destinations/${slugify(c.name)}`}>
            <span class="hx-tile-art" set:html={destArt(c.name, `hzcv${i}`)} />
            <span class="hx-tile-r">{c.region}</span>
            <span class="hx-tile-n">{c.name}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ REGIONS ============ -->
  <section class="hx hx-sec">
    <div class="hx-two" style="margin-bottom:clamp(34px,4vw,60px)">
      <h2>{regionCount} regions, {countries} countries</h2>
      <p>
        Operators we have vetted ourselves and run trips through directly. Every country has
        its own page, and every region its own list.
      </p>
    </div>
    <div class="hx-rows">
      {
        REGION_ROWS.map((r, i) => (
          <a class="hx-row hx-row-link" href={r.href}>
            <div class="hx-row-n">{String(i + 1).padStart(2, '0')}</div>
            <h3>{r.region}</h3>
            <p class="hx-row-b">{r.count} countries with vetted operators</p>
            <div class="hx-row-t">View region &rarr;</div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ============ POSITIONING ============ -->
  <section class="hx hx-sec">
    <div class="hx-grid">
      <div>
        <div class="hx-cell-n">01</div>
        <h3>The gap</h3>
        <p>
          Most agencies have deep operator relationships in a handful of destinations. The
          moment a client asks for somewhere outside that list, the process reverts to cold
          outreach and guesswork. Horizon exists so that gap never reaches your customer.
        </p>
      </div>
      <div>
        <div class="hx-cell-n">02</div>
        <h3>Not a marketplace</h3>
        <p>
          These are real, human-vetted relationships Hyperporter operates trips through
          directly — not a directory of unverified contacts. Every trip run through Horizon
          strengthens the reliability data behind the network.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ BAND ============ -->
  <section class="hx-band">
    <div class="hx-band-art" aria-hidden="true" set:html={bandArt} />
    <div class="hx hx-band-in">
      <span class="hx-band-tag">For operators</span>
      <h2>Get matched with agencies already quoting your destination.</h2>
      <p>
        Real, structured demand from agencies actively planning trips where you operate — not
        cold outreach.
      </p>
      <a class="btn" href="/signup">Join the network</a>
    </div>
  </section>
</Base>
