---
/**
 * Horizon — the supplier network. Never the software: agencies search it,
 * suppliers are listed on it for free and never log into it.
 *
 * The country figure stays "130+" to match the rest of the site's public
 * copy, even though the dataset holds 137. That discrepancy is unresolved —
 * see CLAUDE.md.
 */
import Base from '../layouts/Base.astro';
import ProductPage from '../components/ProductPage.astro';
import { byProduct, HORIZON_SUPPLIER_TYPES } from '../lib/content/products';
import WorldMap from '../components/WorldMap.astro';

const product = byProduct('horizon');
---

<Base
  title="Horizon"
  description="A vetted list of DMCs and suppliers across 130+ countries — search, quote, and book directly from your CRM, on every tier including free."
  currentNav="product"
>
  <ProductPage product={product}>
    <section slot="after-hero" class="mapband">
      <div class="wrap">
        <p class="eyebrow rv" style="color:rgba(255,255,255,.66)">Where the network reaches</p>
        <WorldMap />
      </div>
    </section>

    <div slot="after-features" class="sec-tight wrap">
      <p class="eyebrow rv">What's on the list</p>
      <h2 class="rv">Great wholesale B2B prices, across every type of supplier.</h2>
      <div class="tags rv" style="margin-top:24px">
        {HORIZON_SUPPLIER_TYPES.map((t) => <span class="tag-p">{t}</span>)}
      </div>

      <div style="margin-top:clamp(40px,5vw,72px)">
        <p class="eyebrow rv">How the fee works</p>
        <h2 class="rv">10%, locked. The supplier always gets their full quoted rate.</h2>
        <p class="lede rv">
          A markup on top of the quoted rate, absorbed by the agency or passed through to the
          traveler. Being listed costs a supplier nothing — Horizon is the agency's tool for finding
          them, not a product the supplier logs into.
        </p>
      </div>
    </div>
  </ProductPage>
</Base>
