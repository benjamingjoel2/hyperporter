---
/**
 * One page per solutions category. The tier pill on each feature is the
 * founder's wording verbatim — "Autopilot up" and "€19/mo add-on" say
 * something a tier name alone would not.
 */
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../lib/content/solutions';
import Mockup from '../../components/Mockup.astro';

// One screen per category: the part of OS where that category's features live.
const SCREEN: Record<string, string> = {
  inquiry: 'inquiry',
  operations: 'pipeline',
  branding: 'brand',
  communication: 'inbox',
  payments: 'payments',
  marketing: 'campaign',
};

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
---

<Base
  title={c.name}
  description={`${c.title} ${c.lede}`}
  currentNav="solutions"
>
  <div class="sec wrap page-hero">
    <div class="page-hero-copy">

      <p class="eyebrow rv">Solutions &mdash; {c.name}</p>
      <h1 class="rv">{c.title}</h1>
      <p class="lede rv">{c.lede}</p>
    </div>
    <Mockup screen={SCREEN[c.slug]} />
  </div>

  <div class="sec-tight wrap">
    <div class="flist rv">
      {
        c.features.map((f, i) => (
          <div class="fitem">
            <div class="fn">{String(i + 1).padStart(2, '0')}</div>
            <div>
              <b>{f.name}</b>
              <p>{f.body}</p>
              <span class="tierpill">{f.tier}</span>
            </div>
          </div>
        ))
      }
    </div>

    <div class="nextup rv">
      <div>
        <p class="eyebrow" style="margin-bottom:0">Up next</p>
        <h3>{c.next.title}</h3>
        <p>{c.next.desc}</p>
      </div>
      <a class="plink" href={c.next.href}>{c.next.cta} &rarr;</a>
    </div>
  </div>
</Base>
