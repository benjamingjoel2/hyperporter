---
/**
 * One page per solutions category. The tier pill on each feature is the
 * founder's wording verbatim — "Autopilot up" and "€19/mo add-on" say
 * something a tier name alone would not.
 */
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../lib/content/solutions';
import Mockup from '../../components/Mockup.astro';
import V2Hero from '../../components/V2Hero.astro';
import { photoFor } from '../../lib/photos';

// One screen per category: the part of Portal where that category's features live.
const SCREEN: Record<string, string> = {
  inquiry: 'inquiry',
  operations: 'pipeline',
  branding: 'brand',
  communication: 'inbox',
  payments: 'payments',
  marketing: 'campaign',
};

export function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { c } }));
}

const { c } = Astro.props;
---

<Base
  title={c.name}
  description={`${c.title} ${c.lede}`}
  currentNav="solutions"
  v2
>
  <V2Hero
    eyebrow={`Solutions — ${c.name}`}
    title={c.title}
    lede={c.lede}
    photo={photoFor(c.slug, 'solutions')}
  >
    <Fragment slot="aside"><Mockup screen={SCREEN[c.slug]} /></Fragment>
  </V2Hero>

  {/* Every feature in the category, each saying which tier it lands on —
      the tier is the point of this page, so it sits on the row. */}
  <section class="v-light v-band">
    <div class="v-wrap">
      <div class="v-lead">
        <span class="v-eyebrow">What's included</span>
        <h2 class="v-disp"><b>Every feature in {c.name.toLowerCase()},</b><i>and the tier it lands on</i></h2>
      </div>
      <div class="v-rows">
        {
          c.features.map((f, i) => (
            <div class="v-row">
              <span class="v-n mono">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{f.name}</h3>
                <p>{f.body}</p>
              </div>
              <span class="v-tier">{f.tier}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="v-bigcta" data-chrome="dark">
    <div class="v-wrap">
      <div>
        <span class="v-eyebrow">Up next</span>
        <h2>{c.next.title}</h2>
      </div>
      <a class="v-pill" href={c.next.href}>{c.next.cta} &rarr;</a>
    </div>
  </div>

</Base>
