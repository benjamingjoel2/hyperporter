---
/** Solutions index — six categories, ordered as a trip actually runs. */
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../lib/content/solutions';
import Mockup from '../../components/Mockup.astro';
import V2Hero from '../../components/V2Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { photoFor } from '../../lib/photos';
import '../../styles/v2.css';
---

<Base
  title="Solutions"
  description="Every feature grouped by what it actually does — six categories, from the first inquiry through getting paid, each showing which tier it's on."
  currentNav="solutions"
>
  <div class="v2">
    <V2Hero
      eyebrow="Solutions"
      title="Every feature, by what it actually does."
      lede="Six categories, from the first inquiry through getting paid. Each one lists exactly what's included and which tier it's on."
      photo={photoFor('solutions')}
    >
      <Fragment slot="aside"><Mockup screen="settings" /></Fragment>
    </V2Hero>

    <section class="v-light v-band">
      <div class="v-wrap">
        <div class="v-grid3" style="margin-top:0">
          {
            CATEGORIES.map((c, i) => (
              <a class="v-pcard" href={`/solutions/${c.slug}`}>
                <div class="v-cat">{String(i + 1).padStart(2, '0')}</div>
                <h3>{c.name}</h3>
                <p>{c.desc}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <CtaBand
    lead="Every category, on one platform."
    rest="Start free on Showcase and add the tiers as the work grows."
  />
</Base>
