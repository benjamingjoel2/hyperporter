---
/** Integrations index — the channels your travellers and suppliers already
    use, connected onto the trip thread. */
import Base from '../../layouts/Base.astro';
import Mockup from '../../components/Mockup.astro';
import V2Hero from '../../components/V2Hero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { photoFor } from '../../lib/photos';
import { INTEGRATIONS } from '../../lib/content/detail';
import '../../styles/v2.css';
---

<Base
  title="Integrations"
  description="WhatsApp Business and email connected onto the same trip thread, so a message about a trip lands on that trip rather than in a mailbox somebody has to remember to check."
  currentNav="integrations"
>
  <div class="v2">
    <V2Hero
      eyebrow="Integrations"
      title="The channels they already use."
      lede="WhatsApp Business and email, connected onto the same trip thread. Your travellers and your suppliers keep writing where they always did; you stop keeping the record in your head."
      photo={photoFor('whatsapp-integration')}
    >
      <Fragment slot="aside"><Mockup screen="whatsapp" /></Fragment>
    </V2Hero>

    <section class="v-light v-band">
      <div class="v-wrap">
        <div class="v-grid3" style="margin-top:0">
          {
            INTEGRATIONS.map((i) => (
              <a class="v-pcard" href={`/integrations/${i.slug}`}>
                <div class="v-cat">{i.tier === i.layer ? i.layer : `${i.layer} · ${i.tier}`}</div>
                <h3>{i.name}</h3>
                <p>{i.title}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  <CtaBand
    lead="Connect the channels once."
    rest="Every message about a trip lands on that trip from then on."
  />
</Base>
