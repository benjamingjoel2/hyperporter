---
/** One page per integration in the Integrations menu. Content: lib/content/detail.ts. */
import Base from '../../layouts/Base.astro';
import DetailPage from '../../components/DetailPage.astro';
import { INTEGRATIONS } from '../../lib/content/detail';
import type { DetailPage as Page } from '../../lib/content/detail';

export function getStaticPaths() {
  return INTEGRATIONS.map((i) => ({ params: { slug: i.slug }, props: { page: i } }));
}

const { page } = Astro.props as { page: Page };
// The first sentence of the lede is the meta description; the whole lede
// runs long for a search snippet.
const description = page.lede.split(/(?<=\.)\s/)[0];
---

<Base title={page.name} description={description} currentNav="integrations">
  <DetailPage page={page} kind="tool" />
</Base>
