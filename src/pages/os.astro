---
/** OS — the platform layer, free on every tier. */
import Base from '../layouts/Base.astro';
import ProductPage from '../components/ProductPage.astro';
import { byProduct } from '../lib/content/products';

const product = byProduct('os');
---

<Base
  title="OS"
  description="CRM, quote builder, itinerary tool — a clean, modern interface replacing spreadsheets and email threads. Free, forever, on every tier."
  currentNav="product"
>
  <ProductPage product={product} />
</Base>
