---
/** Payments & invoicing — the schedule on a trip, and the invoice the
    accepted proposal produced. */
import App from './App.astro';
---
<App
  active="Trips"
  title="Priya Nair"
  meta="MA-0937 · Marrakesh, 4 nights"
  who="LO"
  tabs={['Overview', 'Thread', 'Pricing', 'Documents']}
  tab="Pricing"
  note="Click the balance row when the money lands. Nothing marks itself paid."
>
  <button slot="bar" type="button" class="mk-uibtn o" data-live="set" data-done="Open" data-reveal=".js-invoice">Open invoice</button>
  <table class="mk-tbl">
    <colgroup><col style="width:26%" /><col style="width:14%" /><col style="width:16%" /><col style="width:18%" /><col style="width:26%" /></colgroup>
    <thead><tr><th>Item</th><th>Due</th><th>Amount</th><th>Method</th><th>Status</th></tr></thead>
    <tbody>
      <tr><td>Deposit · 20%</td><td>14 Jan</td><td class="num">€880</td><td>Transfer</td><td><span class="mk-st go">Received 14 Jan</span></td></tr>
      <tr data-live="tick" data-on="Received · marked by you" data-off="Due 20 Feb · reminder sent" data-off-amber="true">
        <td>Balance · 80%</td><td>20 Feb</td><td class="num">€3,520</td><td>Transfer</td>
        <td><span class="mk-st amb">Due 20 Feb · reminder sent</span></td>
      </tr>
      <tr><td>Supplier payout</td><td>24 Feb</td><td class="num">€3,650</td><td>Transfer</td><td><span class="mk-st">Scheduled</span></td></tr>
      <tr><td>Invoice INV-0937</td><td>14 Jan</td><td class="num">€4,400</td><td>Issued</td><td><span class="mk-st go">Sent</span></td></tr>
    </tbody>
  </table>
  <div class="mk-pane js-invoice" hidden style="margin-top:.55em">
    <h6>Invoice INV-0937 · from the accepted proposal</h6>
    <div class="ln"><span>Riad Yasmine · 4 nights · Atlas Maroc</span><span>€2,960</span></div>
    <div class="ln"><span>Transfers and the Atlas day trip</span><span>€1,440</span></div>
    <div class="ln"><span>Total, 2 travellers</span><span>€4,400</span></div>
  </div>
</App>
