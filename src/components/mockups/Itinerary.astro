---
/** Itinerary Generator — a draft from your Vault. Swap any line. */
const DAYS: [string, string, string, string, string, string, string][] = [
  ['Day 1', 'Nairobi · Hemingways', '€310 pp', 'Rift Valley 2026 · p.4', 'Nairobi · Giraffe Manor', '€540 pp', 'Rift Valley 2026 · p.6'],
  ['Day 2–5', 'Mara North · Offbeat Mara', '€410 pp', 'Offbeat contract · p.2', 'Mara North · Kicheche Mara', '€455 pp', 'Kicheche 2026 · p.1'],
  ['Day 6–8', 'Naboisho · walking safaris', '€385 pp', 'Rift Valley 2026 · p.7', 'Naboisho · Encounter Mara', '€395 pp', 'Rift Valley 2026 · p.8'],
];
---
<div class="mk-panel wide">
  <div class="mk-head"><b><svg class="mk-spark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 3c.6 5 4 8.4 9 9-5 .6-8.4 4-9 9-.6-5-4-8.4-9-9 5-.6 8.4-4 9-9z"/></svg>Draft · Kenya, 9 nights</b><small>From your Vault</small></div>
  {DAYS.map(([d, what, rate, cite, altWhat, altRate, altCite]) => (
    <div class="mk-row" data-alt-what={altWhat} data-alt-rate={altRate} data-alt-cite={altCite}><span class="mk-ico">{d.replace('Day ', '')}</span><div><b>{what}</b><small><span class="mk-cite"><i></i>{cite}</span></small></div><span class="r">{rate}</span><button type="button" class="mk-btn o" data-live="swap" data-label="Swap" data-back="Swap back">Swap</button></div>
  ))}
  <div class="mk-foot"><span class="mk-fine">Swap any line, then send.</span><button type="button" class="mk-btn" data-live="set" data-done="Sent" data-fine="On their link now.">Send as proposal</button></div>
</div>
