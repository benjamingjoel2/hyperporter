---
/** Itinerary generator — a first draft, day by day, each line priced from
    the account's own Vault and cited to the contract it came from. */
const DAYS: [string, string, string, string][] = [
  ['Day 1', 'Nairobi · Hemingways, 1 night', '€310 pp', 'Rift Valley GS 2026 · p.4'],
  ['Day 2–5', 'Mara North · Offbeat Mara, full board', '€410 pp', 'Offbeat contract · p.2'],
  ['Day 6–8', 'Naboisho · walking safaris', '€385 pp', 'Rift Valley GS 2026 · p.7'],
];
---
<div class="mk-panel wide">
  <div class="mk-head"><b><svg class="mk-spark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M12 3c.6 5 4 8.4 9 9-5 .6-8.4 4-9 9-.6-5-4-8.4-9-9 5-.6 8.4-4 9-9z"/></svg>Draft · Kenya, 9 nights</b><small>From your Vault</small></div>
  {DAYS.map(([d, what, rate, cite]) => (
    <div class="mk-row"><span class="mk-ico">{d.replace('Day ', '')}</span><div><b>{what}</b><small><span class="mk-cite"><i></i>{cite}</span></small></div><span class="r">{rate}</span></div>
  ))}
  <div class="mk-foot"><span class="mk-fine">Drafted at Planning. Edit, then send it as the proposal.</span><span class="mk-btn">Edit draft</span></div>
</div>
