---
/** Automated confirmation — every supplier asked again the moment the
    traveller accepts, and the one answer that has to go back to her. */
import App from './App.astro';
---
<App
  title="Lena & Mark Ortiz"
  meta="KE-2291 · Confirmation"
  who="LO"
  tabs={['Overview', 'Quotation board', 'Confirmation', 'Pricing']}
  tab="Confirmation"
  note="Re-verification is instant and automatic. Only a real exception reaches you."
>
  <span slot="bar" class="mk-pill">Accepted 10:12</span>
  <table class="mk-tbl">
    <colgroup><col style="width:30%" /><col style="width:24%" /><col style="width:14%" /><col style="width:32%" /></colgroup>
    <thead><tr><th>Supplier</th><th>Asked again</th><th>Answered</th><th>Status</th></tr></thead>
    <tbody>
      <tr><td><span class="who"><i>RV</i>Rift Valley Ground Services</span></td><td>10:12 · automatic</td><td>10:19</td><td><span class="mk-st go">Confirmed, same price</span></td></tr>
      <tr data-live="tick" data-on="Lena said yes · confirmed" data-off="Tent → suite · with the traveller" data-off-amber="true">
        <td><span class="who"><i>OM</i>Offbeat Mara camp</span></td><td>10:12 · automatic</td><td>10:31</td>
        <td><span class="mk-st amb">Tent → suite · with the traveller</span></td>
      </tr>
      <tr><td><span class="who"><i>MP</i>Mara Plains Collective</span></td><td>10:12 · automatic</td><td>10:22</td><td><span class="mk-st go">Confirmed, backup held</span></td></tr>
      <tr><td><span class="who"><i>KO</i>Karen Overland Co.</span></td><td>10:12 · automatic</td><td>10:40</td><td><span class="mk-st go">Confirmed, transfers</span></td></tr>
    </tbody>
  </table>
</App>
