---
/** The Autopilot hero: the Quotation stage of one trip, and the same trip
    with the automation switched off. The card’s switch picks a state; both
    are in the markup. */
import App from './App.astro';
---
<div class="v v-auto">
  <App
    title="Lena & Mark Ortiz"
    meta="KE-2291 · Quotation"
    who="LO"
    pills={['Autopilot on']}
    tabs={['Overview', 'Quotation board', 'Pricing', 'Autopilot']}
    tab="Quotation board"
    note="You choose. Nothing is booked until you do."
  >
    <table class="mk-tbl">
      <colgroup><col style="width:34%" /><col style="width:24%" /><col style="width:16%" /><col style="width:26%" /></colgroup>
      <thead><tr><th>Supplier</th><th>Asked</th><th>Cost pp</th><th>Status</th></tr></thead>
      <tbody>
        <tr><td><span class="who"><i>RV</i>Rift Valley Ground Services</span></td><td>09:02 · automatic</td><td class="num">€4,180</td><td><span class="mk-st go">Replied 09:41</span></td></tr>
        <tr><td><span class="who"><i>AS</i>Acacia Safari Logistics</span></td><td>09:02 · automatic</td><td class="num">—</td><td><span class="mk-st go">Reminded 12:00</span></td></tr>
        <tr><td><span class="who"><i>KO</i>Karen Overland Co.</span></td><td>09:02 · automatic</td><td class="num">—</td><td><span class="mk-st red">Declined · re-routed</span></td></tr>
        <tr><td><span class="who"><i>MP</i>Mara Plains Collective</span></td><td>09:44 · automatic</td><td class="num">€4,505</td><td><span class="mk-st go">Replied 11:20</span></td></tr>
      </tbody>
    </table>
  </App>
</div>
<div class="v v-manual">
  <App
    title="Lena & Mark Ortiz"
    meta="KE-2291 · Quotation"
    who="LO"
    pills={['Autopilot off']}
    tabs={['Overview', 'Quotation board', 'Pricing', 'Autopilot']}
    tab="Quotation board"
    note="Every line is yours."
  >
    <table class="mk-tbl">
      <colgroup><col style="width:34%" /><col style="width:24%" /><col style="width:16%" /><col style="width:26%" /></colgroup>
      <thead><tr><th>Supplier</th><th>Asked</th><th>Cost pp</th><th>Status</th></tr></thead>
      <tbody>
        <tr><td><span class="who"><i>RV</i>Rift Valley Ground Services</span></td><td>Tue · by you</td><td class="num">—</td><td><span class="mk-st amb">No reply · chase</span></td></tr>
        <tr><td><span class="who"><i>AS</i>Acacia Safari Logistics</span></td><td>Not yet</td><td class="num">—</td><td><span class="mk-st amb">Write the email</span></td></tr>
        <tr><td><span class="who"><i>KO</i>Karen Overland Co.</span></td><td>Mon · by you</td><td class="num">—</td><td><span class="mk-st amb">Declined · find another</span></td></tr>
        <tr><td><span class="who"><i>MP</i>Mara Plains Collective</span></td><td>Not yet</td><td class="num">—</td><td><span class="mk-st amb">Look up the address</span></td></tr>
      </tbody>
    </table>
  </App>
</div>
