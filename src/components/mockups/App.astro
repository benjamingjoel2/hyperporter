---
/**
 * The application around a screen: the left-hand navigation, the toolbar,
 * the tabs, and the body the screen fills.
 *
 * A floating card with three rows in it is not a CRM, however true its
 * words — the founder's note, Sep 2026. Every screen that is something you
 * are logged into is drawn inside this, so it has the chrome real software
 * has. The screens that are *not* — a magic link a traveller opens, the
 * inquiry form, the sign-in page — pass `page`, which drops the navigation
 * and puts the agency's own name where the navigation was, because the
 * person looking at it is not logged into anything.
 */
import { NAV } from './nav';

interface Props {
  /** The left-hand navigation. `false` for a page nobody signs into. */
  nav?: string[] | false;
  active?: string;
  brand?: string;
  /** A page rather than the application: brand bar, no rail. */
  page?: boolean;
  title: string;
  meta?: string;
  pills?: string[];
  who?: string;
  tabs?: string[];
  tab?: string;
  /** The line under the body, in the app's own voice. */
  note?: string;
  /** The body is a column with the composer pinned at its foot. */
  talk?: boolean;
  class?: string;
}

const {
  nav = NAV, active, brand = 'Hyperporter', page = false,
  title, meta, pills = [], who, tabs, tab, note, talk = false, class: klass = '',
} = Astro.props;
const rail = page ? false : nav;
---

<div class:list={['mk-ui', klass, { nonav: !rail, page }]}>
  {rail && (
    <div class="mk-rail2">
      <span class="brand"><i /><span>{brand}</span></span>
      {rail.map((n) => <a class:list={{ on: n === active }}><i />{n}</a>)}
    </div>
  )}
  <div class="mk-main">
    <div class="mk-bar">
      <b>{title}</b>
      {meta && <small>{meta}</small>}
      <span class="sp">
        {pills.map((p) => <span class="mk-pill">{p}</span>)}
        <slot name="bar" />
        {who && <span class="av">{who}</span>}
      </span>
    </div>
    {tabs && (
      <div class="mk-tabs">{tabs.map((t) => <span class:list={{ on: t === tab }}>{t}</span>)}</div>
    )}
    <div class:list={['mk-body', { talk }]}>
      <slot />
      {note && <p class="mk-fine" style="margin:.6em 0 0">{note}</p>}
    </div>
  </div>
</div>
