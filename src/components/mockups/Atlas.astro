---
/** Atlas — asked on the trip it belongs to, answering from this account's
    own Vault and citing the page. The composer is live. */
import App from './App.astro';

const REPLIES = [
  'Offbeat Mara: USD 410 pp per night, full board, March. Source: Offbeat 2026.pdf · p.2.',
  'Andes Trail: USD 385 pp, two-day walk, valid to Dec 2026. Source: Sacred Valley tariff.xlsx.',
  'Nothing on that in your Vault yet. Upload the contract and I’ll read it.',
];
---
<App
  active="Trips"
  title="Lena & Mark Ortiz"
  meta="KE-2291 · Nairobi, 9 nights"
  who="LO"
  tabs={['Overview', 'Thread', 'Quotation board', 'Atlas']}
  tab="Atlas"
  talk
>
  <span slot="bar" class="mk-pill">Vault · 61 documents</span>
  <div class="mk-chat" data-thread>
    <div class="mk-msg me"><span class="mk-via">You</span><p>Rift Valley, Mara North game drives, March — is the park fee included?</p></div>
    <div class="mk-msg">
      <span class="mk-via">Atlas</span>
      <p>No. USD 95 pp per day through 31 March covers the drive. Park fees are USD 116 per adult per night, billed separately.</p>
      <span class="mk-cite"><i />Rift Valley GS — rates 2026.pdf · p.2, p.5</span>
      <span class="mk-fine">From this account’s Vault only. Nothing else was read.</span>
    </div>
    <form class="mk-composer" data-live="chat" data-replies={JSON.stringify(REPLIES)} data-reply-via="Atlas" data-me-via="You">
      <input type="text" placeholder="Ask about your contracts…" aria-label="Ask Atlas" autocomplete="off" />
      <button type="submit" class="mk-btn sig">Ask</button>
    </form>
  </div>
</App>
