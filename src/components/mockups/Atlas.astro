---
/** Atlas — ask about your own contracts; it answers from the Vault with a
    citation. The composer is live. */
const REPLIES = [
  'Offbeat Mara: USD 410 pp/night, full board, March. Source: Offbeat 2026.pdf · p.2.',
  'Andes Trail: USD 385 pp, two-day walk, valid to Dec 2026. Source: Sacred Valley tariff.xlsx.',
  'Not in your Vault yet. Upload the contract and I’ll read it.',
];
---
<div class="mk-panel wide" data-thread>
  <div class="mk-msg me"><p>Rift Valley, Mara North game drives, March — park fee included?</p></div>
  <svg class="mk-spark" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2c.6 5.4 4.6 9.4 10 10-5.4.6-9.4 4.6-10 10-.6-5.4-4.6-9.4-10-10 5.4-.6 9.4-4.6 10-10z"/></svg>
  <div class="mk-msg"><p><b>USD 95</b> pp per day through 31 March. Park fees <b>not</b> included: USD 116 per adult per night.</p>
    <span class="mk-cite"><i></i>Rift Valley GS — rates 2026.pdf · p.2, p.5</span>
    <span class="mk-fine">From your Vault only</span></div>
  <div class="mk-foot"><button type="button" class="mk-btn o" data-live="set" data-done="Copied">Copy</button><button type="button" class="mk-btn" data-live="set" data-done="Added">Add to quote</button></div>
  <form class="mk-composer" data-live="chat" data-replies={JSON.stringify(REPLIES)} data-reply-via="Atlas" data-me-via="You">
    <input type="text" placeholder="Ask about your contracts…" aria-label="Ask Atlas" autocomplete="off" />
    <button type="submit" class="mk-btn sig">Ask</button>
  </form>
</div>
