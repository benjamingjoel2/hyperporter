---
/** Settings ▸ Channels — what an account has connected, where each channel
    lands, and the tier it comes with. The wording follows content/pricing.ts:
    WhatsApp is the paid add-on, email comes from Autopilot up, and the links
    need nothing connecting at all. */
import App from './App.astro';

const CH: [string, string, string, string, string][] = [
  ['WhatsApp Business', '+254 ··· 8810', '€19/mo add-on', 'go', 'Connected'],
  ['Email', 'hello@meridiantravel.co', 'Autopilot up', 'go', 'Connected'],
  ['Inquiry form', 'meridiantravel.co/enquire', 'Showcase', 'go', 'Live'],
  ['Traveller links', 'Nothing to connect', 'Showcase', 'go', 'Always on'],
];
---
<App
  title="Channels"
  meta="Meridian Travel Co."
  who="LO"
  tabs={['Account', 'Team', 'Branding', 'Channels', 'Billing']}
  tab="Channels"
  note="Everything connected lands on the trip thread. They keep the channel they use."
>
  <button slot="bar" type="button" class="mk-uibtn" data-live="set" data-done="Connected">Connect a channel</button>
  <table class="mk-tbl">
    <colgroup><col style="width:27%" /><col style="width:31%" /><col style="width:22%" /><col style="width:20%" /></colgroup>
    <thead><tr><th>Channel</th><th>Connected as</th><th>Comes with</th><th>Status</th></tr></thead>
    <tbody>
      {CH.map(([n, as, tier, tone, st]) => (
        <tr><td>{n}</td><td>{as}</td><td>{tier}</td><td><span class:list={['mk-st', tone]}>{st}</span></td></tr>
      ))}
    </tbody>
  </table>
</App>
