---
/** The proposal as the traveller opens it, from a link with no login: the
    agency's brand, the trip day by day, and one price — the selling price.
    Never the cost, never the margin, and no navigation, because they are
    not signed into anything. */
import App from './App.astro';
---
<App
  page
  title="Meridian Travel Co."
  meta="The Mara in March · v3"
  note="Comment on any day, or accept. No login, no app to install."
>
  <span slot="bar" class="mk-pill">For Lena &amp; Mark</span>
  <table class="mk-tbl">
    <colgroup><col style="width:12%" /><col style="width:22%" /><col style="width:44%" /><col style="width:22%" /></colgroup>
    <thead><tr><th>Day</th><th>Where</th><th>What you do</th><th>Staying</th></tr></thead>
    <tbody>
      <tr><td class="num">1</td><td>Nairobi</td><td>Arrival, private transfer, quiet first night</td><td>Hemingways</td></tr>
      <tr><td class="num">2 – 5</td><td>Mara North</td><td>Shared game drives, full board, sundowners</td><td>Offbeat Mara</td></tr>
      <tr><td class="num">6 – 8</td><td>Naboisho</td><td>Walking safaris with a Maasai guide</td><td>Encounter Mara</td></tr>
      <tr><td class="num">9</td><td>Nairobi</td><td>Return transfer, day room before the flight</td><td>Hemingways</td></tr>
    </tbody>
  </table>
  <div class="mk-two" style="margin-top:.55em">
    <div class="mk-pane">
      <h6>What it costs</h6>
      <div class="ln"><span>Per person, all of the above</span><span>€4,932</span></div>
      <div class="ln"><span>Two travellers</span><span>€9,864</span></div>
      <div class="ln"><span>Deposit to hold it</span><span>€1,480</span></div>
    </div>
    <div class="mk-pane">
      <h6>Your agent</h6>
      <div class="ln"><span>Lena Ortiz · Meridian Travel Co.</span><span>Replies same day</span></div>
      <div class="ln"><span>Version 3 · updated Tuesday</span><span>Always current</span></div>
      <div class="ln"><span>Questions go straight to her</span><span>On this page</span></div>
    </div>
  </div>
  <div class="mk-foot">
    <span class="mk-fine">Prices hold until 28 February.</span>
    <button type="button" class="mk-uibtn sig" data-live="set" data-done="Accepted">Accept this plan</button>
  </div>
</App>
