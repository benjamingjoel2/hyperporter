    <thead><tr><th>What</th><th>From</th><th>Due</th><th>Asked</th><th>Status</th></tr></thead>
    <tbody>
      <tr><td>Passport details · 2</td><td>Lena &amp; Mark Ortiz</td><td>20 Feb</td><td>3 times</td><td><span class="mk-st go">In</span></td></tr>
      <tr><td>Vouchers · game drives</td><td>Rift Valley GS</td><td>20 Feb</td><td>Once</td><td><span class="mk-st go">In</span></td></tr>
      <tr><td>Vouchers · lodging</td><td>Mara North Collective</td><td>20 Feb</td><td>Twice</td><td><span class="mk-st go">In</span></td></tr>
