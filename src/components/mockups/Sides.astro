---
/** Client & Supplier Dashboard — one record, two links, two cards. */
---
<div class="mk-panel wide">
  <div class="mk-head"><b>Nairobi — 9 nights</b><small>One record, two sides</small></div>
  <div class="mk-row2">
    <div class="mk-side">
      <span class="mk-lbl">Traveller</span>
      <div class="mk-row plain" data-live="tick" data-on="Accepted" data-off="Sent" data-off-amber="false"><div><b>Itinerary v3</b><small>9 nights</small></div><span class="mk-chk"></span></div>
      <div class="mk-row plain"><div><b>Total</b><small>2 travellers</small></div><span class="r">€4,932</span></div>
      <div class="mk-row plain" data-live="tick" data-on="Paid" data-off="Due 12 Jan" data-off-amber="true"><div><b>Deposit</b><small>On the link</small></div><span class="mk-end"><span class="mk-tag amb">Due 12 Jan</span><span class="mk-chk wait"></span></span></div>
    </div>
    <div class="mk-side">
      <span class="mk-lbl">Supplier</span>
      <div class="mk-row plain"><div><b>Request</b><small>3 – 12 March · 2 pax</small></div><span class="mk-chk"></span></div>
      <div class="mk-row plain"><div><b>Your quote</b><small>Paid in full</small></div><span class="r">€4,180</span></div>
      <div class="mk-row plain" data-live="tick" data-on="Confirmed" data-off="Re-check sent" data-off-amber="false"><div><b>Confirmation</b><small>Re-check sent</small></div><span class="mk-chk wait"></span></div>
    </div>
  </div>
  <span class="mk-fine">Click a line to mark it. No login either side.</span>
</div>
