---
/** One record, two links — what the traveller opens and what the supplier
    opens, side by side, from the same trip. Neither sees the other’s
    number. */
import App from './App.astro';
---
<App
  title="Lena & Mark Ortiz"
  meta="KE-2291 · one record, two links"
  who="LO"
  tabs={['Overview', 'Links', 'Quotation board', 'Pricing']}
  tab="Links"
  note="Both are rendered from this record the moment they are opened."
>
  <div class="mk-two">
    <div class="mk-pane">
      <h6>The traveller opens</h6>
      <div class="ln"><span>Itinerary v3 · 9 nights</span><span>Live</span></div>
      <div class="ln"><span>Price per person</span><span>€4,932</span></div>
      <div class="ln"><span>Deposit due 12 Jan</span><span>€1,480</span></div>
      <div class="ln"><span>Branding</span><span>Meridian Travel Co.</span></div>
      <div class="ln"><span>Your cost, your margin</span><span>Never shown</span></div>
    </div>
    <div class="mk-pane">
      <h6>The supplier opens</h6>
      <div class="ln"><span>Request · 3 – 12 March, 2 pax</span><span>Sent</span></div>
      <div class="ln"><span>Their quoted rate</span><span>€4,180</span></div>
      <div class="ln"><span>They receive</span><span>In full</span></div>
      <div class="ln"><span>Re-confirmation</span><span>Answered 10:19</span></div>
      <div class="ln"><span>What you sell at</span><span>Never shown</span></div>
    </div>
  </div>
  <table class="mk-tbl" style="margin-top:.55em">
    <colgroup><col style="width:24%" /><col style="width:44%" /><col style="width:32%" /></colgroup>
    <thead><tr><th>Change</th><th>What happened</th><th>Both sides</th></tr></thead>
    <tbody>
      <tr><td>Rate revised</td><td>Rift Valley GS · €4,180 → €4,240</td><td><span class="mk-st go">Traveller sees €5,003</span></td></tr>
      <tr><td>No resend</td><td>Same two links, new numbers</td><td><span class="mk-st go">Already current</span></td></tr>
      <tr><td>Deposit</td><td>Instructions on her link</td><td><span class="mk-st amb">You mark it received</span></td></tr>
    </tbody>
  </table>
</App>
