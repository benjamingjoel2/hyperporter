---
/** Marketing — one send, and where the replies go. */
---
<div class="mk-panel">
  <div class="mk-head"><b>March in the Mara — four places left</b><small>Sent 2 Feb</small></div>
  <div class="mk-kpis">
    <div class="mk-kpi"><span>Recipients</span><b>1,184</b></div>
    <div class="mk-kpi"><span>Opened</span><b>61%<em>+9</em></b></div>
  </div>
  <div class="mk-bars">{[38,44,41,52,47,55,49,61,44,48,58,61].map((h, i) => <i style={`height:${h}%`} class:list={{ hi: i === 11 }}></i>)}</div>
  <div class="mk-row plain"><div><b>9 replies</b><small>Each one lands in its own trip thread</small></div><span class="mk-btn o">Open</span></div>
</div>
