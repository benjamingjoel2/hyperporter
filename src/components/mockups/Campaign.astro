---
/** Marketing — one send, and the replies landing back on their own trips
    instead of in a separate marketing inbox. */
import App from './App.astro';

---
<App
  title="March in the Mara — four places left"
  meta="Sent 2 Feb · 09:00"
  who="LO"
  tabs={['Overview', 'Recipients', 'Replies', 'Settings']}
  tab="Overview"
  note="Every reply opens or reopens a trip. Nothing lands in a separate inbox."
>
  <div class="mk-metrics">
    <div class="mk-metric"><span>Recipients</span><b>1,184</b></div>
    <div class="mk-metric"><span>Opened</span><b>61%<em>+9</em></b></div>
    <div class="mk-metric"><span>Replies</span><b>9</b></div>
    <div class="mk-metric"><span>New trips</span><b>4</b></div>
  </div>
  <table class="mk-tbl">
    <colgroup><col style="width:24%" /><col style="width:42%" /><col style="width:18%" /><col style="width:16%" /></colgroup>
    <thead><tr><th>Replied</th><th>What they said</th><th>Landed on</th><th>State</th></tr></thead>
    <tbody>
      <tr><td><span class="who"><i>MS</i>Mira Sato</span></td><td>“Are the March dates still open?”</td><td>JP-0442</td><td><span class="mk-st go">Open trip</span></td></tr>
      <tr><td><span class="who"><i>RF</i>R. Fontaine</span></td><td>“Send me the details for two.”</td><td>New · KE-2304</td><td><span class="mk-st go">New trip</span></td></tr>
      <tr><td><span class="who"><i>HO</i>H. Okonkwo</span></td><td>“Not this year, keep me on the list.”</td><td>Contact only</td><td><span class="mk-st">Noted</span></td></tr>
    </tbody>
  </table>
</App>
