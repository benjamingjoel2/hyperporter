---
/** The supplier's side of a request: what the agency actually asked for,
    structured, with a deadline and one button. */
import App from './App.astro';
---
<App
  brand="Rift Valley"
  title="Mara North — 4 nights"
  meta="Meridian Travel Co. · RQ-1184"
  who="PK"
  tabs={['The request', 'Your quote', 'Messages']}
  tab="The request"
  note="Reply here, by email or on WhatsApp — wherever you already work."
>
  <button slot="bar" type="button" class="mk-uibtn sig" data-live="set" data-done="Quoting">Quote</button>
  <div class="mk-two">
    <div class="mk-pane">
      <h6>What they asked for</h6>
      <div class="ln"><span>Travellers</span><span>2 adults</span></div>
      <div class="ln"><span>Dates</span><span>3 – 7 March</span></div>
      <div class="ln"><span>Board</span><span>Full board</span></div>
      <div class="ln"><span>Drives</span><span>Shared, one camp</span></div>
    </div>
    <div class="mk-pane">
      <h6>Terms</h6>
      <div class="ln"><span>Quote by</span><span>Thu 6 Feb</span></div>
      <div class="ln"><span>You receive</span><span>Your full quoted rate</span></div>
      <div class="ln"><span>Agency margin</span><span>Not shown to you</span></div>
      <div class="ln"><span>Cancellation</span><span>Your own terms</span></div>
    </div>
  </div>
  <table class="mk-tbl" style="margin-top:.55em">
    <colgroup><col style="width:22%" /><col style="width:48%" /><col style="width:30%" /></colgroup>
    <thead><tr><th>When</th><th>Activity</th><th>By</th></tr></thead>
    <tbody>
      <tr><td>09:02</td><td>Request arrived, structured</td><td>Meridian Travel Co.</td></tr>
      <tr><td>09:05</td><td>Opened on your phone</td><td>Peter Kimani</td></tr>
      <tr><td>Thu</td><td>Reminder if no quote yet</td><td>Automatic</td></tr>
    </tbody>
  </table>
</App>
