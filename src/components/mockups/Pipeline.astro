---
/** Autopilot on one trip — the nine stages as the trip record's own tab,
    with what each one did, when, and which of them a person has to do.
    Names and the Automatic / Human split come from lib/stages so the screen
    cannot drift from the copy. */
import App from './App.astro';
import { STAGES } from '../../lib/stages';

/** What each stage did on this trip, and when. */
const DID: [string, string][] = [
  ['Brief built, confirmed with Lena', 'Mon 09:02'],
  ['Itinerary v2 proposed and live', 'Mon 14:20'],
  ['3 asked · 2 replied · 18% margin', 'Tue 09:41'],
  ['Re-verifying with Rift Valley', 'now'],
  ['Deposit €1,480 · you mark it', '—'],
  ['Vouchers and pickup details chased', '—'],
  ['Relayed; urgent flags reach you', '—'],
  ['Feedback collected, thread open', '—'],
  ['Archived for the next inquiry', '—'],
];
const CURRENT = 4;
---
<App
  title="Lena & Mark Ortiz"
  meta="KE-2291 · Nairobi, 9 nights"
  who="LO"
>
  <span slot="bar" class="mk-pill">3 of 9 done</span>
  <table class="mk-tbl tight">
    <colgroup><col style="width:19%" /><col style="width:43%" /><col style="width:15%" /><col style="width:23%" /></colgroup>
    <thead><tr><th>Stage</th><th>What it did</th><th>When</th><th>Runs</th></tr></thead>
    <tbody>
      {STAGES.map((s, i) => {
        const n = i + 1;
        const human = s.cls !== 'Automatic';
        const done = n < CURRENT;
        const now = n === CURRENT;
        return (
          <tr>
            <td>{s.name}</td>
            <td>{DID[i][0]}</td>
            <td>{DID[i][1]}</td>
            <td>
              {human
                ? <span class="mk-st amb">Needs a person</span>
                : done
                  ? <span class="mk-st go">Done</span>
                  : now
                    ? <span class="mk-st go">Running</span>
                    : <span class="mk-st">Scheduled</span>}
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</App>
