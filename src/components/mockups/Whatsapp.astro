---
/** WhatsApp Integration — a Business number on the thread. */
const REPLIES = ['Early March works. Two adults, mid-range.', 'Flexible by a day either side.', 'Thank you! Can’t wait.'];
---
<div class="mk-panel wide" data-thread>
  <div class="mk-head"><b><span class="mk-dot"></span>WhatsApp Business</b><small>Connected</small></div>
  <div class="mk-msg"><span class="mk-via">Lena · WhatsApp</span><p>Hi! Two of us, Kenya in March, 9 nights. Mara for sure.</p></div>
  <div class="mk-row"><span class="mk-chk"></span><div><b>New contact, new inquiry</b><small>Lena Ortiz · KE-2291</small></div></div>
  <div class="mk-msg me"><span class="mk-via">You</span><p>Happy to. First plan today.</p></div>
  <form class="mk-composer" data-live="chat" data-replies={JSON.stringify(REPLIES)} data-reply-via="Lena · WhatsApp" data-me-via="You">
    <input type="text" placeholder="Reply…" aria-label="Reply" autocomplete="off" />
    <button type="submit" class="mk-btn sig">Send</button>
  </form>
</div>
