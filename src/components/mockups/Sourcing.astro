---
/** Quotation Board — replies, your margin, your choice. */
---
<div class="mk-panel wide">
  <div class="mk-head"><b>Supplier quotes</b><small>Nairobi · per person</small></div>
  <div class="mk-row" data-live="tick" data-on="Chosen" data-off="Not chosen" data-off-amber="false"><span class="mk-chk"></span><div><b>Rift Valley Ground Services</b><small>Replied in 40 min</small></div><span class="r">€4,180</span></div>
  <div class="mk-row" data-live="tick" data-on="Chosen" data-off="Not chosen" data-off-amber="false"><span class="mk-chk wait"></span><div><b>Acacia Safari Logistics</b><small>Replied in 2 h</small></div><span class="r">€4,505</span></div>
  <div class="mk-sum" data-margin data-pct="18" data-base="4180"><span class="mk-p">Your <span class="mk-stepper"><button type="button" data-live="margin" data-step="-1" aria-label="Lower the margin">−</button><b data-margin-out>18%</b><button type="button" data-live="margin" data-step="1" aria-label="Raise the margin">+</button></span> margin</span><b data-margin-sum>€4,932</b></div>
  <div class="mk-foot"><span class="mk-fine">Tick, set your margin, approve.</span><button type="button" class="mk-btn sig" data-live="set" data-done="Approved" data-fine="Sent to Lena &amp; Mark.">Approve</button></div>
</div>
