---
/**
 * The OS sidebar. `kind` picks the workspace: an agency's, with Horizon and
 * Atlas in the nav, or a supplier's, which has neither — suppliers are the
 * ones being sourced, and Horizon is not something they log into.
 */
interface Props {
  active: string;
  kind?: 'agency' | 'supplier';
  workspace?: string;
  who?: string;
  initials?: string;
}
const {
  active,
  kind = 'agency',
  workspace = kind === 'agency' ? 'Meridian Travel Co.' : 'Rift Valley Ground Services',
  who = kind === 'agency' ? 'Lena Ortiz' : 'Samuel Kariuki',
  initials = who.split(' ').map((w) => w[0]).join(''),
} = Astro.props;

const AGENCY: [string, string?][] = [
  ['Trips', '6'],
  ['Inquiries', '3'],
  ['Proposals'],
  ['Suppliers'],
  ['Payments', '1'],
  ['Atlas'],
  ['Settings'],
];
const SUPPLIER: [string, string?][] = [
  ['Requests', '2'],
  ['Quotes'],
  ['Bookings'],
  ['Payments'],
  ['Rates'],
  ['Settings'],
];
const items = kind === 'agency' ? AGENCY : SUPPLIER;
---

<aside class="mk-side">
  <div class="mk-brand">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <circle class="ring" cx="50" cy="50" r="44" />
      <rect x="32.5" y="26" width="7.5" height="47" />
      <rect x="60" y="26" width="7.5" height="47" />
      <rect x="32.5" y="46.5" width="35" height="7.5" />
    </svg>
    <div><span>OS</span><small>{workspace}</small></div>
  </div>
  <div class="mk-nav">
    {items.map(([n, c]) => (
      <span class:list={{ on: n === active }}>{n}{c && <i>{c}</i>}</span>
    ))}
  </div>
  <div class="mk-user"><span class="mk-av">{initials}</span>{who}</div>
</aside>
