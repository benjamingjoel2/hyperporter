---
/** Settings ▸ Branding — what the traveller sees carries the agency's name.
    The tier each switch needs is on the row, so nothing here overstates
    what a free account gets. */
import App from './App.astro';
---
<App
  title="Branding"
  meta="Meridian Travel Co."
  who="LO"
  tabs={['Account', 'Team', 'Branding', 'Channels', 'Billing']}
  tab="Branding"
  note="Applies to proposals, links, emails and the inquiry form at once."
>
  <button slot="bar" type="button" class="mk-uibtn" data-live="set" data-done="Saved">Save</button>
  <div class="mk-form">
    <div class="f"><label>Logo</label><div class="val">meridian-mark.svg<span class="mk-sub">240 × 60</span></div></div>
    <div class="f"><label>Reply-to address</label><div class="val focus" contenteditable="true" spellcheck="false">hello@meridiantravel.co</div></div>
  </div>
  <table class="mk-tbl" style="margin-top:.55em">
    <colgroup><col style="width:44%" /><col style="width:32%" /><col style="width:24%" /></colgroup>
    <thead><tr><th>Setting</th><th>Comes with</th><th>State</th></tr></thead>
    <tbody>
      <tr><td>Remove the Hyperporter badge</td><td>Autopilot up</td><td><span class="mk-st go">On</span></td></tr>
      <tr><td>Domain masking on your links</td><td>€19/mo add-on</td><td><span class="mk-st go">On</span></td></tr>
      <tr><td>Your own domain on the links</td><td>Intelligence</td><td><span class="mk-st">Off</span></td></tr>
    </tbody>
  </table>
</App>
