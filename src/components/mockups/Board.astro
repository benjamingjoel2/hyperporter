---
/** CRM Workflow — the board. Click a card to move it on. */
const COLS: [string, [string, string][]][] = [
  ['Quotation', [['Nairobi · 9 nights', '2 quotes in'], ['Tbilisi · 7 nights', 'Waiting on 1']]],
  ['Confirmation', [['Cusco · 6 nights', 'Re-checking']]],
  ['Booking', [['Marrakesh · 4 nights', 'Deposit requested'], ['Hanoi · 11 nights', 'Balance due 20 Feb']]],
];
---
<div class="mk-panel wide">
  <div class="mk-head"><b>Trips</b><small>7 open</small></div>
  <div class="mk-cols">
    {COLS.map(([name, cards]) => (
      <div class="mk-col">
        <small>{name}</small>
        {cards.map(([t, s]) => (
          <div class="mk-card" data-live="move" data-moved="Moved just now"><b>{t}</b><small>{s}</small></div>
        ))}
      </div>
    ))}
  </div>
  <span class="mk-fine">Click a card to move it on.</span>
</div>
