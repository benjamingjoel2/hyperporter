---
import Side from './Side.astro';
import Top from './Top.astro';
const SUPPLIERS = [
  ['Rift Valley Ground Services', 'Nairobi · DMC', 'Mara North · Laikipia · Amboseli', '40 min', 'RV'],
  ['Acacia Safari Logistics', 'Nairobi · DMC', 'Mara · Tsavo · coast', '2 h', 'AS'],
  ['Karen Overland Co.', 'Karen · Tour operator', 'Overland · camping · self-drive support', '1 day', 'KO'],
  ['Lamu Dhow Collective', 'Lamu · Tour operator', 'Coast · dhow · small-group', '3 h', 'LD'],
];
---
<Side active="Suppliers" />
<div class="mk-main">
  <Top title="Horizon" sub="Vetted suppliers, 130+ countries"><span class="mk-search" style="min-width:16em"><i></i><span style="color:var(--paper)">Kenya</span></span></Top>
  <div class="mk-body tight">
    <div class="mk-tabs"><span class="on">Kenya <i>12</i></span><span>DMCs <i>7</i></span><span>Tour operators <i>5</i></span><span>Quoted before <i>3</i></span></div>
    <div class="mk-list">
      {SUPPLIERS.map(([n, w, spec, turn, ini], i) => (
        <div class="mk-item" style="grid-template-columns:auto minmax(0,1fr) auto auto;padding-block:.9em">
          <span class="mk-av ghost">{ini}</span>
          <div><b>{n}</b><small>{w} · {spec}</small></div>
          <span class="mk-fine">Typically replies in {turn}</span>
          <span class:list={['mk-btn', { o: i !== 0 }]}>{i === 0 ? 'Quote requested' : 'Request quote'}</span>
        </div>
      ))}
    </div>
    <p class="mk-fine">Every supplier here is vetted. Horizon adds 10% on top of the quote; the supplier receives their full quoted rate.</p>
  </div>
</div>
