---
/** Automated follow-up — the messages that go out on their own, and the one
    reply that stops the sequence because it is a change. */
import App from './App.astro';
---
<App
  active="Reports"
  title="Follow-ups"
  meta="3 scheduled this week"
  who="LO"
  tabs={['Scheduled', 'Sent', 'Stopped', 'Rules']}
  tab="Scheduled"
  note="A reply stops the sequence. Nothing keeps nudging somebody who answered."
>
  <table class="mk-tbl">
    <colgroup><col style="width:26%" /><col style="width:26%" /><col style="width:16%" /><col style="width:16%" /><col style="width:16%" /></colgroup>
    <thead><tr><th>Follow-up</th><th>Trip</th><th>Sends</th><th>Status</th><th /></tr></thead>
    <tbody>
      <tr>
        <td>Proposal nudge</td><td>KE-2291 · Lena &amp; Mark</td><td>Tomorrow 09:00</td>
        <td><span class="mk-st">Scheduled</span></td>
        <td><button type="button" class="mk-uibtn o" data-live="set" data-done="Sent" data-tag="Sent">Send now</button></td>
      </tr>
      <tr>
        <td>Voucher reminder</td><td>MA-0937 · Atlas Maroc</td><td>Sent 08:00</td>
        <td><span class="mk-st go">Voucher in</span></td><td />
      </tr>
      <tr>
        <td>Feedback request</td><td>JP-0338 · Sofia Brandt</td><td>Friday 10:00</td>
        <td><span class="mk-st">Scheduled</span></td>
        <td><button type="button" class="mk-uibtn o" data-live="set" data-done="Sent" data-tag="Sent">Send now</button></td>
      </tr>
      <tr>
        <td>Deposit reminder</td><td>PE-1180 · T. Achebe</td><td>Stopped</td>
        <td><span class="mk-st amb">“Could we push it a week?”</span></td>
        <td><button type="button" class="mk-uibtn amb" data-live="set" data-done="Yours" data-tag="With you">Answer</button></td>
      </tr>
    </tbody>
  </table>
</App>
