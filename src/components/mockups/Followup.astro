---
/** Automated Follow-up — the messages you would have sent. */
const REPLIES = ['A week later is perfect. Thank you!'];
---
<div class="mk-panel wide" data-thread>
  <div class="mk-head"><b>Follow-ups</b><small>3 this week</small></div>
  <div class="mk-row"><span class="mk-chk now"></span><div><b>Proposal nudge · Lena &amp; Mark</b><small>Sends tomorrow 09:00</small></div><button type="button" class="mk-btn o" data-live="set" data-done="Sent" data-small="Sent just now">Send now</button></div>
  <div class="mk-row"><span class="mk-chk"></span><div><b>Voucher reminder · Atlas Maroc</b><small>Sent · voucher in</small></div><span class="mk-tag">Done</span></div>
  <div class="mk-row"><span class="mk-chk now"></span><div><b>Feedback request · Sofia</b><small>Sends Friday</small></div><button type="button" class="mk-btn o" data-live="set" data-done="Sent" data-small="Sent just now">Send now</button></div>
  <div class="mk-row plain" style="border-top:1px solid var(--line);border-bottom:0;padding-top:.8em"><div><b>"Could we push it a week?"</b><small>A change · yours</small></div><button type="button" class="mk-btn amb" data-live="set" data-done="Yours" data-reveal=".js-reply" data-small="Reply below">Reply</button></div>
  <form class="mk-composer js-reply" hidden data-live="chat" data-replies={JSON.stringify(REPLIES)} data-reply-via="Lena" data-me-via="You">
    <input type="text" placeholder="Answer Lena…" aria-label="Reply to Lena" autocomplete="off" />
    <button type="submit" class="mk-btn sig">Send</button>
  </form>
</div>
