---
/** Portal — the trips list, which is where an agency actually lives. */
import App from './App.astro';

const T: [string, string, string, string, string, string][] = [
  ['Lena & Mark Ortiz', 'LO', 'Kenya · 3–12 Mar', 'go|Quotation', '€9,864', '2 h ago'],
  ['Priya Nair', 'PN', 'Marrakesh · 4 nights', 'amb|Booking', '€4,400', '4 h ago'],
  ['The Achebe family', 'TA', 'Peru · June', '|Planning', '€12,300', 'Yesterday'],
  ['Mira Sato', 'MS', 'Japan · October', '|Inquiry', '—', 'Yesterday'],
  ['P. Nair', 'PN', 'Vietnam · January', 'amb|Confirmation', '€7,050', 'Tue'],
  ['D. Mwangi', 'DM', 'Tanzania · Sept', 'go|Ready', '€5,940', 'Tue'],
  ['J. Mendes', 'JM', 'Chile · November', 'go|Quotation', '€7,410', 'Mon'],
  ['A. Silva', 'AS', 'Portugal · May', 'go|Ready', '€3,280', 'Mon'],
];
---
<App
  active="Trips"
  title="Trips"
  meta="14 open"
  who="LO"
  pills={['All agents', 'This quarter']}
  note="One record per trip, and every agent works the same one."
>
  <button slot="bar" type="button" class="mk-uibtn" data-live="set" data-done="Opened">New trip</button>
  <table class="mk-tbl">
    <colgroup><col style="width:27%" /><col style="width:25%" /><col style="width:19%" /><col style="width:15%" /><col style="width:14%" /></colgroup>
    <thead><tr><th>Traveller</th><th>Trip</th><th>Stage</th><th>Value</th><th>Updated</th></tr></thead>
    <tbody>
      {T.map(([who, ini, trip, stage, val, upd]) => {
        const [tone, name] = stage.split('|');
        return (
          <tr>
            <td><span class="who"><i>{ini}</i>{who}</span></td>
            <td>{trip}</td>
            <td><span class:list={['mk-st', tone]}>{name}</span></td>
            <td class="num">{val}</td>
            <td>{upd}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</App>
