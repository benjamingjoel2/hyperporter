---
/** The by-hand side of a screen: how the same job is handled
    traditionally, as plain text (lib/content/without.ts). */
import { WITHOUT } from '../../lib/content/without';

interface Props { screen: string }
const { screen } = Astro.props;
const text = WITHOUT[screen];
if (!text) throw new Error(`Without: no text for screen "${screen}". Add one to lib/content/without.ts.`);
---
<div class="mk-without">
  <span class="mk-lbl">Traditionally</span>
  <p>{text}</p>
</div>
