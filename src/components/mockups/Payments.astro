---
/** Automated payment — the request goes out on its own; the money is marked
    by a person, on every tier below Intelligence. */
import App from './App.astro';
---
<App
  title="Priya Nair"
  meta="MA-0937 · Booking"
  who="LO"
  tabs={['Overview', 'Pricing', 'Autopilot', 'Documents']}
  tab="Autopilot"
>
  <table class="mk-tbl">
    <colgroup><col style="width:27%" /><col style="width:34%" /><col style="width:14%" /><col style="width:25%" /></colgroup>
    <thead><tr><th>Step</th><th>Fires</th><th>Last run</th><th>Status</th></tr></thead>
    <tbody>
      <tr><td>Deposit request</td><td>On acceptance</td><td>09:31</td><td><span class="mk-st go">Sent</span></td></tr>
      <tr><td>Instructions on her link</td><td>With the request</td><td>09:31</td><td><span class="mk-st go">Shown</span></td></tr>
      <tr><td>Unpaid reminder</td><td>7 days after due</td><td>—</td><td><span class="mk-st">Scheduled</span></td></tr>
      <tr class="js-money"><td>Money received</td><td>Never — a person does this</td><td>—</td><td><span class="mk-st amb">Needs you</span></td></tr>
    </tbody>
  </table>
  <div class="mk-foot">
    <span class="mk-fine">When it lands in the account:</span>
    <button
      type="button"
      class="mk-uibtn amb"
      data-live="set"
      data-row=".js-money"
      data-done="Marked"
      data-tag="Received · marked by you"
    >Mark received</button>
  </div>
</App>
