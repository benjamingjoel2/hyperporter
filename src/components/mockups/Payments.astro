---
/** Automated Payment — the request went out; you mark the money. */
---
<div class="mk-panel">
  <div class="mk-head"><b><span class="mk-dot amb"></span>Deposit · Marrakesh</b><small>MA-0937</small></div>
  <div class="mk-kpis">
    <div class="mk-kpi"><span>Requested</span><b>€880</b></div>
    <div class="mk-kpi"><span>From</span><b style="font-size:1.05em">Priya Nair</b></div>
  </div>
  <div class="mk-row"><span class="mk-chk"></span><div><b>Request sent</b><small>Automatic · 09:31</small></div></div>
  <div class="mk-row js-money"><span class="mk-chk wait"></span><div><b>Money received</b><small>A person marks this</small></div><span class="mk-tag amb">Needs you</span></div>
  <div class="mk-row plain" style="border-bottom:0;padding-bottom:0"><div class="mk-fine">When it lands:</div><button type="button" class="mk-btn amb" data-live="set" data-row=".js-money" data-done="Received" data-tag="Received" data-small="Marked by you" data-clear="amb">Mark received</button></div>
</div>
