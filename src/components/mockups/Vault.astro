---
/** Document Vault — your contracts, read on upload. */
const D = [
  ['Rift Valley GS — rates 2026.pdf', 'Kenya · 48 rates', 'Indexed'],
  ['Atlas Maroc 2026.pdf', 'Morocco · 112 rates', 'Indexed'],
  ['Andes Trail — Sacred Valley.xlsx', 'Peru · 36 rates', 'Indexing'],
];
---
<div class="mk-panel wide">
  <div class="mk-head"><b>Vault</b><small>61 documents</small></div>
  <div data-list>
    {D.map(([d, m, st]) => (
      <div class="mk-row"><span class:list={['mk-ico', { pdf: d.endsWith('.pdf') }]}>{d.endsWith('.pdf') ? 'PDF' : 'XLS'}</span><div><b>{d}</b><small>{m}</small></div><span class:list={['mk-tag', { amb: st === 'Indexing' }]}>{st}</span></div>
    ))}
  </div>
  <template>
    <div class="mk-row"><span class="mk-ico pdf">PDF</span><div><b>Kilimanjaro Trails 2026.pdf</b><small>Tanzania · reading…</small></div><span class="mk-tag amb">Indexing</span></div>
  </template>
  <div class="mk-foot"><span class="mk-fine">Your data only. Never shared.</span><button type="button" class="mk-btn sig" data-live="add" data-then-to="Indexed" data-head-to="62 documents">Upload</button></div>
</div>
