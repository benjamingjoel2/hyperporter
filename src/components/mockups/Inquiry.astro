---
/** Inquiry Form — editable fields; Send lands it in the CRM. */
---
<div class="mk-back"><b>Meridian Travel Co.</b><i class="l"></i><i class="m"></i><i class="l"></i><i class="s"></i><i class="m"></i><i class="l"></i></div>
<div class="mk-panel right">
  <div><span class="mk-lbl">New inquiry</span><p class="mk-title">Tell us about the trip</p></div>
  <div class="mk-row2">
    <div class="mk-field"><label>Where</label><div contenteditable="true" spellcheck="false">Kenya, the Mara</div></div>
    <div class="mk-field"><label>When</label><div contenteditable="true" spellcheck="false">Early March</div></div>
  </div>
  <div class="mk-field"><label>Budget, per person</label><div contenteditable="true" spellcheck="false" class="focus">€4,000 – 4,500</div></div>
  <div class="mk-row js-landed" hidden><span class="mk-chk"></span><div><b>In the CRM · KE-2292</b><small>New contact, brief attached</small></div><span class="mk-tag">Landed</span></div>
  <div class="mk-foot"><span class="mk-fine">Edit, then send.</span><button type="button" class="mk-btn sig" data-live="set" data-done="Sent" data-reveal=".js-landed" data-fine="Landed as a brief.">Send</button></div>
</div>
