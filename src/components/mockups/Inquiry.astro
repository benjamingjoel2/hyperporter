---
/** The inquiry form as the traveller meets it: the agency's own page, on
    the agency's own address. Nobody signs into this, so there is no
    navigation on it. */
import App from './App.astro';
---
<App
  page
  title="Meridian Travel Co."
  meta="meridiantravel.co/enquire"
  note="Short and guided. It lands as a structured brief, not an email."
>
  <span slot="bar" class="mk-pill">Secure</span>
  <p class="mk-lbl">New inquiry</p>
  <p class="mk-hero">Tell us about the trip</p>
  <div class="mk-form">
    <div class="f"><label>Where</label><div class="val" contenteditable="true" spellcheck="false">Kenya, the Mara</div></div>
    <div class="f"><label>When</label><div class="val" contenteditable="true" spellcheck="false">Early March</div></div>
    <div class="f"><label>Travellers</label><div class="val" contenteditable="true" spellcheck="false">2 adults</div></div>
    <div class="f"><label>Budget, per person</label><div class="val focus" contenteditable="true" spellcheck="false">€4,000 – 4,500</div></div>
  </div>
  <div class="mk-foot">
    <span class="mk-fine">We reply within a day.</span>
    <button type="button" class="mk-uibtn sig" data-live="set" data-done="Sent" data-reveal=".js-landed">Send</button>
  </div>
  <div class="mk-pane js-landed" hidden style="margin-top:.55em">
    <h6>Thank you</h6>
    <div class="ln"><span>We have your brief — reference KE-2292.</span><span>Just now</span></div>
    <div class="ln"><span>Lena will come back to you with a first plan.</span><span>Within a day</span></div>
  </div>
</App>
