---
/** The reseller's side, for the homepage pair: one trip record open in the
    Portal, over a photograph (founder’s ask, Sep 2026). */
import App from './App.astro';
---
<div class="mk-back mk-back-photo" style="--back-photo:url('/photos/reseller-card.jpg')" aria-hidden="true"></div>
<App
  title="Lena & Mark Ortiz"
  meta="KE-2291 · Quotation"
  who="LO"
  tabs={['Overview', 'Thread', 'Quotation board', 'Pricing']}
  tab="Overview"
>
  <div class="mk-two">
    <div class="mk-pane">
      <h6>The trip</h6>
      <div class="ln"><span>Travellers</span><span>2 adults</span></div>
      <div class="ln"><span>Dates</span><span>3 – 12 Mar</span></div>
      <div class="ln"><span>Where</span><span>Nairobi, Mara North</span></div>
      <div class="ln"><span>Budget pp</span><span>€4,000 – 4,500</span></div>
    </div>
    <div class="mk-pane">
      <h6>Money</h6>
      <div class="ln"><span>Cost pp</span><span>€4,180</span></div>
      <div class="ln"><span>Your margin</span><span>18%</span></div>
      <div class="ln"><span>Sells at pp</span><span>€4,932</span></div>
      <div class="ln"><span>Trip value</span><span>€9,864</span></div>
    </div>
  </div>
  <table class="mk-tbl" style="margin-top:.55em">
    <colgroup><col style="width:16%" /><col style="width:52%" /><col style="width:32%" /></colgroup>
    <thead><tr><th>When</th><th>Activity</th><th>By</th></tr></thead>
    <tbody>
      <tr><td>2 h ago</td><td>Proposal v3 opened on the traveller link</td><td>Lena Ortiz</td></tr>
    </tbody>
  </table>
</App>
