---
/**
 * The site's chrome: wordmark left, five items, actions right, and the
 * three panels — Tools, Automations, Solutions, and Resources open one —
 * in the reference's format: described items in labelled columns and a
 * feature card on the right. The dispatch-rail marquee sits under the bar
 * on the homepage and /autopilot only, and scrolls away with the page.
 *
 * `current` is the page's own idea of where it lives (product, customers,
 * blog…) and is folded onto the five items here, so a page does not have
 * to know how the bar is arranged.
 */
import { FEED } from '../lib/feed';
import { NAV, DRAWER } from '../lib/content/nav';
import type { NavItem } from '../lib/content/nav';
import NavFeature from './NavFeature.astro';
import { navIcon } from '../lib/navIcons';

interface Props {
  current?:
    | 'home'
    | 'product'
    | 'automations'
    | 'solutions'
    | 'customers'
    | 'pricing'
    | 'security'
    | 'destinations'
    | 'blog'
    | 'about';
}

const { current } = Astro.props;

/** The live-activity rail rides the two pages that open on Autopilot's
    story — the homepage and the Autopilot overview — and nowhere else. It
    scrolls away with the page; only the bar sticks. */
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const showRail = path === '/' || path === '/autopilot';

const ACTIVE: Record<string, NavItem['id']> = {
  product: 'tools',
  solutions: 'tools',
  automations: 'automations',
  customers: 'solutions',
  pricing: 'pricing',
  security: 'resources',
  destinations: 'resources',
  blog: 'resources',
  about: 'resources',
};
const active = current ? ACTIVE[current] : undefined;

const row = FEED.map(
  ([city, from, to, human]) =>
    `<span class="ent${human ? ' h' : ''}"><b>${city}</b>${from} <u>&rarr;</u> ${to}</span>`
).join('');
const stream = row + row;

---

<header class="top">
  {/* Dims and blurs the page while a panel is open. Sits inside the header
      on a negative z-index, so it paints above the page but behind the
      header's own opaque background — the bar and the panel stay crisp. */}
  <div class="mega-scrim" aria-hidden="true"></div>
  <div class="bar">
    <a class="mark" href="/">
      <span class="glyph"
        ><svg viewBox="0 0 100 100" aria-hidden="true"
          ><circle class="ring" cx="50" cy="50" r="44"></circle><rect x="32.5" y="26" width="7.5" height="47"
          ></rect><rect x="60" y="26" width="7.5" height="47"></rect><rect
            x="32.5"
            y="46.5"
            width="35"
            height="7.5"></rect></svg
        ></span
      >
      <span class="word">Hyperporter</span>
    </a>
    <nav class="links" id="links">
      {
        NAV.map((n) =>
          n.groups ? (
            <div class="mega-wrap" data-mega={n.id}>
              <a
                class:list={['mega-trigger', { act: active === n.id }]}
                href={n.href}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {n.label}
                <svg class="chev" viewBox="0 0 12 8" aria-hidden="true">
                  <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </a>

              {/* The panel: a full-width band under the bar. Groups on the
                  left — the first spans both rows when there are three, so a
                  long first group and two short ones share the height — and
                  the feature card on the right. */}
              <div class="mega" hidden>
                <div class:list={['mega-in', { 'no-feat': !n.feature }]}>
                  <div class:list={['mega-groups', { three: n.groups.reduce((c, g) => c + (g.span ?? 1), 0) === 3 }]}>
                    {n.groups.map((g) => (
                      <div class:list={['mega-group', { wide: g.span === 2 }]} style={g.span === 2 ? `--rows:${Math.ceil(g.items.length / 2)}` : undefined}>
                        <p class="mega-head">{g.heading || '\u00a0'}</p>
                        {g.items.map((r) => (
                          <a class="mega-row" href={r.href}>
                            <span class={`mega-ico-box ico-${n.id}`} set:html={navIcon(r.label)} />
                            <span class="mega-row-t">
                              <b>{r.label}</b>
                              <span>{r.desc}</span>
                            </span>
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                  {n.feature && <div class="mega-side"><NavFeature feature={n.feature} /></div>}
                </div>
              </div>
            </div>
          ) : (
            <a data-nav={n.id} class:list={{ act: active === n.id }} href={n.href}>
              {n.label}
            </a>
          )
        )
      }
    </nav>
    <div class="bar-acts">
      <a class="login" href="https://portal.hyperporter.com/login">Log in</a>
      <a class="cta-nav" href="https://portal.hyperporter.com">Get started</a>
      <button class="burger" aria-label="Menu" aria-expanded="false" aria-controls="drawer" id="burger"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
{
  showRail && (
    <div class="rail" id="rail" aria-hidden="true">
      <div class="tag">Live activity</div>
      <div class="stream" set:html={stream} />
    </div>
  )
}

{/* Outside the header on purpose: `header.top` carries a backdrop-filter,
    and that makes it the containing block for `position:fixed` descendants —
    inside it, this sheet was clipped to the header's own height and the page
    underneath kept receiving the taps. */}
{/* Mobile menu. Top-level items only, each expanding to its own group —
      the old drawer flattened every link in the site into one unbroken list
      of twenty-odd rows with no way to tell a product from a solution. */}
  <div class="drawer" id="drawer">
    <nav class="drawer-in" aria-label="Menu">
      {
        NAV.map((n) =>
          n.groups ? (
            <div class="dsec">
              <button class="drow dtog" type="button" aria-expanded="false" aria-controls={`d-${n.id}`}>
                <span>{n.label}</span>
                <svg viewBox="0 0 12 8" aria-hidden="true">
                  <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </button>
              <div class="dsub" id={`d-${n.id}`} hidden>
                {n.groups.map((g) => (
                  <>
                    {g.heading && <p class="dsub-h">{g.heading}</p>}
                    {g.items.map((r) => (
                      <a class="ditem" href={r.href}>
                        <span class={`mega-ico-box ico-${n.id}`} set:html={navIcon(r.label)} />
                        <span class="mega-row-t">
                          <b>{r.label}</b>
                          <span>{r.desc}</span>
                        </span>
                      </a>
                    ))}
                  </>
                ))}
                {n.feature && <NavFeature feature={n.feature} />}
              </div>
            </div>
          ) : (
            <a class="drow" href={n.href}>
              <span>{n.label}</span>
            </a>
          )
        )
      }
    </nav>
    <div class="drawer-foot">
      <a class="drawer-cta" href="https://portal.hyperporter.com">Get started</a>
      <a class="drawer-login" href="https://portal.hyperporter.com/login">Log in</a>
    </div>
  </div>

<script>
  /**
   * Transparent-over-hero mode. A page that opens on a full-bleed hero (the
   * homepage) gets a transparent bar until the hero headline reaches it;
   * every other page keeps the opaque bar and opts into nothing.
   *
   * The trigger is measured off the headline rather than the hero's height:
   * white nav text over a white headline is unreadable, and the centred
   * wordmark lands directly on top of it.
   */
  const bar = document.querySelector<HTMLElement>('header.top');

  if (bar) {
    /**
     * Publish the chrome's height so a full-viewport hero can subtract it.
     * This header is sticky, which means it is still in flow: a hero set to
     * 100svh therefore starts *below* it and runs exactly that far past the
     * fold, taking the sub-line and the CTA with it. Measured rather than
     * hard-coded because the bar and the rail change height across
     * breakpoints.
     */
    const rail = document.getElementById('rail');
    const publishHeight = (): void => {
      document.documentElement.style.setProperty('--chrome-h', `${bar.offsetHeight}px`);
      document.documentElement.style.setProperty('--rail-h', `${rail ? rail.offsetHeight : 0}px`);
    };

    /**
     * The bar is transparent on every page, so its text has to survive
     * whatever scrolls under it. Sections that are genuinely dark carry
     * `data-chrome="dark"` — the hero, the photo interstitial, the security
     * band, the world map — and while any of them is behind the bar it
     * switches to light text over a scrim.
     *
     * Read against the bar's own box rather than the viewport top: the rail
     * sits at the bottom of the chrome, and a section that has only reached
     * the bar's midpoint is already behind that rail.
     */
    const darks = Array.from(document.querySelectorAll<HTMLElement>('[data-chrome="dark"]'));
    let ticking = false;

    const apply = (): void => {
      ticking = false;
      const h = bar.offsetHeight;
      /* The open drawer is a light sheet hanging off the bar, so the bar
         stays light with it whatever is behind. */
      bar.classList.toggle(
        'over',
        !document.body.classList.contains('drawer-open') &&
          darks.some((el) => {
            const r = el.getBoundingClientRect();
            return r.top < h && r.bottom > 0;
          })
      );
    };

    publishHeight();
    apply();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', () => {
      publishHeight();
      apply();
    });
  }
</script>

<script>
  /**
   * Mega menu. Opens on hover for a pointer, and on click for touch and
   * keyboard — hover alone would make it unreachable on a phone.
   *
   * A short close delay covers the gap between the trigger and the panel:
   * without it the panel shuts while the pointer travels the few pixels
   * between them, which reads as the menu flickering shut on approach.
   */
  const wraps = Array.from(document.querySelectorAll<HTMLElement>('.mega-wrap'));
  const hoverable = window.matchMedia('(hover: hover)').matches;
  let shutTimer: ReturnType<typeof setTimeout> | undefined;

  const bar = document.querySelector<HTMLElement>('header.top');

  function setOpen(wrap: HTMLElement, open: boolean) {
    const panel = wrap.querySelector<HTMLElement>('.mega');
    const trigger = wrap.querySelector<HTMLElement>('.mega-trigger');
    if (!panel || !trigger) return;
    panel.hidden = !open;
    wrap.classList.toggle('open', open);
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    // the scrim follows whether *any* panel is open, not just this one
    bar?.classList.toggle('mega-open', wraps.some((w) => w.classList.contains('open')));
  }

  const closeAll = (except?: HTMLElement) =>
    wraps.forEach((w) => w !== except && setOpen(w, false));

  wraps.forEach((wrap) => {
    const trigger = wrap.querySelector<HTMLElement>('.mega-trigger');

    if (hoverable) {
      wrap.addEventListener('pointerenter', () => {
        clearTimeout(shutTimer);
        closeAll(wrap);
        setOpen(wrap, true);
      });
      wrap.addEventListener('pointerleave', () => {
        shutTimer = setTimeout(() => setOpen(wrap, false), 180);
      });
    }

    // Click opens rather than following the link, so a touch user can reach
    // the panel at all. The overview page is the first row inside it.
    trigger?.addEventListener('click', (e) => {
      if (hoverable && wrap.classList.contains('open')) return; // let it navigate
      e.preventDefault();
      const open = !wrap.classList.contains('open');
      closeAll(wrap);
      setOpen(wrap, open);
    });

  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = wraps.find((w) => w.classList.contains('open'));
    if (!open) return;
    setOpen(open, false);
    open.querySelector<HTMLElement>('.mega-trigger')?.focus();
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.mega-wrap')) closeAll();
  });

  // Tabbing out of a panel closes it.
  document.addEventListener('focusin', (e) => {
    const inside = (e.target as HTMLElement).closest('.mega-wrap');
    wraps.forEach((w) => w !== inside && setOpen(w, false));
  });

  const burger = document.getElementById('burger');
  const drawer = document.getElementById('drawer');

  if (burger && drawer) {
    /* The drawer covers the page, so the page behind it must stop scrolling —
       otherwise a flick on the overlay scrolls the article underneath and the
       menu appears to jump. */
    const setDrawer = (open: boolean): void => {
      drawer.classList.toggle('open', open);
      burger.classList.toggle('on', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Close menu' : 'Menu');
      document.body.classList.toggle('drawer-open', open);
      /* Hand back to the chrome observer above, which owns the bar's dark
         state — on close it recomputes from what is actually behind the bar
         rather than guessing. */
      window.dispatchEvent(new Event('scroll'));
    };

    burger.addEventListener('click', () => setDrawer(!drawer.classList.contains('open')));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) {
        setDrawer(false);
        burger.focus();
      }
    });

    /* Each top-level item opens its own group. */
    drawer.querySelectorAll<HTMLButtonElement>('.dtog').forEach((btn) => {
      btn.addEventListener('click', () => {
        const panel = document.getElementById(btn.getAttribute('aria-controls') ?? '');
        if (!panel) return;
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        panel.hidden = open;
      });
    });
  }

</script>
