---
/**
 * Ported from hyperporter-3.html's <header class="top">. The nav items
 * were `<button onclick="go(id)">` driving the old client-side router;
 * they're real `<a href>` links now, and `current` picks the active one
 * server-side instead of `go()` toggling a `.act` class at runtime.
 * The dispatch-rail marquee is unchanged (same FEED data, doubled for the
 * CSS `march` loop). The UTC clock that used to sit in the bar is gone.
 */
import { FEED } from '../lib/feed';
import { NAV, DRAWER } from '../lib/content/nav';

interface Props {
  current?:
    | 'home'
    | 'product'
    | 'solutions'
    | 'customers'
    | 'pricing'
    | 'security'
    | 'destinations'
    | 'blog'
    | 'about';
}

const { current } = Astro.props;


const row = FEED.map(
  ([city, from, to, human]) =>
    `<span class="ent${human ? ' h' : ''}"><b>${city}</b>${from} <u>&rarr;</u> ${to}</span>`
).join('');
const stream = row + row;
---

<header class="top">
  {/* Dims and blurs the page while a panel is open. Sits inside the header
      on a negative z-index, so it paints above the page but behind the
      header's own opaque background — the bar and the panel stay crisp. */}
  <div class="mega-scrim" aria-hidden="true"></div>
  <div class="bar">
    <nav class="links" id="links">
      {
        NAV.map((n) =>
          n.tabs ? (
            <div class="mega-wrap" data-mega={n.id}>
              <a
                class:list={['mega-trigger', { act: current === n.id }]}
                href={n.href}
                aria-expanded="false"
                aria-haspopup="true"
              >
                {n.label}
                <svg class="chev" viewBox="0 0 12 8" aria-hidden="true">
                  <path d="M1 1.5 6 6.5 11 1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </a>

              <div class="mega" hidden>
                <div class="mega-rail" role="tablist" aria-label={`${n.label} sections`}>
                  {n.tabs.map((t, i) => (
                    <button
                      type="button"
                      role="tab"
                      class:list={['mega-tab', { on: i === 0 }]}
                      data-tab={t.id}
                      aria-selected={i === 0 ? 'true' : 'false'}
                      tabindex={i === 0 ? 0 : -1}
                    >
                      {t.label}
                    </button>
                  ))}
                </div>

                <div class="mega-views">
                  {n.tabs.map((t, i) => (
                    <div class="mega-view" data-view={t.id} hidden={i !== 0}>
                      <p class="mega-head">{t.heading}</p>
                      <div class="mega-list">
                        {t.rows.map((r, j) => (
                          <a class="mega-row" href={r.href}>
                            <span class="mega-n">{String(j + 1).padStart(2, '0')}</span>
                            <span class="mega-txt">
                              <b>{r.label}</b>
                              <em>{r.desc}</em>
                            </span>
                            <span class="mega-go">&rarr;</span>
                          </a>
                        ))}
                      </div>
                      <a class="mega-foot" href={t.footHref}>
                        <span>{t.footLabel}</span>
                        <em>{t.footCta} &rarr;</em>
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a data-nav={n.id} class:list={{ act: current === n.id }} href={n.href}>
              {n.label}
            </a>
          )
        )
      }
    </nav>
    <a class="mark" href="/">
      <span class="glyph"
        ><svg viewBox="0 0 100 100" aria-hidden="true"
          ><circle class="ring" cx="50" cy="50" r="44"></circle><rect x="32.5" y="26" width="7.5" height="47"
          ></rect><rect x="60" y="26" width="7.5" height="47"></rect><rect
            x="32.5"
            y="46.5"
            width="35"
            height="7.5"></rect></svg
        ></span
      >
      <span class="word">Hyperporter</span>
    </a>
    <div class="bar-acts">
      <a class="login" href="/signup">Log in</a>
      <a class="cta-nav" href="/signup">Get started free <i aria-hidden="true">&rarr;</i></a>
      <button class="burger" aria-label="Menu" id="burger"><span></span><span></span><span></span></button>
    </div>
  </div>
  <div class="rail" aria-hidden="true">
    <div class="tag">Live activity</div>
    <div class="stream" set:html={stream} />
  </div>
  <div class="drawer" id="drawer">
    {
      DRAWER.map((g) => (
        <>
          {g.heading && <p class="drawer-h">{g.heading}</p>}
          {g.links.map((n) => (
            <a href={n.href}>{n.label}</a>
          ))}
        </>
      ))
    }
    <a href="/signup">Get started free &rarr;</a>
  </div>
</header>

<script>
  /**
   * Transparent-over-hero mode. A page that opens on a full-bleed hero (the
   * homepage) gets a transparent bar until the hero headline reaches it;
   * every other page keeps the opaque bar and opts into nothing.
   *
   * The trigger is measured off the headline rather than the hero's height:
   * white nav text over a white headline is unreadable, and the centred
   * wordmark lands directly on top of it.
   */
  const bar = document.querySelector<HTMLElement>('header.top');
  const heroTitle = document.querySelector<HTMLElement>('.lg-hero h1');

  if (bar && heroTitle) {
    let ticking = false;
    let trigger = 0;

    const measure = (): void => {
      const was = bar.classList.contains('over');
      bar.classList.add('over');
      trigger = Math.max(
        heroTitle.getBoundingClientRect().top + window.scrollY - bar.offsetHeight - 16,
        0
      );
      bar.classList.toggle('over', was || window.scrollY <= trigger);
    };

    const apply = (): void => {
      ticking = false;
      bar.classList.toggle('over', window.scrollY <= trigger);
    };

    measure();
    apply();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', () => {
      measure();
      apply();
    });
  }
</script>

<script>
  /**
   * Mega menu. Opens on hover for a pointer, and on click for touch and
   * keyboard — hover alone would make it unreachable on a phone.
   *
   * A short close delay covers the gap between the trigger and the panel:
   * without it the panel shuts while the pointer travels the few pixels
   * between them, which reads as the menu flickering shut on approach.
   */
  const wraps = Array.from(document.querySelectorAll<HTMLElement>('.mega-wrap'));
  const hoverable = window.matchMedia('(hover: hover)').matches;
  let shutTimer: ReturnType<typeof setTimeout> | undefined;

  const bar = document.querySelector<HTMLElement>('header.top');

  function setOpen(wrap: HTMLElement, open: boolean) {
    const panel = wrap.querySelector<HTMLElement>('.mega');
    const trigger = wrap.querySelector<HTMLElement>('.mega-trigger');
    if (!panel || !trigger) return;
    panel.hidden = !open;
    wrap.classList.toggle('open', open);
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    // the scrim follows whether *any* panel is open, not just this one
    bar?.classList.toggle('mega-open', wraps.some((w) => w.classList.contains('open')));
  }

  const closeAll = (except?: HTMLElement) =>
    wraps.forEach((w) => w !== except && setOpen(w, false));

  wraps.forEach((wrap) => {
    const trigger = wrap.querySelector<HTMLElement>('.mega-trigger');

    if (hoverable) {
      wrap.addEventListener('pointerenter', () => {
        clearTimeout(shutTimer);
        closeAll(wrap);
        setOpen(wrap, true);
      });
      wrap.addEventListener('pointerleave', () => {
        shutTimer = setTimeout(() => setOpen(wrap, false), 180);
      });
    }

    // Click opens rather than following the link, so a touch user can reach
    // the panel at all. The overview page is the first row inside it.
    trigger?.addEventListener('click', (e) => {
      if (hoverable && wrap.classList.contains('open')) return; // let it navigate
      e.preventDefault();
      const open = !wrap.classList.contains('open');
      closeAll(wrap);
      setOpen(wrap, open);
    });

    // Tabs inside the panel.
    const tabs = Array.from(wrap.querySelectorAll<HTMLButtonElement>('.mega-tab'));
    const views = Array.from(wrap.querySelectorAll<HTMLElement>('.mega-view'));

    const select = (id: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.classList.toggle('on', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      views.forEach((v) => {
        v.hidden = v.dataset.view !== id;
      });
    };

    tabs.forEach((tab, i) => {
      // pointerenter, not click: the reference switches on hover, and a
      // click would feel like a dead button to anyone using a mouse
      tab.addEventListener('pointerenter', () => tab.dataset.tab && select(tab.dataset.tab));
      tab.addEventListener('click', () => tab.dataset.tab && select(tab.dataset.tab));
      tab.addEventListener('keydown', (e) => {
        const k = e.key;
        if (k !== 'ArrowDown' && k !== 'ArrowUp') return;
        e.preventDefault();
        const next = tabs[(i + (k === 'ArrowDown' ? 1 : tabs.length - 1)) % tabs.length];
        if (next.dataset.tab) select(next.dataset.tab);
        next.focus();
      });
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = wraps.find((w) => w.classList.contains('open'));
    if (!open) return;
    setOpen(open, false);
    open.querySelector<HTMLElement>('.mega-trigger')?.focus();
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.mega-wrap')) closeAll();
  });

  // Tabbing out of a panel closes it.
  document.addEventListener('focusin', (e) => {
    const inside = (e.target as HTMLElement).closest('.mega-wrap');
    wraps.forEach((w) => w !== inside && setOpen(w, false));
  });

  const burger = document.getElementById('burger');
  const drawer = document.getElementById('drawer');
  burger?.addEventListener('click', () => drawer?.classList.toggle('open'));

</script>
