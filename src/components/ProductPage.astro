---
/**
 * Shared shape for the four product pages. Each one is a hero, a numbered
 * feature list, optional cases, and a link forward to the next layer.
 *
 * Autopilot and Horizon carry extras the others don't — the pilot targets
 * table and the supplier types / fee explanation — so both are slots rather
 * than fields on the product, which would leave two nulls on every other page.
 */
import type { Product } from '../lib/content/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { eyebrow, title, lede, features, featuresTitle, cases, casesTitle, next } = product;

// A page can put something beside its hero — Autopilot puts the sample
// thread there. Without it the hero stays a single column, so the other
// three product pages are unaffected.
const hasAside = Astro.slots.has('hero-aside');
---

<div class="sec wrap">
  <div class:list={['p-hero', { 'p-hero-split': hasAside }]}>
    <div>
      <p class="eyebrow rv">{eyebrow}</p>
      <h1 class="rv">{title}</h1>
      <p class="lede rv" style="margin-bottom:0">{lede}</p>
    </div>
    {hasAside && (
      <div class="p-hero-aside rv">
        <slot name="hero-aside" />
      </div>
    )}
  </div>
</div>

<slot name="after-hero" />

{
  /* A product whose page shows its own list some other way passes none —
     /autopilot draws the nine stages off STAGES, and this list repeated
     five of them a screen further down. */
  features.length > 0 && (
    <div class="sec-tight wrap">
      {featuresTitle && <h2 class="rv">{featuresTitle}</h2>}
      <div class="flist rv">
        {features.map((f) => (
          <div class="fitem">
            <div class="fn">{f.n}</div>
            <div>
              <b>{f.name}</b>
              <p>{f.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}

<slot name="after-features" />

{
  cases.length > 0 && (
    <div class="sec-tight wrap">
      {casesTitle && <h2 class="rv">{casesTitle}</h2>}
      <div class="cases rv">
        {cases.map((c) => (
          <div class="case">
            <div class="kind">{c.kind}</div>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  )
}

<slot name="after-cases" />

<div class="sec-tight wrap">
  <div class="nextup rv">
    <div>
      <p class="eyebrow" style="margin-bottom:0">{next.eyebrow}</p>
      <h3>{next.title}</h3>
      <p>{next.desc}</p>
    </div>
    <a class="plink" href={next.href}>{next.cta} &rarr;</a>
  </div>
</div>
