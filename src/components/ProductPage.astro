---
/**
 * Shared shape for the product pages, in the founder's v2 composition
 * (Sep 2026): the dark photographic hero with the screen beside it, a light
 * band of what the layer does, a dark band of the two segments as panels
 * that open, and the closing band pointing at the next layer.
 *
 * The content is unchanged — same eyebrow, same title, same lede, same
 * features and cases, same next-up — and the three slots are still here, so
 * a page that carries something of its own (Autopilot's nine stages,
 * Horizon's fee explanation) drops it in where it always did.
 *
 * Slotted markup written before the v2 pass still renders as it did: the
 * design's element reset is written with :where(), which loses every tie
 * with global.css.
 */
import type { Product } from '../lib/content/products';
import type { Photo } from '../lib/photos';
import '../styles/v2.css';

interface Props {
  product: Product;
  /** The page's own photograph, behind the hero. */
  photo?: Photo;
}

const { product, photo } = Astro.props;
const { eyebrow, title, lede, features, featuresTitle, cases, casesTitle, next } = product;

const hasAside = Astro.slots.has('hero-aside');

/**
 * The design sets a display heading in two tones: the statement, then the
 * part that qualifies it, sitting back. Our titles are written as one line,
 * so the break is taken where the sentence already breaks — a second
 * sentence first, then a comma. A title with neither stays on one line,
 * which the design also allows.
 */
const twoTone = (t: string): string[] => {
  const s = t.match(/^(.*?[.?!])\s+(\S.*)$/);
  if (s) return [s[1], s[2]];
  const c = t.match(/^(.*,)\s+(\S.*)$/);
  if (c) return [c[1], c[2]];
  return [t];
};
const [lead, rest] = twoTone(title);

/** An id per feature, from its name, so the nav can link straight to one. */
const anchor = (name: string): string => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<section class="v-hero" data-chrome="dark">
  {photo && <div class="v-hero-bg" style={`background-image:url(${photo.src})`} />}
  <div class="v-wrap">
    <div class:list={['v-hero-grid', { 'v-solo': !hasAside }]}>
      <div>
        <span class="v-eyebrow">{eyebrow}</span>
        <h1 class="v-disp"><b>{lead}</b>{rest && <i>{rest}</i>}</h1>
        <p class="v-sub">{lede}</p>
        <div class="v-cta">
          <a class="v-pill" href="https://portal.hyperporter.com">Get started free</a>
          <a class="v-pill-o" href="/pricing">See pricing</a>
        </div>
      </div>
      {hasAside && (
        <div class="v-hero-aside">
          <slot name="hero-aside" />
        </div>
      )}
    </div>
  </div>
</section>

<slot name="after-hero" />

{
  features.length > 0 && (
    <section class="v-light v-band">
      <div class="v-wrap">
        <div class="v-lead">
          <span class="v-eyebrow">What it does</span>
          {featuresTitle && <h2 class="v-disp"><b>{twoTone(featuresTitle)[0]}</b>{twoTone(featuresTitle)[1] && <i>{twoTone(featuresTitle)[1]}</i>}</h2>}
        </div>
        <div class="v-inds v-cols">
          {features.map((f) => (
            <div class="v-ind" id={anchor(f.name)}>
              <span class="v-eyebrow">{f.n}</span>
              <h3>{f.name}</h3>
              <p>{f.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<slot name="after-features" />

{
  cases.length > 0 && (
    <section class="v-dark v-band" data-chrome="dark">
      <div class="v-wrap">
        <div class="v-center">
          <span class="v-eyebrow">On the ground</span>
          {casesTitle && <h2 class="v-disp"><b>{twoTone(casesTitle)[0]}</b>{twoTone(casesTitle)[1] && <i>{twoTone(casesTitle)[1]}</i>}</h2>}
        </div>
        <div class="v-cases" data-cases>
          {cases.map((c, i) => (
            <div class:list={['v-case', { 'v-open': i === 0 }]}>
              <span class="v-mk">{c.kind}</span>
              <div class="v-body">
                <blockquote>{c.title}</blockquote>
                <p class="v-att">{c.body}</p>
              </div>
              <button class="v-exp" type="button" aria-label={`Read: ${c.title}`}>+</button>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

<slot name="after-cases" />

<div class="v-bigcta" data-chrome="dark">
  <div class="v-wrap">
    <div>
      <span class="v-eyebrow">{next.eyebrow}</span>
      <h2>{next.title}</h2>
    </div>
    <a class="v-pill" href={next.href}>{next.cta} &rarr;</a>
  </div>
</div>

<script>
  import '../lib/v2';
</script>
