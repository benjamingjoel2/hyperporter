---
/**
 * The closing band, in the v2 design: a dark ground, one statement in two
 * tones — the claim, then the continuation sitting back — and one pill.
 * Every product, tool, automation and solutions page ends on it.
 */
import '../styles/v2.css';

interface Props {
  lead: string;
  rest: string;
  cta?: string;
  href?: string;
}

const { lead, rest, cta = 'Get started free', href = 'https://portal.hyperporter.com' } = Astro.props;
---

<div class="v2">
  <div class="v-bigcta" data-chrome="dark">
    <div class="v-wrap">
      <h2 class="v-disp"><b>{lead}</b><i>{rest}</i></h2>
      <a class="v-pill" href={href}>{cta} &rarr;</a>
    </div>
  </div>
</div>
