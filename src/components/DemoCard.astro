---
/**
 * The demo on a tool or automation hero. It is the whole band now
 * (founder's ask, Sep 2026: no description column beside it), so it is
 * the page's own screen at full size — and it works. Buttons do what
 * they say, rows tick, cards move, fields take what you type and chat
 * boxes answer back (lib/live.ts, wired in by Mockup). A person can use
 * the tool on the page before they have signed up for it.
 *
 * The header is a switch. With Hyperporter is that working screen;
 * Without Hyperporter is the same job, same trip, handled the
 * traditional way — one plain paragraph (content/without.ts), amber
 * because all of it is a person's. Both sides are in the markup and a
 * class picks one, so with JS off the screen is still there.
 *
 * How it works, step by step, is the accordion further down the page;
 * this band is for using the thing, not reading about it.
 */
import Mockup from './Mockup.astro';
import type { DetailPage } from '../lib/content/detail';
import { WITHOUT } from '../lib/content/without';

interface Props {
  page: DetailPage;
  kind: 'tool' | 'automation';
}

const { page } = Astro.props;
const without = WITHOUT[page.screen];
if (!without) throw new Error(`DemoCard: no "without" paragraph for screen "${page.screen}" (${page.slug}).`);
---

<div class="thread demo" data-demo>
  <div class="th">
    <span class="demo-mode" role="group" aria-label="With or without Hyperporter">
      <button type="button" class="chip now" data-mode="with" aria-pressed="true">With Hyperporter</button>
      <button type="button" class="chip" data-mode="without" aria-pressed="false">Without Hyperporter</button>
    </span>
    <span>{page.tier === page.layer ? <b>{page.layer}</b> : <>{page.layer} · <b>{page.tier}</b></>}</span>
  </div>

  <div class="v v-with demo-play">
    <Mockup screen={page.screen} ground="warm" />
  </div>

  <div class="v v-without demo-plain">
    <div class="line amb"><i /><span>{without}</span></div>
  </div>

  <div class="ft">
    <span class="demo-k"><i aria-hidden="true" /> <span data-demo-k>Live demo &middot; try it</span></span>
    <span data-demo-side>Everything here is invented</span>
  </div>
</div>

<script>
  /* The With / Without switch. Delegated, so it works wherever the card
     is rendered, the bundled preview included. */
  document.addEventListener('click', (event) => {
    const btn = (event.target as Element | null)?.closest?.<HTMLButtonElement>('[data-demo] [data-mode]');
    if (!btn) return;
    const card = btn.closest<HTMLElement>('[data-demo]');
    if (!card) return;
    const off = btn.dataset.mode === 'without';
    card.classList.toggle('without', off);
    card.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => {
      const on = b === btn;
      b.classList.toggle('now', on);
      b.setAttribute('aria-pressed', String(on));
    });
    const key = card.querySelector<HTMLElement>('[data-demo-k]');
    if (key) key.textContent = off ? 'The same job, by hand' : 'Live demo · try it';
  });
</script>
