---
/**
 * The illustration on a tool or automation hero: the page's own screen, and
 * it works. Buttons do what they say, rows tick, cards move, chat boxes
 * answer back, fields take what you type (lib/live.ts). A person can use
 * the tool on the page before they have signed up for it. Nothing leaves
 * the page; the line under the screen says it is a demonstration.
 */
import '../styles/mockup.css';
import type { DetailPage } from '../lib/content/detail';
import { SCREENS, SCREEN_ALT } from './mockups/index';

interface Props {
  page: DetailPage;
  kind: 'tool' | 'automation';
}

const { page } = Astro.props;
const Screen = SCREENS[page.screen];
if (!Screen) throw new Error(`DemoCard: no screen named "${page.screen}" for ${page.slug}.`);
---

<div class="thread demo" data-demo>
  <div class="th">
    <span>{page.name}</span>
    <span>{page.tier === page.layer ? <b>{page.layer}</b> : <>{page.layer} · <b>{page.tier}</b></>}</span>
  </div>
  <div class="demo-play">
    <div class="mk bare demo-shot" role="group" aria-label={`${page.name}, a working demonstration. ${SCREEN_ALT[page.screen]}`}>
      <div class="mk-stage"><Screen /></div>
    </div>
    <span class="demo-pill" aria-hidden="true"><i></i><span>Live demo · try it</span></span>
  </div>
</div>

<script>
  import '../lib/live';
</script>
