---
/**
 * Footer, on the reference's format: a dark ground, the mark top-left with
 * the copyright under it at the bottom, and the link columns filling the
 * right. No CTA band, no oversized wordmark, no separate bottom bar —
 * Legal is a column like the others.
 *
 * Contact is a mailto, not a route: there is no contact page, and sending
 * "Contact" to the sign-up form was a lie.
 */
const YEAR = new Date().getFullYear();
---

<footer data-chrome="dark">
  <div class="wrap f-main">
    <div class="f-brand">
      <a class="f-mark" href="/" aria-label="Hyperporter — home">
        <svg viewBox="0 0 100 100" aria-hidden="true"
          ><circle class="ring" cx="50" cy="50" r="44"></circle><rect x="32.5" y="26" width="7.5" height="47"
          ></rect><rect x="60" y="26" width="7.5" height="47"></rect><rect
            x="32.5"
            y="46.5"
            width="35"
            height="7.5"></rect></svg
        >
      </a>
      <div class="f-con">
        <div>Intelak Hub, Offices 4, One Central<br />Dubai World Trade Centre, Dubai, UAE</div>
        <div><a href="mailto:hello@hyperporter.com">hello@hyperporter.com</a></div>
      </div>
      <p class="f-copy">Copyright &copy; {YEAR} Hyperporter.<br />All rights reserved.</p>
    </div>

    <nav class="f-cols" aria-label="Footer">
      <div class="f-col">
        <h4>Product</h4>
        <a href="/product">Overview</a>
        <a href="/portal">Portal</a>
        <a href="/autopilot">Autopilot</a>
        <a href="/intelligence">Intelligence</a>
        <a href="/horizon">Horizon</a>
      </div>
      <div class="f-col">
        <h4>Solutions</h4>
        <a href="/solutions">All features</a>
        <a href="/customers/agent-portal">Agent Portal</a>
        <a href="/customers/supplier-portal">Supplier Portal</a>
        <a href="/pricing">Pricing</a>
      </div>
      <div class="f-col">
        <h4>Company</h4>
        <a href="/about">About</a>
        <a href="/blog">Resources</a>
        <a href="/destinations">Destinations</a>
        <a href="/security">Security</a>
        <a href="mailto:hello@hyperporter.com">Contact</a>
      </div>
      <div class="f-col">
        <h4>Legal</h4>
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
      </div>
    </nav>
  </div>
</footer>
