---
/**
 * The page hero in the founder's v2 design: a photograph under a dark
 * scrim, the eyebrow, the display heading in two tones, the lede, the two
 * pills, and — where a page has one — its own screen beside the copy.
 *
 * The heading's second tone is taken from where the title already breaks,
 * a second sentence first and then a comma, so nothing is invented and a
 * title with neither stays on one line, which the design also allows.
 */
import type { Photo } from '../lib/photos';

interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  photo?: Photo;
  /** The secondary pill; the primary one is always Get started free. */
  secondary?: { label: string; href: string };
  /** A page with no photograph of its own opens on the light ground rather
      than a black band with nothing in it. */
  light?: boolean;
  /** Drop the pills, for a page where the hero is not the place to ask. */
  noCta?: boolean;
}

const { eyebrow, title, lede, photo, light = false, noCta = false,
  secondary = { label: 'See pricing', href: '/pricing' } } = Astro.props;

export const twoTone = (t: string): string[] => {
  const s = t.match(/^(.*?[.?!])\s+(\S.*)$/);
  if (s) return [s[1], s[2]];
  const c = t.match(/^(.*,)\s+(\S.*)$/);
  if (c) return [c[1], c[2]];
  return [t];
};
const [lead, rest] = twoTone(title);
const hasAside = Astro.slots.has('aside');
---

<section class:list={['v-hero', { 'v-hero-light': light }]} data-chrome={light ? undefined : 'dark'}>
  {photo && <div class="v-hero-bg" style={`background-image:url(${photo.src})`} />}
  <div class="v-wrap">
    <div class:list={['v-hero-grid', { 'v-solo': !hasAside }]}>
      <div>
        <span class="v-eyebrow">{eyebrow}</span>
        <h1 class="v-disp"><b>{lead}</b>{rest && <i>{rest}</i>}</h1>
        {lede && <p class="v-sub">{lede}</p>}
        <slot name="under" />
        {!noCta && (
          <div class="v-cta">
            <a class={light ? 'v-pill-d' : 'v-pill'} href="https://portal.hyperporter.com">Get started free</a>
            <a class={light ? 'v-pill-l' : 'v-pill-o'} href={secondary.href}>{secondary.label}</a>
          </div>
        )}
      </div>
      {hasAside && (
        <div class="v-hero-aside">
          <slot name="aside" />
        </div>
      )}
    </div>
  </div>
  <slot />
</section>
