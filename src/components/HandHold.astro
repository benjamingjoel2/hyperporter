---
/**
 * A hand holding the device on the homepage ladder (founder's ask, Sep
 * 2026, after the device-in-a-palm reference). Drawn, not photographed —
 * the reference supplied is another company's marketing photograph, so
 * this is our own artwork.
 *
 * A right hand gripping the device's right edge. The fingers wrap round
 * behind it and only their outer curve shows past the edge; the heel of
 * the hand and the forearm sit below-right; the thumb is the one part
 * that comes over the face (`hh-front`), on a soft contact shadow.
 * Keeping the front element to one thumb is deliberate — the less drawn
 * hand crosses the screen, the less it competes with the interface.
 *
 * Both layers share one viewBox and one CSS box, so the thumb always
 * meets the hand. In that frame the device's right edge falls at x≈294
 * and its bottom edge at y≈513; anything left of or above those is
 * hidden behind the screen. Decorative: hidden from assistive tech, and
 * dropped below 1180px where the device closes to a single pane.
 */
---
<svg class="hh hh-back" viewBox="0 0 400 620" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="hh-skin" x1=".15" y1="0" x2=".95" y2=".8">
      <stop offset="0" stop-color="#DEB89E" />
      <stop offset=".45" stop-color="#D2A98D" />
      <stop offset="1" stop-color="#C0947A" />
    </linearGradient>
    <linearGradient id="hh-skin-lit" x1="1" y1=".1" x2="0" y2=".9">
      <stop offset="0" stop-color="#E9C6AD" />
      <stop offset=".55" stop-color="#DCB094" />
      <stop offset="1" stop-color="#C4947A" />
    </linearGradient>
    <filter id="hh-cast" x="-70%" y="-70%" width="240%" height="240%">
      <feGaussianBlur stdDeviation="15" />
    </filter>
    <filter id="hh-drop" x="-30%" y="-30%" width="170%" height="170%">
      <feDropShadow dx="10" dy="16" stdDeviation="18" flood-color="#4A2E1E" flood-opacity=".2" />
    </filter>
    {/* The forearm runs out of the frame rather than stopping in mid-air. */}
    <linearGradient id="hh-fade" x1="0" y1="0" x2="0" y2="1">
      <stop offset=".88" stop-color="#fff" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <mask id="hh-fade-m">
      <rect width="400" height="620" fill="url(#hh-fade)" />
    </mask>
  </defs>
  <g fill="url(#hh-skin)" filter="url(#hh-drop)" mask="url(#hh-fade-m)">
    {/* Forearm, then the heel of the hand it runs into. */}
    <rect x="292" y="470" width="118" height="280" rx="59" transform="rotate(10 351 565)" />
    <ellipse cx="342" cy="498" rx="80" ry="76" />
    {/* Three fingers wrapped behind: only the outer curve clears the edge.
        They overlap so the group composites to one silhouette, and the
        middle one reaches furthest, as a hand's does. */}
    <rect x="236" y="296" width="118" height="70" rx="35" />
    <rect x="232" y="358" width="142" height="72" rx="36" />
    <rect x="238" y="422" width="128" height="70" rx="35" />
  </g>
  {/* The creases between them, drawn only where the edge clears the screen. */}
  <g fill="#8A6047" opacity=".2">
    <rect x="300" y="360" width="48" height="4" rx="2" />
    <rect x="300" y="424" width="52" height="4" rx="2" />
  </g>
  {/* The device's shadow falling across the knuckles nearest the edge. */}
  <rect x="294" y="290" width="30" height="230" fill="#5E3A26" opacity=".22" filter="url(#hh-cast)" />
</svg>

<svg class="hh hh-front" viewBox="0 0 400 620" aria-hidden="true" focusable="false">
  {/* Contact shadow first, so the thumb sits on the glass, not over it. */}
  <g filter="url(#hh-cast)" opacity=".45">
    <rect x="225" y="352" width="70" height="166" rx="35" transform="rotate(-35 260 420)" fill="#06090D" />
  </g>
  <g transform="rotate(-35 260 420)">
    <rect x="233" y="356" width="54" height="158" rx="27" fill="url(#hh-skin-lit)" />
    {/* The joint crease, and the nail catching the light at the tip. */}
    <rect x="240" y="412" width="40" height="34" rx="17" fill="#B98A6D" opacity=".28" />
    <rect x="245" y="368" width="30" height="38" rx="15" fill="#F2D8C4" opacity=".5" />
  </g>
</svg>
