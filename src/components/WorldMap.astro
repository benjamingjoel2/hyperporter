---
/**
 * Coverage map, on the Starlink availability-map model: a full-bleed dark
 * world, countries we cover lit, everything else recessed.
 *
 * Real Natural Earth geometry, projected to SVG paths at build time (see
 * lib/worldMap.ts). No mapping library reaches the browser and nothing is
 * fetched at runtime — it is one inline SVG.
 *
 * Two states only, covered or not, because that is the only distinction
 * the data actually supports. Tiers would need a judgement per country
 * that nobody has made yet, and inventing them would put claims on a map.
 *
 * Covered countries are links to their destination page. The 13 island
 * states too small to draw at this resolution are dots, positioned from
 * their real centroids rather than placed by hand.
 */
import { getCollection } from 'astro:content';
import { buildWorldMap, MAP_W, MAP_H } from '../lib/worldMap';

interface Props {
  /** Adds the search field and the status readout. */
  interactive?: boolean;
  /** Drops the frame, key and links so the map can sit behind content. */
  bare?: boolean;
}

const { interactive = false, bare = false } = Astro.props;

const destinations = await getCollection('destinations');
const { countries, dots, missing } = buildWorldMap(
  destinations.map((d) => ({ title: d.data.title, slug: d.id }))
);

// A country with no geometry would be silently absent from the map, so
// fail the build rather than ship a map that quietly under-reports.
if (missing.length) {
  throw new Error(`WorldMap: no geometry for ${missing.join(', ')}`);
}

const coveredCount = countries.filter((c) => c.covered).length + dots.length;
---

<div class:list={['wm', { bare }]} data-covered={coveredCount}>
  {
    interactive && (
      <div class="wm-bar">
        <input
          type="search"
          id="wm-q"
          placeholder="Check a country"
          aria-label="Check whether a country is covered"
          autocomplete="off"
        />
        <p class="wm-status" id="wm-status" role="status">
          {coveredCount} countries covered
        </p>
      </div>
    )
  }

  <div class="wm-frame" data-chrome="dark">
    <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} role="img" aria-label={`Hyperporter operates in ${coveredCount} countries`}>
      <g class="wm-base">
        {countries.filter((c) => !c.covered).map((c) => <path d={c.d} data-label={c.name} />)}
      </g>
      <g class="wm-on">
        {
          countries
            .filter((c) => c.covered)
            .map((c) => (
              <a
                href={`/destinations/${c.slug}`}
                data-name={(c.label ?? c.name).toLowerCase()}
                data-label={c.label ?? c.name}
                aria-label={`${c.label ?? c.name} — available`}
              >
                <path d={c.d} />
              </a>
            ))
        }
      </g>
      <g class="wm-dots">
        {
          dots.map((d) => (
            <a
              href={`/destinations/${d.slug}`}
              data-name={d.name.toLowerCase()}
              data-label={d.name}
              aria-label={`${d.name} — available`}
            >
              <circle cx={d.x} cy={d.y} r="4.5" />
            </a>
          ))
        }
      </g>
    </svg>
  </div>

  {
    !bare && (
      <div class="wm-tip" id="wm-tip" hidden aria-hidden="true">
        <b></b>
        <span class="wm-tip-s"></span>
      </div>
    )
  }

  {
    !bare && (
      <div class="wm-key">
        <span class="wm-k on">Covered</span>
        <span class="wm-k">Not yet</span>
      </div>
    )
  }
</div>

<script>
  {/* Hover bubble. The links work on their own; this only names what is
      under the pointer before you click it. */}
  const root = document.querySelector<HTMLElement>('.wm:not(.bare)');
  const tip = document.getElementById('wm-tip');

  if (root && tip) {
    const label = tip.querySelector('b');

    const state = tip.querySelector('.wm-tip-s');

    const show = (el: Element, x: number, y: number) => {
      const name = (el as HTMLElement).dataset.label ?? '';
      if (!name) return;
      // anything in .wm-base is a country we do not cover
      const off = Boolean(el.closest('.wm-base'));
      if (label) label.textContent = name;
      if (state) state.textContent = off ? 'Unavailable' : 'Available';
      tip.classList.toggle('off', off);
      tip.hidden = false;
      const box = root.getBoundingClientRect();
      const w = tip.offsetWidth;
      const h = tip.offsetHeight;
      // keep the bubble inside the map, and above the pointer
      const left = Math.min(Math.max(x - box.left - w / 2, 6), box.width - w - 6);
      const top = Math.max(y - box.top - h - 14, 6);
      tip.style.transform = `translate(${Math.round(left)}px, ${Math.round(top)}px)`;
    };

    const hide = () => {
      tip.hidden = true;
    };

    root.addEventListener('pointermove', (e) => {
      const hit = (e.target as Element).closest(
        '.wm-on a, .wm-dots a, .wm-base path[data-label]'
      );
      if (hit) show(hit, e.clientX, e.clientY);
      else hide();
    });
    root.addEventListener('pointerleave', hide);

    // keyboard: name the link when it takes focus
    root.addEventListener(
      'focusin',
      (e) => {
        const hit = (e.target as Element).closest('.wm-on a, .wm-dots a');
        if (!hit) return hide();
        const r = hit.getBoundingClientRect();
        show(hit, r.left + r.width / 2, r.top + r.height / 2);
      },
      true
    );
    root.addEventListener('focusout', hide, true);
  }
</script>

{
  interactive && (
    <script>
      {/* Search over the shapes already in the SVG. With no script the map
          is still a complete, clickable map — only the field goes away. */}
      const q = document.getElementById('wm-q') as HTMLInputElement | null;
      const status = document.getElementById('wm-status');
      const wm = document.querySelector<HTMLElement>('.wm');
      const total = Number(wm?.dataset.covered ?? 0);
      const shapes = Array.from(
        document.querySelectorAll<SVGAElement>('.wm-on a, .wm-dots a')
      );

      q?.addEventListener('input', () => {
        const term = q.value.trim().toLowerCase();
        let hits = 0;
        let firstName = '';
        for (const el of shapes) {
          const name = el.dataset.name ?? '';
          const match = term.length > 0 && name.includes(term);
          el.classList.toggle('hit', match);
          if (match) {
            hits += 1;
            // use the label as authored -- re-casing the lowercased name
            // breaks on non-ASCII letters (Türkiye became "TüRkiye")
            if (!firstName) firstName = el.dataset.label ?? name;
          }
        }
        wm?.classList.toggle('searching', term.length > 0);
        if (!status) return;
        if (!term) status.textContent = `${total} countries covered`;
        else if (hits === 1) status.textContent = `${firstName} — covered`;
        else if (hits > 1) status.textContent = `${hits} matches`;
        else status.textContent = 'Not covered yet — tell us and we will source it';
      });
    </script>
  )
}
