---
/**
 * Three points under a heading, each with its line icon — the tool,
 * automation and solutions pages all carry this section. In the v2 design
 * it is a light band of cards in a row rather than a bare three-column
 * grid, so it reads as a band of the page like every other one.
 */
import { pointIcon, isPointIcon } from '../lib/pointIcons';
import type { PointIcon } from '../lib/pointIcons';
import '../styles/v2.css';

interface Props {
  title: string;
  points: { icon: PointIcon; title: string; body: string }[];
}

const { title, points } = Astro.props;

/* The icon is declared with the point. A missing or unknown one stops the
   build rather than rendering an empty box or an arbitrary shape, which is
   how "Numbers stay private" ended up under a currency mark. */
for (const p of points) {
  if (!p.icon || !isPointIcon(p.icon)) {
    throw new Error(`Point "${p.title}" has no valid icon (got ${JSON.stringify(p.icon)}).`);
  }
}

const parts = title.match(/^(.*?[.?!])\s+(\S.*)$/) ?? [null, title, ''];
---

<section class="v-light v-band">
  <div class="v-wrap">
    <div class="v-lead">
      <h2 class="v-disp"><b>{parts[1]}</b>{parts[2] && <i>{parts[2]}</i>}</h2>
    </div>
    <div class="v-inds v-cols">
      {
        points.map((p) => (
          <div class="v-ind">
            <span class="v-ico" set:html={pointIcon(p.icon)} />
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
