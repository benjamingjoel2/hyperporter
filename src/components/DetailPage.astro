---
/**
 * One tool or one automation, on a page of its own, in the founder's
 * sequence (Sep 2026): the hero, text only, on the photograph; under it,
 * on the same photograph, the overview band with the clickable step card;
 * three points with icons; "How it works" as the reference's list-and-
 * snippet accordion; the step a person always takes (automations); and
 * the closing statement band. Both collections render through this so
 * they read as one family; the copy is each page's own, in
 * lib/content/detail.ts.
 */
import V2Hero from './V2Hero.astro';
import { photoFor } from '../lib/photos';
import '../styles/v2.css';
import Points from './Points.astro';
import CtaBand from './CtaBand.astro';
import StepScreen from './StepScreen.astro';
import { STEP_SCREENS } from '../lib/content/steps';
import type { DetailPage } from '../lib/content/detail';

interface Props {
  page: DetailPage;
  kind: 'tool' | 'automation';
}

const { page, kind } = Astro.props;
const eyebrow = page.name;
const id = `${kind}-${page.slug}`;
/* A screen per step, so the accordion swaps it as you move down the list.
   The build fails if a page's steps and its screens fall out of step. */
const steps = STEP_SCREENS[page.slug];
if (!steps) throw new Error(`No step screens for "${page.slug}" (content/steps.ts).`);
if (steps.length !== page.how.length) {
  throw new Error(`"${page.slug}": ${page.how.length} steps but ${steps.length} screens.`);
}
---

<V2Hero eyebrow={eyebrow} title={page.title} lede={page.lede} photo={photoFor(page.slug)} />

<Points title={`${page.name} overview`} points={page.what} />

{/* How it works: the reference's accordion — the steps on hairlines,
    the open one with its body, the screen beside. */}
<section class="v-dark v-band acc-dark" data-chrome="dark">
  <div class="v-wrap">
    <div class="v-lead">
      <h2 class="v-disp"><b>{page.howTitle}</b></h2>
    </div>
<div class="lg-acc">
  <div class="lg-acc-list">
    {
      page.how.map((s, i) => (
        <div class:list={['lg-acc-item', { on: i === 0 }]}>
          <button
            type="button"
            class="lg-acc-btn"
            id={`${id}-how-tab-${i}`}
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`${id}-how-body-${i}`}
          >
            {s.name}
          </button>
          <div class="lg-acc-body" id={`${id}-how-body-${i}`} inert={i !== 0}>
            <div>
              <p>{s.body}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="lg-acc-shot lg-acc-ipad">
    {
      steps.map((sc, i) => (
        <div class:list={{ on: i === 0 }} inert={i !== 0}>
          <StepScreen
            screen={sc}
            ground="warm"
            app={page.name}
            alt={`${page.name}: ${page.how[i].name}`}
          />
        </div>
      ))
    }
  </div>
</div>
  </div>
</section>

{
  /* Amber is the site's mark for a human / manual state, and this is the
     one place on an automation page it belongs. */
  page.human && (
    <section class="v-light v-band v-band-tight">
      <div class="v-wrap">
        <div class="human-note">
          <p class="v-eyebrow">Where a person steps in</p>
          <p>{page.human}</p>
        </div>
      </div>
    </section>
  )
}

<CtaBand before={page.close.before} after={page.close.after} />

<script>
  import '../lib/accordion';
</script>
