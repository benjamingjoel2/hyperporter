---
/**
 * One tool or one automation, on a page of its own, in the founder's
 * sequence (Sep 2026): the hero, text only, on the photograph; under it,
 * on the same photograph, the overview band with the clickable step card;
 * three points with icons; "How it works" as the reference's list-and-
 * snippet accordion; the step a person always takes (automations); and
 * the closing statement band. Both collections render through this so
 * they read as one family; the copy is each page's own, in
 * lib/content/detail.ts.
 */
import DemoCard from './DemoCard.astro';
import PhotoHero from './PhotoHero.astro';
import Points from './Points.astro';
import CtaBand from './CtaBand.astro';
import StepScreen from './StepScreen.astro';
import { STEP_SCREENS } from '../lib/content/steps';
import { SCREEN_META } from './mockups/index';
import type { DetailPage } from '../lib/content/detail';

interface Props {
  page: DetailPage;
  kind: 'tool' | 'automation';
}

const { page, kind } = Astro.props;
const eyebrow = page.name;
const id = `${kind}-${page.slug}`;
/* A screen per step, so the accordion swaps it as you move down the list.
   The build fails if a page's steps and its screens fall out of step. */
const steps = STEP_SCREENS[page.slug];
if (!steps) throw new Error(`No step screens for "${page.slug}" (content/steps.ts).`);
if (steps.length !== page.how.length) {
  throw new Error(`"${page.slug}": ${page.how.length} steps but ${steps.length} screens.`);
}
const meta = SCREEN_META[page.screen];
const cta =
  kind === 'tool'
    ? { lead: `${page.name} is part of ${page.layer}.`, rest: 'Start free on Showcase, and switch on what you need as the trips come in.' }
    : { lead: 'Autopilot runs the stages. You take the decisions.', rest: 'Start free on Showcase, and switch it on when you are ready.' };
---

<PhotoHero photo={page.slug}>
  <div class="sec wrap page-hero hero-solo">
    <div class="page-hero-copy">
      <p class="eyebrow rv">{eyebrow}</p>
      <h1 class="rv">{page.title}</h1>
      <p class="lede rv">{page.lede}</p>
      <div class="rv" style="display:flex;gap:12px;flex-wrap:wrap;margin-top:26px">
        <a class="btn" href="https://portal.hyperporter.com">Get started free</a>
        <a class="btn-o" href="/pricing">See pricing</a>
      </div>
    </div>
  </div>

  {/* The overview, under the hero on the same photograph: a lead beside the
      page's own screen, which works. */}
  <div class="demo-band">
    <div class="demo-glass rv">
      <div class="demo-lead">
        <p class="eyebrow">{page.layer} · {page.name}</p>
        <p class="dek">{page.overview}</p>
        <p class="demo-tier">Available on <b>{page.tier}</b> · {page.tierNote}</p>
      </div>
      <DemoCard page={page} kind={kind} />
    </div>
  </div>
</PhotoHero>

<Points title={`${page.name} overview`} points={page.what} />

{/* How it works: the reference's accordion — the steps on hairlines,
    the open one with its body, the screen beside. */}
<section class="sec wrap">
  <h2 class="rv" style="margin-bottom:clamp(30px,3.6vw,52px)">{page.howTitle}</h2>
  <div class="lg-acc">
    <div class="lg-acc-list">
      {
        page.how.map((s, i) => (
          <div class:list={['lg-acc-item', { on: i === 0 }]}>
            <button
              type="button"
              class="lg-acc-btn"
              id={`${id}-how-tab-${i}`}
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`${id}-how-body-${i}`}
            >
              {s.name}
            </button>
            <div class="lg-acc-body" id={`${id}-how-body-${i}`} inert={i !== 0}>
              <div>
                <p>{s.body}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="lg-acc-shot">
      {
        steps.map((sc, i) => (
          <div class:list={{ on: i === 0 }} inert={i !== 0}>
            <StepScreen
              screen={sc}
              ground={meta.ground}
              app={meta.app}
              alt={`${page.name}: ${page.how[i].name}`}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

{
  /* Amber is the site's mark for a human / manual state, and this is the
     one place on an automation page it belongs. */
  page.human && (
    <div class="sec-tight wrap">
      <div class="human-note rv">
        <p class="eyebrow">Where a person steps in</p>
        <p>{page.human}</p>
      </div>
    </div>
  )
}

<CtaBand lead={cta.lead} rest={cta.rest} />

<script>
  import '../lib/accordion';
</script>
