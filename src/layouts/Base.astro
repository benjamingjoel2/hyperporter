---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/apple.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Which header nav item to mark active. See Header.astro. */
  currentNav?:
    | 'home'
    | 'product'
    | 'solutions'
    | 'customers'
    | 'pricing'
    | 'security'
    | 'destinations'
    | 'blog'
    | 'about';
}

const { title, description, canonical, ogImage, ogType, noindex, currentNav } = Astro.props;

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Hyperporter',
  url: Astro.site?.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' fill='%2307080A'/%3E%3Ccircle cx='50' cy='50' r='44' fill='none' stroke='%23EDF1F4' stroke-width='5' stroke-dasharray='54.1 15' stroke-dashoffset='61.6'/%3E%3Crect x='32.5' y='26' width='7.5' height='47' fill='%23EDF1F4'/%3E%3Crect x='60' y='26' width='7.5' height='47' fill='%23EDF1F4'/%3E%3Crect x='32.5' y='46.5' width='35' height='7.5' fill='%23EDF1F4'/%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    >
      <Fragment slot="structured-data">
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(organizationJsonLd)}
        />
        <slot name="structured-data" />
      </Fragment>
    </SEO>
  </head>
  <body>
    <Header current={currentNav} />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal-on-scroll: elements with `.rv` fade/slide in once `.in` is
      // added by the observer. Ported from hyperporter-3.html; there it
      // re-armed on every client-side route change, which no longer
      // applies now that each page is a real navigation and gets a fresh
      // DOM. `prefers-reduced-motion` is handled in CSS (see global.css).
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const target = entry.target as HTMLElement;
            const siblings = [...(target.parentElement?.children ?? [])].filter((el) =>
              el.classList.contains('rv')
            );
            target.style.transitionDelay = `${Math.min(siblings.indexOf(target), 5) * 70}ms`;
            target.classList.add('in');
            io.unobserve(target);
          }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.rv:not(.in)').forEach((el) => io.observe(el));

      // Accordion. This is the ONLY handler for `.acc-i` on the site — the
      // destination guarantee section, the homepage FAQ and the security FAQ
      // all ride on it. A page must not bind its own: a second listener on
      // the same button toggles twice per click, which reads as an accordion
      // that does nothing at all.
      document.querySelectorAll<HTMLButtonElement>('.acc-i > button').forEach((btn) => {
        btn.addEventListener('click', () => {
          const open = btn.parentElement?.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
      });
    </script>
  </body>
</html>
