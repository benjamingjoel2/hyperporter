---
/**
 * Standalone shell for the /preview/* design studies. Deliberately does not
 * use Base.astro or global.css: the point is to judge a whole visual
 * language, chrome included, so wrapping it in the current site's header
 * and footer would defeat it. Nothing here is shared with the real site.
 */
interface Props { title: string; fonts: string }
const { title, fonts } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
    <style is:global>
      *,*::before,*::after{box-sizing:border-box}
      body{margin:0}
      img,svg{max-width:100%;display:block}
      a{color:inherit;text-decoration:none}
      @media (prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important}}
    </style>
  </head>
  <body><slot /></body>
</html>
