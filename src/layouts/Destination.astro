---
/**
 * Destination-detail page shell. Ported from hyperporter-3.html's
 * #view-dest markup (openDest()), with two deliberate content changes
 * beyond the mechanical HTML/CSS port:
 *
 * 1. The on-page lede used to be a fully generic template — "Hyperporter
 *    helps you deliver world-class trips in {name} with zero hassle..." —
 *    identical for all 137 countries. It's replaced here with the
 *    destination's `description` (the prototype's actually-distinct
 *    per-country DESC[] line, which used to appear only on region-hub
 *    cards, never on the destination page itself). Small change, but it's
 *    the one piece of real per-country text this page has.
 * 2. The "Local Helpline" mailto address uses the fixed slug function
 *    (see src/lib/destinationEmail.ts) instead of the original regex,
 *    which dropped accented letters instead of transliterating them.
 *
 * Everything else — award badges, services grid, guarantee accordion —
 * is a faithful copy, including the parts flagged separately as open
 * questions (the award badges' accuracy is unconfirmed; this page
 * doesn't resolve that, just carries it forward visibly rather than
 * silently).
 */
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import LandmarkArt from '../components/LandmarkArt.astro';
import { SERVICES, GUARANTEE } from '../lib/destinationContent';
import { helplineEmail } from '../lib/destinationEmail';
import { slugify } from '../lib/slug';

interface Props {
  entry: CollectionEntry<'destinations'>;
}

const { entry } = Astro.props;
const { title: name, region, description, heroImage, heroAlt, index: shouldIndex } = entry.data;

const regionHref = `/regions/${slugify(region)}`;
const mail = helplineEmail(name);

/**
 * TouristDestination structured data. Inert while the page is noindex —
 * which is all 137 of them today — but in place for when per-destination
 * content is written and `index: true` is flipped.
 *
 * `name` is the country itself, so it doubles as the containsPlace/country
 * reference; `touristType` reflects who these pages actually address (the
 * travel businesses selling the destination), not end travellers.
 */
const canonical = new URL(`/destinations/${entry.id}/`, Astro.site).toString();
const touristDestinationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristDestination',
  name,
  description,
  url: canonical,
  ...(heroImage ? { image: new URL(heroImage, Astro.site).toString() } : {}),
  address: { '@type': 'PostalAddress', addressCountry: name },
  includesAttraction: { '@type': 'Country', name },
  touristType: 'Travel agencies, advisors and tour operators',
  provider: { '@type': 'Organization', name: 'Hyperporter', url: Astro.site?.toString() },
};
---

<Base
  title={name}
  description={description}
  noindex={!shouldIndex}
  ogType="website"
  currentNav="destinations"
>
  <Fragment slot="structured-data">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(touristDestinationJsonLd)} />
  </Fragment>

  <section class="hx hx-dp-top">
    <a class="hx-back" href={regionHref}>&larr; Back to {region}</a>
    <a class="hx-dp-mail" href={`mailto:${mail}`}>{mail}</a>
  </section>

  <section class="hx hx-ph hx-dp-head">
    <div class="hx-dp-grid">
      <div>
        <p class="hx-ph-eye">{region}</p>
        <h1>{name}</h1>
        <p class="hx-ph-lede">{description}</p>
        <div class="hx-ph-cta">
          <a class="btn" href="/signup">Request a demo</a>
          <a class="btn-o" href="#services">Explore services</a>
        </div>
      </div>
      <div class="hx-dp-art">
        <LandmarkArt name={name} uid={`h${entry.id}`} heroImage={heroImage} heroAlt={heroAlt} />
      </div>
    </div>
  </section>

  <section class="hx hx-sec" id="services">
    <div class="hx-two" style="margin-bottom:clamp(34px,4vw,60px)">
      <h2>End-to-end services</h2>
      <p>Everything needed to sell and run a trip in {name}, in one place.</p>
    </div>
    <div class="hx-grid">
      {
        SERVICES.map(([title, body], i) => (
          <div>
            <div class="hx-cell-n">{String(i + 1).padStart(2, '0')}</div>
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="hx hx-sec">
    <div class="hx-split">
      <div>
        <p class="hx-ph-eye">The Hyperporter guarantee</p>
        <h2>Sell and operate your trips without the chasing.</h2>
      </div>
      <div>
        <div class="acc">
          {
            GUARANTEE.map(([title, body], i) => (
              <div class:list={['acc-i', { open: i === 0 }]}>
                <button type="button">
                  {title}
                  <i>+</i>
                </button>
                <div class="acc-b">
                  <p>{body.replaceAll('{C}', name)}</p>
                </div>
              </div>
            ))
          }
        </div>
        <a class="btn" style="margin-top:32px" href="/signup">Start today</a>
      </div>
    </div>
  </section>
</Base>


